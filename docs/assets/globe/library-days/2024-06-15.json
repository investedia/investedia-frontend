{"n5291990016":{"id":"n5291990016","headline":"Fewer knowledge migrants due to cuts to 30 percent ruling","summary":"A SEO Economic Research report commissioned by the Dutch Senate and lower house estimates 10 to 15 percent fewer highly skilled workers will come to the Netherlands after the 30 percent ruling is cut.","why":"The 30 percent ruling is a Dutch tax break for expatriate workers. Changes to it affect the country's attractiveness for skilled labour.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Amsterdam","country":"Netherlands","lat":52.368,"lon":4.904,"region":"eu"},"entities":[],"links":[],"source":{"name":"NL Times","url":"https://nltimes.nl/2024/06/15/fewer-knowledge-migrants-due-cuts-30-percent-ruling"},"sources":[{"name":"NL Times","url":"https://nltimes.nl/2024/06/15/fewer-knowledge-migrants-due-cuts-30-percent-ruling"}],"published_at":"2024-06-15T06:55:46Z","retrieved_at":"2026-11-19T20:47:49Z","official":false,"ai_summary":true,"content_hash":"4e219d547e45dc43","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-19T20:47:49Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2024-06-15T06:55:46Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2024-06-15T12:00:00Z","publisher_country_gdelt":"NL","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-4788732.jpg","alt":"parliament government building (illustration)","credit":"adil-photos","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/berlin-reichstag-the-german-volke-4788732/"}}}