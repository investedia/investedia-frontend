{"n686ca14e39":{"id":"n686ca14e39","headline":"Israeli startups act to relocate over judicial shakeup, survey finds","summary":"A survey released by an Israeli non-profit found nearly 70% of Israeli startups have taken action to relocate parts of their business outside Israel. The survey was tied to the judicial shakeup.","why":"Israel's startup sector is a major source of technology investment and exports, so relocations could shift jobs, capital and tax revenue away from the country.","category":"economy","event_type":"other","importance":2,"flag":null,"market_moving":false,"location":{"place":"Jerusalem","country":"Israel","lat":31.768,"lon":35.214,"region":"me"},"entities":[],"links":[],"source":{"name":"MarketScreener","url":"https://www.marketscreener.com/news/latest/Israeli-startups-act-to-relocate-over-judicial-shakeup-survey-finds--44396368/"},"sources":[{"name":"MarketScreener","url":"https://www.marketscreener.com/news/latest/Israeli-startups-act-to-relocate-over-judicial-shakeup-survey-finds--44396368/"}],"published_at":"2023-07-23T11:29:13Z","retrieved_at":"2026-11-21T02:31:37Z","official":false,"ai_summary":true,"content_hash":"b7989cf070cf716b","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-21T02:31:37Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2023-07-23T11:29:13Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2023-07-23T12:00:00Z","publisher_country_gdelt":"IS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/city-skyline-business-district-7380729.jpg","alt":"city skyline business district (illustration)","credit":"GAIMARD","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/buildings-high-rise-buildings-7380729/"}}}