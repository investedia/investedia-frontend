{"n734eee5970":{"id":"n734eee5970","headline":"Possible tax on motorway and airport concessionaires in France aims to raise around €2.5 billion between 2024 and 2030","summary":"France is considering raising taxes on motorway concessionaires and may extend the plan to airports. The measure aims to raise around €2.5 billion between 2024 and 2030.","why":"Motorway and airport concessionaires operate long-term toll and airport contracts in France. Tax changes affect their cash flows and the value of infrastructure concessions.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Paris","country":"France","lat":48.857,"lon":2.352,"region":"eu"},"entities":[],"links":[],"source":{"name":"The Corner","url":"https://thecorner.eu/companies/possible-tax-on-motorway-and-airport-concessionaires-in-france-aims-to-raise-around-e2-5-billion-between-2024-and-2030/110599/"},"sources":[{"name":"The Corner","url":"https://thecorner.eu/companies/possible-tax-on-motorway-and-airport-concessionaires-in-france-aims-to-raise-around-e2-5-billion-between-2024-and-2030/110599/"}],"published_at":"2023-08-21T11:36:42Z","retrieved_at":"2026-11-21T02:31:37Z","official":false,"ai_summary":true,"content_hash":"771de5b48980edf7","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-21T02:31:37Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2023-08-21T11:36:42Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2023-08-21T12:00:00Z","publisher_country_gdelt":"SP","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/highway-bridge-construction-1892917.jpg","alt":"highway bridge construction (illustration)","credit":"hpgruesen","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/construction-site-1892917