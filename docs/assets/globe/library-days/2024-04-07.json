{"n4c926be51b":{"id":"n4c926be51b","headline":"IRDAI flags Hinduja Group-led IIHL's acquisition of Reliance Capital, says plan 'not in line with regulations' | Company Business News","summary":"The insurance regulator IRDAI said the resolution plan for debt-ridden Reliance Capital, led by Hinduja Group's IIHL, is not in line with regulations. It has sought clarification from the company.","why":"Reliance Capital is an Indian financial services group whose debt resolution depends on insurance regulator approval. Regulatory objections can delay or reshape distressed-asset sales in India's financial sector.","category":"companies","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.076,"lon":72.878,"region":"asia"},"entities":[{"name":"Reliance Capital","ticker":null,"kind":"company","unresolved":"no-ticker"},{"name":"IIHL","ticker":null,"kind":"company","unresolved":"no-ticker"}],"links":[],"source":{"name":"mint","url":"https://www.livemint.com/companies/news/irdai-flags-hinduja-group-led-iihls-acquisition-of-reliance-capital-says-plan-not-in-line-with-regulations-11712487106648.html"},"sources":[{"name":"mint","url":"https://www.livemint.com/companies/news/irdai-flags-hinduja-group-led-iihls-acquisition-of-reliance-capital-says-plan-not-in-line-with-regulations-11712487106648.html"}],"published_at":"2024-04-07T11:18:31Z","retrieved_at":"2026-11-20T00:39:02Z","official":false,"ai_summary":true,"content_hash":"30e0afb60a7747bf","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-20T00:39:02Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2024-04-07T11:18:31Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2024-04-07T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-815375.jpg","alt