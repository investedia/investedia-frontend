{"nd3514a5ed6":{"id":"nd3514a5ed6","headline":"Friendly nations to invest $27 billion in Pakistan in coming years: Ahsan","summary":"Pakistan's planning minister said friendly nations will invest $27 billion in coming years. Saudi Arabia is to invest $5 billion, the UAE and Kuwait $10 billion each, and Azerbaijan $2 billion.","why":"Foreign direct investment from Gulf states supports Pakistan's external financing and reserves, which are key to its macroeconomic stability and sovereign creditworthiness.","category":"economy","event_type":"capital","importance":2,"flag":null,"market_moving":false,"location":{"place":"Islamabad","country":"Pakistan","lat":33.69,"lon":73.04,"region":"asia"},"entities":[],"links":[],"source":{"name":"Business Recorder","url":"https://www.brecorder.com/news/40322532/friendly-nations-to-invest-27-billion-in-pakistan-in-coming-years-ahsan"},"sources":[{"name":"Business Recorder","url":"https://www.brecorder.com/news/40322532/friendly-nations-to-invest-27-billion-in-pakistan-in-coming-years-ahsan"}],"published_at":"2024-09-15T11:07:22Z","retrieved_at":"2026-11-19T19:01:17Z","official":false,"ai_summary":true,"content_hash":"d160ecdae3e13bf1","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-19T19:01:17Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2024-09-15T11:07:22Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2024-09-15T12:00:00Z","publisher_country_gdelt":"PK","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-3716552.jpg","alt":"banknotes money (illustration)","credit":"un-perfekt","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/business-rich-money-man-mens-suit-3716552/"}}}