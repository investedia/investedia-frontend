{"id":"nb86cdf4f93","headline":"STT collections jump 52.9 pc to Rs 40,214 crore in first six months of FY27","summary":"Securities Transaction Tax collections rose 52.9% to Rs 40,214 crore in the first six months of the current financial year. The increase reflects higher transaction activity.","why":"Securities Transaction Tax is levied on trades in Indian stocks and derivatives, so collections track market trading volumes. It is a revenue line for the Indian government.","category":"economy","event_type":"macro-data","importance":1,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"prokerala.com","url":"https://www.prokerala.com/news/articles/a1813810.html"},"sources":[{"name":"prokerala.com","url":"https://www.prokerala.com/news/articles/a1813810.html"}],"published_at":"2026-09-18T11:40:01Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"d5ab1fb69ce3d64f","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-18T11:40:01Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-18T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-3479568.jpg","alt":"banknotes money (illustration)","credit":"MabelAmber","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/dirham-moroccan-currency-banknote-3479568/"}}