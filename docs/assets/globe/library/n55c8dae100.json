{"id":"n55c8dae100","headline":"Japan Inflation Accelerates In July, Strengthening Case For Rate Hike In September","summary":"Japan's core inflation rose to 1.8% in July from 1.6% in June, strengthening expectations of a Bank of Japan rate hike in September. Import costs, a weaker yen and higher energy prices are adding pressure.","why":"The Bank of Japan sets the country's policy rate, and inflation data shape expectations for rate decisions that affect the yen and Japanese government bond yields.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Tokyo","country":"Japan","lat":35.676,"lon":139.65,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/japan-inflation-accelerates-in-july-strengthening-case-for-rate-hike-in-september"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/japan-inflation-accelerates-in-july-strengthening-case-for-rate-hike-in-september"}],"published_at":"2026-08-21T11:42:02Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"cde90e49a3f1823e","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-21T11:42:02Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-21T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-1726618.jpg","alt":"banknotes money (illustration)","credit":"stevepb","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/coins-banknotes-money-currency-1726618/"}}