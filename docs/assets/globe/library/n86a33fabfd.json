{"id":"n86a33fabfd","headline":"Ethiopia: New €4 Million Climate-Risk Insurance Initiative Targets 210,000 Ethiopian Farmers","summary":"The European Investment Bank, through EIB Global, announced a grant of up to €4 million to the World Food Programme. The funds will support climate-risk insurance products for smallholder farmers in Ethiopia.","why":"The European Investment Bank is the European Union's lending arm, financing development and infrastructure projects worldwide. Climate-risk insurance transfers weather losses from farmers to insurers and public funds.","category":"economy","event_type":"capital","importance":1,"flag":null,"market_moving":false,"location":{"place":"Addis Ababa","country":"Ethiopia","lat":9.03,"lon":38.74,"region":"af"},"entities":[],"links":[],"source":{"name":"allAfrica.com","url":"https://allafrica.com/stories/202608270038.html"},"sources":[{"name":"allAfrica.com","url":"https://allafrica.com/stories/202608270038.html"}],"published_at":"2026-08-27T04:13:15Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"3c6750409cbd2d47","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-27T04:13:15Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-27T06:00:00Z","publisher_country_gdelt":"MG","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/wheat-field-harvest-8192037.jpg","alt":"wheat field harvest (illustration)","credit":"andystrauss","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/harvest-agriculture-summer-grain-8192037/"}}