{"id":"nbc290d9767","headline":"Checkmate to the Indivisibility of Inheritances","summary":"Law No. 49/2026, dated August 17, gives the Portuguese Government a 180-day legislative authorisation to amend the Civil Code and the Code of Civil Procedure on inheritance. The reform itself is not yet enacted.","why":"Changes to inheritance and civil law affect estate planning, property transfers and the legal framework for family wealth in Portugal.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Lisbon","country":"Portugal","lat":38.722,"lon":-9.139,"region":"eu"},"entities":[],"links":[],"source":{"name":"SAPO","url":"https://sapo.pt/artigo/xeque-mate-a-indivisibilidade-das-herancas-6a863af503b4ab80f01987e8"},"sources":[{"name":"SAPO","url":"https://sapo.pt/artigo/xeque-mate-a-indivisibilidade-das-herancas-6a863af503b4ab80f01987e8"}],"published_at":"2026-08-19T23:21:18Z","retrieved_at":"2026-11-13T08:34:43Z","official":false,"ai_summary":true,"content_hash":"9d948dcf5c6e77c9","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-13T08:34:43Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-19T23:21:18Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-20T00:00:00Z","publisher_country_gdelt":"PO","description_from":"publisher page metadata, translated to English by Claude"},"headline_translated":true,"original_headline":"Xeque-mate à indivisibilidade das heranças","source_language":"por","image":{"kind":"topic","file":"photos/parliament-government-building-632851.jpg","alt":"parliament government building (illustration)","credit":"Hermann","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/budapest-hungary-632851/"}}