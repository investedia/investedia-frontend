{"id":"nf795b7cd50","headline":"The U.S.-Canada trade war is creating a headache for auto-parts makers","summary":"The trade war between the United States and Canada is threatening the tightly woven auto supply chains that have linked the two countries for decades. Auto-parts makers face growing difficulties.","why":"Automotive supply chains between the US and Canada are highly integrated, so tariffs on parts can raise costs for manufacturers and suppliers on both sides of the border.","category":"geopolitics","event_type":"trade","importance":2,"flag":null,"market_moving":false,"location":{"place":"Detroit","country":"United States of America","lat":42.33,"lon":-83.05,"region":"na"},"entities":[],"links":[],"source":{"name":"WUKY","url":"https://www.wuky.org/npr-news/2026-09-11/the-u-s-canada-trade-war-is-creating-a-headache-for-auto-parts-makers"},"sources":[{"name":"WUKY","url":"https://www.wuky.org/npr-news/2026-09-11/the-u-s-canada-trade-war-is-creating-a-headache-for-auto-parts-makers"}],"published_at":"2026-09-11T05:00:00Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"a98664e8a9eb74f5","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-11T05:00:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-11T18:00:00Z","publisher_country_gdelt":"JA","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/car-factory-4002026.jpg","alt":"car factory (illustration)","credit":"jwvein","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/power-station-smoke-character-man-4002026/"}}