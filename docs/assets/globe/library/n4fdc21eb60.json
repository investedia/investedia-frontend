{"id":"n4fdc21eb60","headline":"Power, gas shortages stall industrial production as output declines 0.4%","summary":"Factories face on average 4.1 hours of daily power outages and 3.2 hours of gas disruptions, with 94% reporting higher raw material costs. Industrial output declined 0.4%.","why":"Bangladesh's export-oriented manufacturing, notably garments, depends on reliable energy supply, so shortages affect growth and trade.","category":"economy","event_type":"energy-supply","importance":2,"flag":null,"market_moving":false,"location":{"place":"Dhaka","country":"Bangladesh","lat":23.81,"lon":90.412,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Business Standard Bangladesh","url":"https://www.tbsnews.net/economy/energy/power-gas-shortages-stall-industrial-production-output-declines-04-1612476"},"sources":[{"name":"The Business Standard Bangladesh","url":"https://www.tbsnews.net/economy/energy/power-gas-shortages-stall-industrial-production-output-declines-04-1612476"}],"published_at":"2026-11-24T09:30:00Z","retrieved_at":"2026-11-24T14:42:05Z","official":false,"ai_summary":true,"score":0,"content_hash":"dce5b0db3a635378","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-24T14:42:05Z","backfill_provenance":{"version":"regional-backfill-v1","original_published_at":"2026-11-24T09:30:00Z","feed_url":"https://www.tbsnews.net/economy/rss.xml"}}