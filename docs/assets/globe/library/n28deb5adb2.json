{"id":"n28deb5adb2","headline":"Magnetite Mines secures approvals for Ironback Hill drilling","summary":"Magnetite Mines has secured all required permits, approvals and heritage clearances for the first phase of drilling at Ironback Hill. The fully owned project is a rare earth element project in South Australia.","why":"Rare earth elements are used in magnets for electric vehicles and defence equipment, so supply projects attract strategic investor interest. Early-stage explorers carry high development risk.","category":"commodities","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Adelaide","country":"Australia","lat":-34.928,"lon":138.601,"region":"oc"},"entities":[{"name":"Magnetite Mines","ticker":null,"kind":"company","unresolved":"no-ticker"}],"links":[],"source":{"name":"Mining Technology","url":"https://www.mining-technology.com/news/magnetite-mines-approvals-ironback-hill-drilling/"},"sources":[{"name":"Mining Technology","url":"https://www.mining-technology.com/news/magnetite-mines-approvals-ironback-hill-drilling/"}],"published_at":"2026-02-17T09:28:35Z","retrieved_at":"2026-11-17T19:26:54Z","official":false,"ai_summary":true,"content_hash":"ebf953d0cd075d93","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T19:26:54Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-17T09:28:35Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-17T12:00:00Z","publisher_country_gdelt":"AS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/mountain-mining-site-4549408.jpg","alt":"mountain mining site (illustration)","credit":"11703009","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/potassium-salt-salt-mine-dump-4549408/"}}