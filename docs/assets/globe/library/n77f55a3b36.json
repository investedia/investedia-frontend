{"id":"n77f55a3b36","headline":"RBI Retains Tata Sons In Upper Layer NBFC List; De-registration Application Under Review","summary":"The Reserve Bank of India has retained Tata Sons on its Upper Layer NBFC list while its application to de-register as a Core Investment Company is examined. Several other major NBFCs also remain on the list.","why":"Tata Sons is the holding company of the Tata Group, and RBI classifications determine the regulatory requirements for large non-banking financial companies in India.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.076,"lon":72.878,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/rbi-retains-tata-sons-in-upper-layer-nbfc-list-de-registration-application-under-review"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/rbi-retains-tata-sons-in-upper-layer-nbfc-list-de-registration-application-under-review"}],"published_at":"2026-08-06T11:29:56Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"e23c83aa5679cbd6","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-06T11:29:56Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-06T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/bank-building-4785454.jpg","alt":"bank building (illustration)","credit":"Alex_vagler","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/building-columns-architecture-4785454/"}}