{"id":"n6ced5e6ae2","headline":"Gujarat: Banks disburse Rs 3.79 lakh crore to MSMEs, exceed annual credit target by 22 pc","summary":"Banks in Gujarat disbursed Rs 3,79,535 crore in credit to micro, small and medium enterprises during 2025-26. The amount exceeded the annual target by 22 percent.","why":"MSMEs are a major source of employment and economic activity in India, and their borrowing is a key indicator of credit demand in the banking sector. Banks in the state are a significant part of India's lending market.","category":"economy","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Gujarat","country":"India","lat":22.26,"lon":71.19,"region":"asia"},"entities":[],"links":[],"source":{"name":"prokerala.com","url":"https://www.prokerala.com/news/articles/a1806264.html"},"sources":[{"name":"prokerala.com","url":"https://www.prokerala.com/news/articles/a1806264.html"}],"published_at":"2026-08-29T17:00:01Z","retrieved_at":"2026-11-17T12:19:53Z","official":false,"ai_summary":true,"content_hash":"c89f571c027ed2de","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T12:19:53Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-29T17:00:01Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-29T18:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/bank-building-2717726.jpg","alt":"bank building (illustration)","credit":"moritz320","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/skyscraper-frankfurt-building-2717726/"}}