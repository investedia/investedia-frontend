{"id":"nf1f875670b","headline":"DGGI Slaps ₹40,603-Crore GST Notice On Mahadev Betting Syndicate","summary":"India's DGGI has proposed over Rs 40,603 crore in GST liability linked to the alleged Mahadev Book betting network. Two show-cause notices name dozens of alleged promoters, operators and associates.","why":"GST is India's main indirect tax, and large tax demands on illicit or gambling-linked operators draw attention to enforcement and tax-compliance risk in the country's financial system.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/mumbai/dggi-slaps-40603-crore-gst-notice-on-mahadev-betting-syndicate"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/mumbai/dggi-slaps-40603-crore-gst-notice-on-mahadev-betting-syndicate"}],"published_at":"2026-08-27T17:16:42Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"d29d5bb7c3f22d08","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-27T17:16:42Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-27T18:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-1362243.jpg","alt":"banknotes money (illustration)","credit":"NikolayFrolochkin","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/dollar-money-president-of-the-u-s-a-1362243/"}}