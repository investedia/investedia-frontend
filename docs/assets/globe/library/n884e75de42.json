{"id":"n884e75de42","headline":"Output for key crops decline, analysts urge diversification","summary":"Malawi's tobacco, tea, coffee and cotton output and earnings have declined from last year, the country's main foreign exchange earners. Analysts are urging export diversification and investment in other sectors.","why":"Agricultural exports are a major source of foreign exchange for Malawi, so falling crop income affects its currency reserves and external financing capacity.","category":"economy","event_type":"macro-data","importance":1,"flag":null,"market_moving":false,"location":{"place":"Lilongwe","country":"Malawi","lat":-13.97,"lon":33.79,"region":"af"},"entities":[],"links":[],"source":{"name":"Nation Online","url":"https://mwnation.com/output-for-key-crops-decline-analysts-urge-diversification/"},"sources":[{"name":"Nation Online","url":"https://mwnation.com/output-for-key-crops-decline-analysts-urge-diversification/"}],"published_at":"2026-09-11T23:59:00Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"5387d9abc6be6697","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-11T23:59:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-12T03:00:00Z","publisher_country_gdelt":"MI","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/wheat-field-harvest-9704240.jpg","alt":"wheat field harvest (illustration)","credit":"Nowaja","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/wheat-cereal-ear-seeds-field-9704240/"}}