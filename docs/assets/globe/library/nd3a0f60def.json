{"id":"nd3a0f60def","headline":"How the Insolvency code is evolving, and resolutions could be faster under new proposals - BusinessToday","summary":"Proposed changes to India's insolvency code would require resolution within 150 days, extendable by 45 days. The current process allows 330 days.","why":"The Insolvency and Bankruptcy Code governs how distressed Indian companies are restructured or liquidated. Faster timelines affect creditor recoveries and banks' bad-loan resolution.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"Business Today","url":"https://www.businesstoday.in/latest/corporate/story/how-the-insolvency-code-is-evolving-and-resolutions-could-be-faster-under-new-proposals-526186-2026-04-17"},"sources":[{"name":"Business Today","url":"https://www.businesstoday.in/latest/corporate/story/how-the-insolvency-code-is-evolving-and-resolutions-could-be-faster-under-new-proposals-526186-2026-04-17"}],"published_at":"2026-04-17T09:48:05Z","retrieved_at":"2026-11-17T16:57:23Z","official":false,"ai_summary":true,"content_hash":"44d085286c301421","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T16:57:23Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-17T09:48:05Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-17T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/office-meeting-2181979.jpg","alt":"office meeting (illustration)","credit":"Pexels","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/tables-chairs-furnitures-indoors-2181979/"}}