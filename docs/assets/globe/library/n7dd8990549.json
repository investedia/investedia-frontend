{"id":"n7dd8990549","headline":"Surplus liquidity in banking system hits Rs 5 lakh crore, highest since April","summary":"Surplus liquidity in India's banking system rose to Rs 5.05 lakh crore on August 30, boosted by FCNR(B) inflows and government spending. The level is the highest since April.","why":"Banking system liquidity influences short-term interest rates and the central bank's liquidity operations, which affect bond yields and lending.","category":"markets","event_type":"rates","importance":2,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.08,"lon":72.88,"region":"asia"},"entities":[],"links":[],"source":{"name":"BusinessLine","url":"https://www.thehindubusinessline.com/money-and-banking/banking-system-surplus-liquidity-surges-to-505-lakh-crore-in-august/article71411099.ece"},"sources":[{"name":"BusinessLine","url":"https://www.thehindubusinessline.com/money-and-banking/banking-system-surplus-liquidity-surges-to-505-lakh-crore-in-august/article71411099.ece"}],"published_at":"2026-08-31T13:38:53Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"5925c123a67cf21e","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-31T13:38:53Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-31T18:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/bank-building-50118.jpg","alt":"bank building (illustration)","credit":"Catonauts","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/sparkasse-bank-finance-germany-50118/"}}