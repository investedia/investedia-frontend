{"id":"n5dcbcc7755","headline":"RON97 up 60 sen, diesel in West Malaysia up 80 sen","summary":"Non-subsidised RON97 petrol rises by 60 sen and diesel in West Malaysia rises by 80 sen. The non-subsidised RON95 price also rises by 60 sen, effective until March 18.","why":"Fuel prices feed into transport and logistics costs across the economy. Malaysia adjusts pump prices periodically, and non-subsidised grades follow global crude and refining margins.","category":"economy","event_type":"commodity-prices","importance":1,"flag":null,"market_moving":false,"location":{"place":"Kuala Lumpur","country":"Malaysia","lat":3.139,"lon":101.687,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Malaysia Today | FMT","url":"https://www.freemalaysiatoday.com/category/nation/2026/03/11/ron97-up-60-sen-diesel-in-west-malaysia-up-80-sen"},"sources":[{"name":"Free Malaysia Today | FMT","url":"https://www.freemalaysiatoday.com/category/nation/2026/03/11/ron97-up-60-sen-diesel-in-west-malaysia-up-80-sen"}],"published_at":"2026-03-11T11:24:53Z","retrieved_at":"2026-11-17T18:46:37Z","official":false,"ai_summary":true,"content_hash":"215f585b3cb3d9c8","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:46:37Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-11T11:24:53Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-11T12:00:00Z","publisher_country_gdelt":"MY","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-6226244.jpg","alt":"oil refinery (illustration)","credit":"tasukaran","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/sunset-factory-buildings-6226244/"}}