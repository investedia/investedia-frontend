{"id":"n6581460dd7","headline":"Telangana to link vehicle data to Vahan, scrap 2% tax on used vehicles","summary":"Telangana will integrate its transport services with the national Vahan portal and abolish the additional 2% tax on second-hand vehicles from Monday. The change simplifies vehicle processes.","why":"Vahan is India's national vehicle registration database. State tax and registration rules shape costs and volumes in the used-vehicle market.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Hyderabad","country":"India","lat":17.385,"lon":78.487,"region":"asia"},"entities":[],"links":[],"source":{"name":"ETAuto.com","url":"https://auto.economictimes.indiatimes.com/news/industry/telangana-integrates-with-national-vahan-portal-eliminates-2-tax-on-used-vehicles/129731049"},"sources":[{"name":"ETAuto.com","url":"https://auto.economictimes.indiatimes.com/news/industry/telangana-integrates-with-national-vahan-portal-eliminates-2-tax-on-used-vehicles/129731049"}],"published_at":"2026-03-22T09:16:21Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"ccaa2bccdb1a0950","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-22T09:16:21Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-22T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/car-factory-4941342.jpg","alt":"car factory (illustration)","credit":"This_is_Engineering","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/engineer-engineering-teamwork-4941342/"}}