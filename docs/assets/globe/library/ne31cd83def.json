{"id":"ne31cd83def","headline":"EU’s fight to break China’s raw material dominance isn’t going well","summary":"Most of Europe's mining, processing and recycling projects aimed at reducing dependence on China for raw materials are behind schedule, according to POLITICO. The report highlights slow progress on the EU's supply strategy.","why":"Europe depends heavily on Chinese processing of critical minerals used in batteries, chips and defence, so delays in domestic projects affect supply security and industrial costs.","category":"commodities","event_type":"commodity-prices","importance":2,"flag":null,"market_moving":false,"location":{"place":"Brussels","country":"Belgium","lat":50.85,"lon":4.35,"region":"eu"},"entities":[],"links":[],"source":{"name":"POLITICO","url":"https://www.politico.eu/article/eu-china-critical-minerals-raw-materials-fight-break-dominance/"},"sources":[{"name":"POLITICO","url":"https://www.politico.eu/article/eu-china-critical-minerals-raw-materials-fight-break-dominance/"}],"published_at":"2026-10-08T19:40:20Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"9f5e8f0b5f49e25c","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-10-08T19:40:20Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-10-09T03:00:00Z","publisher_country_gdelt":"CH","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/mining-truck-3302959.jpg","alt":"mining truck (illustration)","credit":"scott_sd2","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/sky-panoramic-remote-industry-mine-3302959/"}}