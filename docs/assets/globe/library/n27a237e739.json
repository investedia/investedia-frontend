{"id":"n27a237e739","headline":"Bill proposes licensing rules, fee cap for foreign booking platforms - Türkiye News","summary":"A bill submitted to parliament by AKP lawmakers would require foreign-based online accommodation platforms to obtain a permit from the Culture and Tourism Ministry. It also sets a 17% ceiling on their fees.","why":"Online booking platforms take commissions on hotel and rental bookings, so fee caps and licensing rules directly change their economics in tourism markets.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Ankara","country":"Turkey","lat":39.93,"lon":32.86,"region":"eu"},"entities":[],"links":[],"source":{"name":"Hürriyet Daily News","url":"https://www.hurriyetdailynews.com/bill-proposes-licensing-rules-fee-cap-for-foreign-booking-platforms-225517"},"sources":[{"name":"Hürriyet Daily News","url":"https://www.hurriyetdailynews.com/bill-proposes-licensing-rules-fee-cap-for-foreign-booking-platforms-225517"}],"published_at":"2026-08-12T02:51:10Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"55cef8b67e893146","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-12T02:51:10Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-12T09:00:00Z","publisher_country_gdelt":"TU","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/hotel-tourism-1589495.jpg","alt":"hotel tourism (illustration)","credit":"WolfBlur","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/balmoral-hotel-edinburgh-scotland-1589495/"}}