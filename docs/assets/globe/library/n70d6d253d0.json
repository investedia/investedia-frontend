{"id":"n70d6d253d0","headline":"Plantation stocks face El Nino reality check","summary":"Plantation stocks may face a test as market expectations of higher crude palm oil prices are checked against actual fresh fruit bunch production. Investors want evidence El Nino will tighten supply.","why":"Palm oil is a major edible oil traded globally, and Malaysian plantation companies' earnings track its prices and output. Weather patterns such as El Nino can affect palm yields.","category":"commodities","event_type":"commodity-prices","importance":2,"flag":null,"market_moving":false,"location":{"place":"Petaling Jaya","country":"Malaysia","lat":3.11,"lon":101.61,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Star","url":"https://www.thestar.com.my/business/business-news/2026/09/28/plantation-stocks-face-el-nino-reality-check"},"sources":[{"name":"The Star","url":"https://www.thestar.com.my/business/business-news/2026/09/28/plantation-stocks-face-el-nino-reality-check"}],"published_at":"2026-09-28T00:00:00Z","retrieved_at":"2026-11-12T00:21:16Z","official":false,"ai_summary":true,"content_hash":"f49307cfd8b01b6a","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T00:21:16Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-28T00:00:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-28T00:00:00Z","publisher_country_gdelt":"MY","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/palm-oil-plantation-1464655.jpg","alt":"palm oil plantation (illustration)","credit":"tristantan","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/palm-oil-fruit-background-ripe-1464655/"}}