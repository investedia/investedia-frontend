{"id":"nb4c24f9c50","headline":"India wants to review, expand 15-year-old trade pact with Japan","summary":"India's government reiterated its demand for a review of the 15-year-old Comprehensive Economic Partnership Agreement with Japan. It also signalled willingness to expand the pact's scope.","why":"Trade agreements set tariff and market access rules that determine export opportunities for Indian and Japanese companies. Renegotiation can change the flow of goods, services and investment between the two countries.","category":"geopolitics","event_type":"trade","importance":2,"flag":null,"market_moving":false,"location":{"place":"Nagoya","country":"Japan","lat":35.18,"lon":136.91,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Times of India","url":"https://timesofindia.indiatimes.com/business/india-business/india-wants-to-review-expand-15-year-old-trade-pact-with-japan/articleshow/133552983.cms"},"sources":[{"name":"The Times of India","url":"https://timesofindia.indiatimes.com/business/india-business/india-wants-to-review-expand-15-year-old-trade-pact-with-japan/articleshow/133552983.cms"}],"published_at":"2026-08-26T22:59:00Z","retrieved_at":"2026-11-12T00:21:16Z","official":false,"ai_summary":true,"content_hash":"54f7fab598dcd457","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T00:21:16Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-26T22:59:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-27T00:00:00Z","publisher_country_gdelt":"JA","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/container-port-3118783.jpg","alt":"container port (illustration)","credit":"distelAPPArath","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/container-port-loading-stacked-3118783/"}}