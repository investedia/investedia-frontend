{"id":"n524bc82a9e","headline":"Beijing rejects Sinopec's request to tap commercial reserve, sources say","summary":"China has rejected a request by refiner Sinopec to access 13 million metric tons of national commercial reserves to offset an expected supply gap. The gap is linked to the U.S.-Israeli war on Iran.","why":"Sinopec is one of China's largest refiners and crude processors, so its feedstock supply shapes Chinese fuel output and regional crude demand. Commercial reserves are stockpiles that can cushion supply disruptions.","category":"commodities","event_type":"energy-supply","importance":2,"flag":null,"market_moving":false,"location":{"place":"Beijing","country":"China","lat":39.904,"lon":116.407,"region":"asia"},"entities":[{"name":"Sinopec","ticker":"0386.HK","kind":"company","unresolved":"unknown-ticker:0386.HK"}],"links":[],"source":{"name":"MarketScreener","url":"https://www.marketscreener.com/news/beijing-rejects-sinopec-s-request-to-tap-commercial-reserve-sources-say-ce7e5fddde8dff25"},"sources":[{"name":"MarketScreener","url":"https://www.marketscreener.com/news/beijing-rejects-sinopec-s-request-to-tap-commercial-reserve-sources-say-ce7e5fddde8dff25"}],"published_at":"2026-03-12T11:32:46Z","retrieved_at":"2026-11-17T18:46:37Z","official":false,"ai_summary":true,"content_hash":"f6210e1f86cca7f4","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:46:37Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-12T11:32:46Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-12T12:00:00Z","publisher_country_gdelt":"CH","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-7527769.jpg","alt":"oil refinery (illustration)","credit":"tasukaran","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/i