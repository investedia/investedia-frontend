{"id":"n57c50f6c50","headline":"EU offers to pay Ukraine to fix oil pipeline at the center of Ukraine-Hungary feud","summary":"EU officials have offered Ukraine money and technical help to fix a key oil pipeline to Central Europe. The move is aimed at persuading Hungary to drop its veto on major aid to Ukraine.","why":"Pipeline flows to Central Europe carry crude for refiners in the region, and EU aid decisions depend on unanimous approval by member states.","category":"geopolitics","event_type":"geopolitics","importance":2,"flag":null,"market_moving":false,"location":{"place":"Ukraine","country":"Ukraine","lat":49.0,"lon":32.0,"region":"eu"},"entities":[],"links":[],"source":{"name":"KUNC","url":"https://www.kunc.org/npr-news/2026-03-17/eu-offers-to-pay-ukraine-to-fix-oil-pipeline-at-the-center-of-ukraine-hungary-feud"},"sources":[{"name":"KUNC","url":"https://www.kunc.org/npr-news/2026-03-17/eu-offers-to-pay-ukraine-to-fix-oil-pipeline-at-the-center-of-ukraine-hungary-feud"}],"published_at":"2026-03-18T01:10:37Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"cfe6579d1d409532","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-18T01:10:37Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-18T06:00:00Z","publisher_country_gdelt":"HU","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/gas-pipeline-972191.jpg","alt":"gas pipeline (illustration)","credit":"WOKANDAPIX","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/power-electricity-energy-972191/"}}