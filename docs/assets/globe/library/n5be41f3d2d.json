{"id":"n5be41f3d2d","headline":"Customs duty on gold, silver, platinum tops Rs 10,460 crore since duty hike","summary":"India collected Rs 10,463 crore in customs duty on gold, silver and platinum imports between May 13 and August 2, following a duty increase. The figure reflects the period after the hike.","why":"India is one of the world's largest bullion importers, and import duties on precious metals affect domestic prices and trade flows. Changes in duty influence gold demand and smuggling incentives.","category":"commodities","event_type":"trade","importance":1,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"prokerala.com","url":"https://www.prokerala.com/news/articles/a1798618.html"},"sources":[{"name":"prokerala.com","url":"https://www.prokerala.com/news/articles/a1798618.html"}],"published_at":"2026-08-10T11:35:01Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"e0c04bd0be0612a6","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-10T11:35:01Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-10T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/gold-bars-8218390.jpg","alt":"gold bars (illustration)","credit":"soofiatailor","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/gold-coins-bullions-gold-bars-8218390/"}}