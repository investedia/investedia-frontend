{"id":"n5517a79439","headline":"Oil drops 1% as US, Iran pledge to continue talks","summary":"Oil prices fell 1% on Monday after the US and Iran pledged to continue nuclear talks. Brent dropped 67 cents to $67.38 a barrel and WTI fell 61 cents to $62.94.","why":"Brent and WTI are the main global crude benchmarks, and Middle East supply risk and sanctions policy are among the biggest drivers of their prices.","category":"commodities","event_type":"commodity-prices","importance":3,"flag":null,"market_moving":true,"location":{"place":"London","country":"United Kingdom","lat":51.51,"lon":-0.13,"region":"eu"},"entities":[],"links":[],"source":{"name":"Daily Times","url":"https://dailytimes.com.pk/1448561/oil-drops-1-as-us-iran-pledge-to-continue-talks/"},"sources":[{"name":"Daily Times","url":"https://dailytimes.com.pk/1448561/oil-drops-1-as-us-iran-pledge-to-continue-talks/"}],"published_at":"2026-02-09T17:00:04Z","retrieved_at":"2026-11-17T20:10:53Z","official":false,"ai_summary":true,"content_hash":"311f3727de657d68","impacts":[],"why_moved":"Pledges from the US and Iran to continue nuclear talks eased fears of immediate conflict in the Middle East, reducing the supply-risk premium in crude.","backfilled":true,"backfilled_at":"2026-11-17T20:10:53Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-09T17:00:04Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-09T18:00:00Z","publisher_country_gdelt":"IR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-6951382.jpg","alt":"oil refinery (illustration)","credit":"tasukaran","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/factory-industrial-urban-6951382/"}}