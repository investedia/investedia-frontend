{"id":"n66e454db9e","headline":"Vietnam&apos;s Quang Ngai eyes carbon credit revenue from 826,000 hectares of forest","summary":"Quang Ngai Province in central Vietnam has about 825,851 hectares of forest, estimated to absorb two million metric tons of carbon annually. It is developing pilot projects to generate carbon credit revenue.","why":"Carbon credits let landowners and governments sell verified emission reductions, creating a revenue stream that is increasingly tied to forest conservation and climate finance.","category":"economy","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Quang Ngai","country":"Vietnam","lat":15.12,"lon":108.8,"region":"asia"},"entities":[],"links":[],"source":{"name":"Tuoi tre news","url":"https://news.tuoitre.vn/vietnams-quang-ngai-eyes-carbon-credit-revenue-from-826000-hectares-of-forest-103261017095907871.htm"},"sources":[{"name":"Tuoi tre news","url":"https://news.tuoitre.vn/vietnams-quang-ngai-eyes-carbon-credit-revenue-from-826000-hectares-of-forest-103261017095907871.htm"}],"published_at":"2026-10-17T03:13:00Z","retrieved_at":"2026-11-17T12:11:23Z","official":false,"ai_summary":true,"content_hash":"b7365139aa828fd7","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T12:11:23Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-10-17T03:13:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-10-17T06:00:00Z","publisher_country_gdelt":"VM","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/palm-oil-plantation-2104784.jpg","alt":"palm oil plantation (illustration)","credit":"chiliapi","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/cycling-farm-oil-plum-gray-farm-2104784/"}}