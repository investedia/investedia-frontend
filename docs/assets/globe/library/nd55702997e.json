{"id":"nd55702997e","headline":"New MMDR Amendment Bill paves way for stronger push to mining-led growth","summary":"Parliament approved the Mines and Minerals (Development and Regulation) Amendment Bill, 2026, which seeks a uniform fiscal framework for mining. States cannot levy fresh taxes on mineral rights except under central conditions.","why":"India is a major producer of coal, iron ore and other minerals, so changes to mining taxation and state powers affect miners and resource investors.","category":"commodities","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"IANS News","url":"https://ianslive.in/new-bill-paves-way-for-stronger-push-to-mining-led-growth--20260818165703"},"sources":[{"name":"IANS News","url":"https://ianslive.in/new-bill-paves-way-for-stronger-push-to-mining-led-growth--20260818165703"}],"published_at":"2026-08-18T11:36:02Z","retrieved_at":"2026-11-12T00:21:16Z","official":false,"ai_summary":true,"content_hash":"3939179f6940e9b8","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T00:21:16Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-18T11:36:02Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-18T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/mountain-mining-site-4603874.jpg","alt":"mountain mining site (illustration)","credit":"thr1lls","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/building-landscape-mountains-mining-4603874/"}}