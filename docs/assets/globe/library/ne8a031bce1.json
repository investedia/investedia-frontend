{"id":"ne8a031bce1","headline":"Singapore fuel stocks plummet, 20% of Aussie fuel imports","summary":"Oil product inventories in Singapore fell by over 6.1 million barrels, or 13%, in one week. The largest drops were in light distillates and middle distillates. Singapore supplies about 20% of Australia's fuel imports.","why":"Singapore is Asia's main refining and oil-product trading hub, and its stocks are a benchmark for regional fuel supply.","category":"commodities","event_type":"energy-supply","importance":2,"flag":null,"market_moving":false,"location":{"place":"Singapore","country":"Singapore","lat":1.352,"lon":103.82,"region":"asia"},"entities":[],"links":[],"source":{"name":"MacroBusiness","url":"https://www.macrobusiness.com.au/2026/06/singapore-fuel-stocks-plummet-20-of-aussie-fuel-imports/"},"sources":[{"name":"MacroBusiness","url":"https://www.macrobusiness.com.au/2026/06/singapore-fuel-stocks-plummet-20-of-aussie-fuel-imports/"}],"published_at":"2026-06-06T21:29:25Z","retrieved_at":"2026-11-17T15:20:22Z","official":false,"ai_summary":true,"content_hash":"483e58142781dcee","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:20:22Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-06T21:29:25Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-07T00:00:00Z","publisher_country_gdelt":"AE","description_from":"publisher page metadata"}}