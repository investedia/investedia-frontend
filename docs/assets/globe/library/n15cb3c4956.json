{"id":"n15cb3c4956","headline":"Ethiopian Coffee Remains Strategic Asset and Living Heritage - Agriculture Ministry","summary":"The Ethiopian Ministry of Agriculture reaffirmed that coffee is a living cultural heritage and a strategic economic asset for Ethiopia and Africa. It is more than an export commodity.","why":"Coffee is a major agricultural export for Ethiopia, the birthplace of Arabica, and supply and export policy can affect global coffee prices.","category":"commodities","event_type":"commodity-prices","importance":1,"flag":null,"market_moving":false,"location":{"place":"Addis Ababa","country":"Ethiopia","lat":9.03,"lon":38.74,"region":"af"},"entities":[],"links":[],"source":{"name":"allAfrica.com","url":"https://allafrica.com/stories/202602030008.html"},"sources":[{"name":"allAfrica.com","url":"https://allafrica.com/stories/202602030008.html"}],"published_at":"2026-02-03T04:44:55Z","retrieved_at":"2026-11-17T20:10:53Z","official":false,"ai_summary":true,"content_hash":"80be63d56db2b2f8","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T20:10:53Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-03T04:44:55Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-03T06:00:00Z","publisher_country_gdelt":"ET","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/coffee-beans-5447420.jpg","alt":"coffee beans (illustration)","credit":"NickyPe","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/coffee-coffee-beans-roasted-aroma-5447420/"}}