{"id":"na3508aba22","headline":"LPG supply woes: Kerala hotels call strike on March 23, demand essential service status - BusinessToday","summary":"Hotels and eateries across Kerala will remain shut on March 23 in protest over commercial LPG supply problems. They are demanding essential service status.","why":"Commercial LPG is the main cooking fuel for restaurants and hotels, so supply shortages hit hospitality businesses directly. Energy supply disruptions can reduce output and revenue for consumer-facing firms.","category":"economy","event_type":"energy-supply","importance":1,"flag":null,"market_moving":false,"location":{"place":"Thiruvananthapuram","country":"India","lat":8.52,"lon":76.94,"region":"asia"},"entities":[],"links":[],"source":{"name":"Business Today","url":"https://www.businesstoday.in/india/story/kerala-hotels-call-march-23-strike-amid-lpg-crisis-demand-essential-service-status-521205-2026-03-18"},"sources":[{"name":"Business Today","url":"https://www.businesstoday.in/india/story/kerala-hotels-call-march-23-strike-amid-lpg-crisis-demand-essential-service-status-521205-2026-03-18"}],"published_at":"2026-03-18T11:31:38Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"e83ddf09fec0c7de","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-18T11:31:38Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-18T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/hotel-tourism-4539714.jpg","alt":"hotel tourism (illustration)","credit":"Michelle-Maria","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/hotel-roanoke-virginia-landmark-4539714/"}}