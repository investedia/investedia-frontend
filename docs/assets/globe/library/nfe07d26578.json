{"id":"nfe07d26578","headline":"Adani's Godda unit to stay shut for 25-day overhaul, halving supply to Bangladesh","summary":"Adani's Godda power plant unit will remain shut for a 25-day overhaul, halving supply to Bangladesh. The plant's second 800MW unit will continue normal operations.","why":"Adani Power operates the Godda plant in India, which supplies electricity to Bangladesh under a cross-border contract, so outages affect both companies and Bangladesh's power supply.","category":"companies","event_type":"energy-supply","importance":1,"flag":null,"market_moving":false,"location":{"place":"Godda","country":"India","lat":24.827,"lon":87.211,"region":"asia"},"entities":[{"name":"Adani Power","ticker":"ADANIPOWER.NS","kind":"company","asset":{"id":"EQ:XNSE:ADANIPOWER","n":"Adani Power","c":"equity","px":"ADANIPOWER.NS","la":19.06,"lo":72.86,"geo":"listing-venue","co":"CO:EQ:XNSE:ADANIPOWER","m":"ticker+name","rv":"registry-v1"}}],"links":[],"source":{"name":"The Business Standard Bangladesh","url":"https://www.tbsnews.net/economy/energy/adanis-godda-unit-stay-shut-25-day-overhaul-halving-supply-bangladesh-1613781"},"sources":[{"name":"The Business Standard Bangladesh","url":"https://www.tbsnews.net/economy/energy/adanis-godda-unit-stay-shut-25-day-overhaul-halving-supply-bangladesh-1613781"}],"published_at":"2026-11-25T11:50:00Z","retrieved_at":"2026-11-25T14:49:59Z","official":false,"ai_summary":true,"score":0,"content_hash":"36347a9a25b92c26","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-25T14:49:59Z","backfill_provenance":{"version":"regional-backfill-v1","original_published_at":"2026-11-25T11:50:00Z","feed_url":"https://www.tbsnews.net/economy/rss.xml"}}