{"id":"na2df2f9bc2","headline":"UN warns El Nino may bring extreme heat worldwide","summary":"The UN weather agency says a moderate or possibly strong El Nino is developing. It warns of higher temperatures, drought and mounting pressure on crops and food prices, especially in Asia.","why":"El Nino is a periodic warming of Pacific waters that disrupts rainfall and harvests. It can affect agricultural commodity prices and food inflation.","category":"commodities","event_type":"commodity-prices","importance":2,"flag":null,"market_moving":false,"location":{"place":"Geneva","country":"Switzerland","lat":46.2,"lon":6.14,"region":"eu"},"entities":[],"links":[],"source":{"name":"Pakistan Today","url":"https://www.pakistantoday.com.pk/2026/06/04/un-warns-of-extreme-heat-and-weather-risks-as-el-nino-strengthens"},"sources":[{"name":"Pakistan Today","url":"https://www.pakistantoday.com.pk/2026/06/04/un-warns-of-extreme-heat-and-weather-risks-as-el-nino-strengthens"}],"published_at":"2026-06-04T11:03:38Z","retrieved_at":"2026-11-17T15:20:22Z","official":false,"ai_summary":true,"content_hash":"7e22460ca784e4da","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:20:22Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-04T11:03:38Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-04T12:00:00Z","publisher_country_gdelt":"ID","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/wheat-field-harvest-8252527.jpg","alt":"wheat field harvest (illustration)","credit":"niki_emmert","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/agriculture-background-bread-bright-8252527/"}}