{"id":"n5272891b11","headline":"Rs 1,600-1,700 cr a day, Rs 1 lakh cr in 10 weeks: Cost  of insulating India from global energy shock","summary":"State-owned oil firms are incurring about Rs 1,600-1,700 crore per day to shield Indian consumers from the global energy shock. Losses are widening and have passed Rs 1 lakh crore over 10 weeks.","why":"State-owned oil marketers in India set retail fuel prices in practice, so their losses signal fiscal and balance-sheet pressure tied to crude prices.","category":"economy","event_type":"energy-supply","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"Daily Excelsior","url":"https://www.dailyexcelsior.com/rs-1600-1700-cr-a-day-rs-1-lakh-cr-in-10-weeks-cost-of-insulating-india-from-global-energy-shock/"},"sources":[{"name":"Daily Excelsior","url":"https://www.dailyexcelsior.com/rs-1600-1700-cr-a-day-rs-1-lakh-cr-in-10-weeks-cost-of-insulating-india-from-global-energy-shock/"}],"published_at":"2026-05-10T10:48:12Z","retrieved_at":"2026-11-17T16:23:27Z","official":false,"ai_summary":true,"content_hash":"1210eb069c2d2da6","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T16:23:27Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-05-10T10:48:12Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-05-10T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-5366666.jpg","alt":"oil refinery (illustration)","credit":"Tho-Ge","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/rhine-industry-refinery-tanks-5366666/"}}