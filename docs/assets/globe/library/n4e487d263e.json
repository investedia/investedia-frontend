{"id":"n4e487d263e","headline":"DBCC: Suspending excise taxes on gasoline, diesel, won","summary":"The Philippines' inter-agency DBCC said suspending fuel excise taxes would likely cut pump prices only marginally, as the global oil market remains volatile. The statement was released on April 14.","why":"Fuel excise taxes shape domestic pump prices, inflation and government revenue. The DBCC is the body that coordinates the Philippines' macroeconomic and budget planning.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Manila","country":"Philippines","lat":14.6,"lon":120.984,"region":"asia"},"entities":[],"links":[],"source":{"name":"Philstar.com","url":"https://www.philstar.com/headlines/2026/04/14/2520939/dbcc-suspending-excise-taxes-gasoline-diesel-wont-provide-meaningful-relief"},"sources":[{"name":"Philstar.com","url":"https://www.philstar.com/headlines/2026/04/14/2520939/dbcc-suspending-excise-taxes-gasoline-diesel-wont-provide-meaningful-relief"}],"published_at":"2026-04-14T05:32:00Z","retrieved_at":"2026-11-17T17:30:28Z","official":false,"ai_summary":true,"content_hash":"9f40c7f4be8b500f","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T17:30:28Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-14T05:32:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-14T06:00:00Z","publisher_country_gdelt":"RP","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-7010971.jpg","alt":"oil refinery (illustration)","credit":"yamabon","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/plant-chimney-night-view-7010971/"}}