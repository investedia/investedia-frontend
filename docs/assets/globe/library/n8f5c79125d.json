{"id":"n8f5c79125d","headline":"Finance Ministry Clarifies Pakistan's External Debt Position","summary":"Pakistan's Ministry of Finance clarified certain assertions made in a recent press commentary about the country's external debt position and associated interest payments. The ministry said the commentary's figures were presented differently.","why":"External debt and interest payments determine how much foreign currency Pakistan must service, which is central to its sovereign credit assessment and currency stability.","category":"economy","event_type":"macro-data","importance":1,"flag":null,"market_moving":false,"location":{"place":"Islamabad","country":"Pakistan","lat":33.69,"lon":73.04,"region":"asia"},"entities":[],"links":[],"source":{"name":"News Makers","url":"https://newsmakers.pk/finance-ministry-clarifies-pakistans-external-debt-position/"},"sources":[{"name":"News Makers","url":"https://newsmakers.pk/finance-ministry-clarifies-pakistans-external-debt-position/"}],"published_at":"2026-02-22T00:00:00Z","retrieved_at":"2026-11-17T19:26:54Z","official":false,"ai_summary":true,"content_hash":"433c1cd4890e8605","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T19:26:54Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-22T00:00:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-23T18:00:00Z","publisher_country_gdelt":"PK","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-4788732.jpg","alt":"parliament government building (illustration)","credit":"adil-photos","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/berlin-reichstag-the-german-volke-4788732/"}}