{"id":"nd5fe7f577f","headline":"Rupee recovers 15 paise to 95.28 against US dollar in early trade","summary":"The rupee rose 15 paise to 95.28 against the US dollar in early trade on Tuesday. Lower crude price expectations, easing Middle East tensions and a Saudi cut to Asian oil prices supported sentiment.","why":"The rupee is sensitive to oil prices because India imports most of its crude, so lower crude prices ease pressure on the currency.","category":"markets","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.076,"lon":72.878,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Times of India","url":"https://timesofindia.indiatimes.com/business/india-business/rupee-recovers-15-paise-to-95-28-against-us-dollar-in-early-trade/articleshow/132231110.cms"},"sources":[{"name":"The Times of India","url":"https://timesofindia.indiatimes.com/business/india-business/rupee-recovers-15-paise-to-95-28-against-us-dollar-in-early-trade/articleshow/132231110.cms"}],"published_at":"2026-07-07T05:24:00Z","retrieved_at":"2026-11-17T13:01:10Z","official":false,"ai_summary":true,"content_hash":"34c6e9125faef015","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:01:10Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-07-07T05:24:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-07-07T06:00:00Z","publisher_country_gdelt":"MU","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-1005464.jpg","alt":"banknotes money (illustration)","credit":"moerschy","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/money-banknotes-euro-hand-banknote-1005464/"}}