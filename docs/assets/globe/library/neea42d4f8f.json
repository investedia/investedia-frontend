{"id":"neea42d4f8f","headline":"Ships Turn to Makeshift Armor as Black Sea Attacks Surge","summary":"Tankers and cargo ships transit the Bosphorus with nets, water tanks and tyres to defend against Russian and Ukrainian drone strikes in the Black Sea. Security experts and video obtained by Reuters show the measures.","why":"The Black Sea and the Bosphorus are key routes for grain, oil and other commodity exports. Attacks on shipping raise insurance and freight costs for these cargoes.","category":"geopolitics","event_type":"geopolitics","importance":2,"flag":null,"market_moving":false,"location":{"place":"Istanbul","country":"Turkey","lat":41.01,"lon":28.98,"region":"eu"},"entities":[],"links":[],"source":{"name":"gCaptain","url":"https://gcaptain.com/ships-turn-to-makeshift-armor-as-black-sea-attacks-surge/"},"sources":[{"name":"gCaptain","url":"https://gcaptain.com/ships-turn-to-makeshift-armor-as-black-sea-attacks-surge/"}],"published_at":"2026-09-02T15:27:42Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"032e15c42d84901a","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-02T15:27:42Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-02T18:00:00Z","publisher_country_gdelt":"TU","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-tanker-ship-7338163.jpg","alt":"oil tanker ship (illustration)","credit":"analogicus","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/cargo-ship-sea-sunset-twilight-7338163/"}}