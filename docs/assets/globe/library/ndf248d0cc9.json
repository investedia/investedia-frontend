{"id":"ndf248d0cc9","headline":"Indonesia prepares soybean subsidy to curb rupiah impact","summary":"The Indonesian government will provide a soybean subsidy of Rp2,000 per kilogram, with state logistics firm Bulog rolling out the programme. The measure is aimed at curbing the impact of the rupiah's weakness.","why":"Soybeans are a key food input in Indonesia, used for tempeh and tofu, so subsidies affect food prices and inflation. Bulog is the state logistics agency handling food distribution.","category":"economy","event_type":"commodity-prices","importance":2,"flag":null,"market_moving":false,"location":{"place":"Jakarta","country":"Indonesia","lat":-6.209,"lon":106.846,"region":"asia"},"entities":[{"name":"Perum Bulog","ticker":null,"kind":"company","unresolved":"no-ticker"}],"links":[],"source":{"name":"Antara News","url":"https://en.antaranews.com/news/418607/indonesia-prepares-soybean-subsidy-to-curb-rupiah-impact"},"sources":[{"name":"Antara News","url":"https://en.antaranews.com/news/418607/indonesia-prepares-soybean-subsidy-to-curb-rupiah-impact"}],"published_at":"2026-06-09T10:01:49Z","retrieved_at":"2026-11-17T15:20:22Z","official":false,"ai_summary":true,"content_hash":"2703f10ae1aaf1e2","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:20:22Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-09T10:01:49Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-09T12:00:00Z","publisher_country_gdelt":"ID","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/farm-tractor-7152484.jpg","alt":"farm tractor (illustration)","credit":"aszak","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/tractor-field-farm-agriculture-7152484/"}}