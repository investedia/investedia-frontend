{"id":"n44d251e728","headline":"Malawi: Reserve Bank of Malawi Caught Up in $1.1m Forex Seizure Case","summary":"The Reserve Bank of Malawi is holding $1.1m in cash seized from two Tanzanian nationals. The case comes as Malawi faces a severe foreign exchange shortage and concern over illicit financial flows.","why":"The central bank manages foreign reserves and the currency, so its role in forex cases bears on investor confidence in Malawi's financial system.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Lilongwe","country":"Malawi","lat":-13.96,"lon":33.77,"region":"af"},"entities":[],"links":[],"source":{"name":"allAfrica.com","url":"https://allafrica.com/stories/202607080392.html"},"sources":[{"name":"allAfrica.com","url":"https://allafrica.com/stories/202607080392.html"}],"published_at":"2026-07-08T11:30:26Z","retrieved_at":"2026-11-17T13:01:10Z","official":false,"ai_summary":true,"content_hash":"af384ab00d301de6","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:01:10Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-07-08T11:30:26Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-07-08T12:00:00Z","publisher_country_gdelt":"MI","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/bank-building-224394.jpg","alt":"bank building (illustration)","credit":"BruceEmmerling","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/new-york-city-new-york-manhattan-224394/"}}