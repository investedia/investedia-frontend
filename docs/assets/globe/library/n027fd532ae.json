{"id":"n027fd532ae","headline":"East Africa: Ethiopia, France Deepen Strategic Partnership With Landmark Debt Restructuring","summary":"Ethiopia and France signed historic agreements on debt restructuring and a strategic development partnership. The deals advance Ethiopia's macroeconomic reform and economic recovery efforts.","why":"Debt restructuring reduces repayment burdens on a sovereign borrower and affects its ability to attract investment and financing. Ethiopia's external debt position is a key factor for international lenders.","category":"economy","event_type":"other","importance":2,"flag":null,"market_moving":false,"location":{"place":"Addis Ababa","country":"Ethiopia","lat":9.03,"lon":38.74,"region":"af"},"entities":[],"links":[],"source":{"name":"allAfrica.com","url":"https://allafrica.com/stories/202602120619.html"},"sources":[{"name":"allAfrica.com","url":"https://allafrica.com/stories/202602120619.html"}],"published_at":"2026-02-12T17:41:11Z","retrieved_at":"2026-11-17T20:10:53Z","official":false,"ai_summary":true,"content_hash":"1882715d2c58bf28","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T20:10:53Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-12T17:41:11Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-12T18:00:00Z","publisher_country_gdelt":"ET","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/african-market-2141661.jpg","alt":"african market (illustration)","credit":"mdccruz01","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/angola-frames-luanda-2141661/"}}