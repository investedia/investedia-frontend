{"id":"n242e4fe09e","headline":"Iran announces plans to bring in maritime fees for strait of Hormuz","summary":"Iran says fees to cover the cost of managing the strait will take effect at the end of a 60-day negotiation period, as the US lifts its blockade. The strait is a key route for global oil shipments.","why":"The Strait of Hormuz is a critical chokepoint through which a large share of seaborne oil passes, so changes to transit costs or access affect energy markets.","category":"geopolitics","event_type":"geopolitics","importance":3,"flag":null,"market_moving":true,"location":{"place":"Strait of Hormuz","country":"Iran","lat":26.56,"lon":56.25,"region":"me"},"entities":[],"links":[],"source":{"name":"the Guardian","url":"https://www.theguardian.com/world/2026/jun/18/iran-announces-plans-to-bring-in-maritime-fees-for-strait-of-hormuz"},"sources":[{"name":"the Guardian","url":"https://www.theguardian.com/world/2026/jun/18/iran-announces-plans-to-bring-in-maritime-fees-for-strait-of-hormuz"}],"published_at":"2026-06-18T21:50:46Z","retrieved_at":"2026-11-17T13:38:59Z","official":false,"ai_summary":true,"content_hash":"6867f580a6bd4014","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:38:59Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-18T21:50:46Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-18T18:00:00Z","publisher_country_gdelt":"PK","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-tanker-ship-7338163.jpg","alt":"oil tanker ship (illustration)","credit":"analogicus","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/cargo-ship-sea-sunset-twilight-7338163/"}}