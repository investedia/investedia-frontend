{"id":"n1714b7fd50","headline":"RBI to review Rs 3 lakh income threshold for microfinance borrowers: Deputy Governor","summary":"The Reserve Bank of India will review the Rs 3 lakh annual household income threshold for microfinance borrowers, Deputy Governor Shirish Chandra said. The threshold sets eligibility for microloans.","why":"The Reserve Bank of India is the country's central bank and microfinance regulator. Eligibility rules shape the size and risk profile of lenders' loan books.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.076,"lon":72.878,"region":"asia"},"entities":[],"links":[],"source":{"name":"prokerala.com","url":"https://www.prokerala.com/news/articles/a1837044.html"},"sources":[{"name":"prokerala.com","url":"https://www.prokerala.com/news/articles/a1837044.html"}],"published_at":"2026-11-15T13:40:01Z","retrieved_at":"2026-11-15T20:16:48Z","official":false,"ai_summary":true,"content_hash":"6dc4ded14a1d2204","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-15T20:16:48Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-11-15T13:40:01Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-11-15T14:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-1013789.jpg","alt":"banknotes money (illustration)","credit":"stevepb","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/wallet-cash-pocket-credit-card-1013789/"}}