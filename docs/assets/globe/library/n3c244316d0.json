{"id":"n3c244316d0","headline":"Rajya Sabha passes Appropriation No.3 Bill authorising Rs 54,067 crore excess spending for FY23","summary":"The Rajya Sabha approved the Appropriation No.3 Bill, authorising excess spending of Rs 54,067 crore for the year ending March 31, 2023. A larger part covers debt repayment of Rs 53,871 crore.","why":"Parliamentary appropriation bills authorise government spending beyond budgeted limits. They affect fiscal deficit tracking, which matters for India's sovereign debt investors.","category":"economy","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/news/india/rajya-sabha-passes-appropriation-bill-authorising-rs-54067-crore-excess-spending-for-fy23/articleshow/133001183.cms"},"sources":[{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/news/india/rajya-sabha-passes-appropriation-bill-authorising-rs-54067-crore-excess-spending-for-fy23/articleshow/133001183.cms"}],"published_at":"2026-08-06T11:29:00Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"18c3ec8ef1c21927","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-06T11:29:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-06T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-4788732.jpg","alt":"parliament government building (illustration)","credit":"adil-photos","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/be