{"id":"n1ac2bfcaf2","headline":"Embattled motorists win bowser relief as taxes slashed","summary":"The government moved to cut taxes on petrol and diesel as the Middle East war sends global fuel prices higher. The relief targets motorists facing higher pump prices.","why":"Fuel excise taxes make up a large share of pump prices, so changes to them directly affect consumer fuel costs and inflation. Fiscal costs also matter for the government budget.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Canberra","country":"Australia","lat":-35.28,"lon":149.13,"region":"oc"},"entities":[],"links":[],"source":{"name":"macleayargus.com.au","url":"https://www.macleayargus.com.au/story/9209786/leaders-eye-cut-to-fuel-excise-work-from-home-measures/"},"sources":[{"name":"macleayargus.com.au","url":"https://www.macleayargus.com.au/story/9209786/leaders-eye-cut-to-fuel-excise-work-from-home-measures/"}],"published_at":"2026-03-30T05:05:24Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"4407722a1998abf2","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-30T05:05:24Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-30T00:00:00Z","publisher_country_gdelt":"AS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/gas-pipeline-109025.jpg","alt":"gas pipeline (illustration)","credit":"jpenrose","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/refinery-oil-aerial-natural-gas-109025/"}}