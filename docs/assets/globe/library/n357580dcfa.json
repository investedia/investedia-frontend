{"id":"n357580dcfa","headline":"Water, Power and Double Standards: India's Indus Position Meets China's Tibet Dam","summary":"China has formally started building what is described as the world's largest hydroelectric project on the Yarlung Tsangpo River in Tibet. The project is estimated to cost around $168 billion and is expected to exceed the Three Gorges Dam in power capacity.","why":"Large hydropower projects in Tibet affect water flows to downstream South Asian countries such as India and Bangladesh. They also represent major state infrastructure spending for China.","category":"geopolitics","event_type":"other","importance":2,"flag":null,"market_moving":false,"location":{"place":"Nyingchi","country":"China","lat":29.654,"lon":94.362,"region":"asia"},"entities":[],"links":[],"source":{"name":"Daily Times","url":"https://dailytimes.com.pk/1513211/water-power-and-double-standards-indias-indus-position-meets-chinas-tibet-dam/"},"sources":[{"name":"Daily Times","url":"https://dailytimes.com.pk/1513211/water-power-and-double-standards-indias-indus-position-meets-chinas-tibet-dam/"}],"published_at":"2026-06-25T04:50:17Z","retrieved_at":"2026-11-17T13:38:59Z","official":false,"ai_summary":true,"content_hash":"6c1bbd3f83b01e23","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:38:59Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-25T04:50:17Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-25T06:00:00Z","publisher_country_gdelt":"PK","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/hydroelectric-dam-2976738.jpg","alt":"hydroelectric dam (illustration)","credit":"liggraphy","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/energy-flow-water-hydropower-2976738/"}}