{"id":"na05798c811","headline":"S. Korea posts largest-ever current account surplus in Feb.: BOK","summary":"South Korea recorded its largest-ever monthly current account surplus in February, the central bank said. The result was driven by a semiconductor upcycle and strong exports.","why":"The current account measures a country's trade and income flows with the rest of the world and affects its currency. South Korea's exports are heavily weighted toward semiconductors.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Seoul","country":"South Korea","lat":37.57,"lon":126.98,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Korea Herald","url":"https://www.koreaherald.com/article/10712101"},"sources":[{"name":"The Korea Herald","url":"https://www.koreaherald.com/article/10712101"}],"published_at":"2026-04-07T23:04:49Z","retrieved_at":"2026-11-17T17:30:28Z","official":false,"ai_summary":true,"content_hash":"9a9eb82b47d67ff7","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T17:30:28Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-07T23:04:49Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-08T00:00:00Z","publisher_country_gdelt":"KS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/shipping-containers-yard-4465494.jpg","alt":"shipping containers yard (illustration)","credit":"Engin_Akyurt","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/container-shipping-port-ship-4465494/"}}