{"id":"na2f97364b7","headline":"‘Baseless’: Piyush Goyal quashes Rahul Gandhi's claims on India-US trade deal","summary":"Indian Union Minister Piyush Goyal said the government protects farmers' interests and called Rahul Gandhi's allegations about the India-US trade deal baseless. The dispute concerns the terms of the agreement.","why":"The India-US trade deal affects tariffs on agricultural and industrial goods, which matters for exporters, importers and sector-level trade flows between the two economies.","category":"geopolitics","event_type":"trade","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"Hindustan Times","url":"https://www.hindustantimes.com/india-news/baseless-piyush-goyal-quashes-rahul-gandhis-claims-on-india-us-trade-deal-101771057097639.html"},"sources":[{"name":"Hindustan Times","url":"https://www.hindustantimes.com/india-news/baseless-piyush-goyal-quashes-rahul-gandhis-claims-on-india-us-trade-deal-101771057097639.html"}],"published_at":"2026-02-14T09:41:30Z","retrieved_at":"2026-11-17T20:10:53Z","official":false,"ai_summary":true,"content_hash":"b0e374e7aee63475","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T20:10:53Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-14T09:41:30Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-14T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-815375.jpg","alt":"parliament government building (illustration)","credit":"festivio","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/ottawa-parliament-canada-government-815375/"}}