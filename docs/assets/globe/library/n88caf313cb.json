{"id":"n88caf313cb","headline":"Nirmala Sitharaman Rejects Jairam Ramesh","summary":"Finance Minister Nirmala Sitharaman rejected Jairam Ramesh's criticism of the Taxation and Other Laws (Amendment) Bill, 2026. She said the merchant discount rate applies only to merchants and will help banks and fintechs invest.","why":"The merchant discount rate is the fee merchants pay on digital payments, and changes to it affect the revenue of payment providers and banks.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.614,"lon":77.209,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/india/nirmala-sitharaman-rejects-jairam-rameshs-upi-charge-claims-says-mdr-applies-only-to-merchants"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/india/nirmala-sitharaman-rejects-jairam-rameshs-upi-charge-claims-says-mdr-applies-only-to-merchants"}],"published_at":"2026-08-06T17:37:40Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"a03aba034a45e3a9","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-06T17:37:40Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-06T18:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-4786106.jpg","alt":"parliament government building (illustration)","credit":"iankelsall1","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/budapest-parliament-architecture-4786106/"}}