{"id":"n4f37a278b6","headline":"Gulf Storm Threat Could Put 3 Million Bpd of Refining Capacity at Risk","summary":"A tropical disturbance could bring strong winds, flooding, storm surge and tornadoes to Gulf Coast states from Louisiana to Florida next weekend. The storm threatens about 3 million barrels per day of refining capacity.","why":"The US Gulf Coast hosts a large share of American refining capacity, so disruptions there can tighten fuel supply and affect crude demand. Hurricane-season risk is a recurring factor for energy markets.","category":"commodities","event_type":"energy-supply","importance":2,"flag":null,"market_moving":false,"location":{"place":"Houston","country":"United States of America","lat":29.76,"lon":-95.37,"region":"na"},"entities":[],"links":[],"source":{"name":"OilPrice.com","url":"https://oilprice.com/Energy/Energy-General/Gulf-Storm-Threat-Could-Put-3-Million-Bpd-of-Refining-Capacity-at-Risk.html"},"sources":[{"name":"OilPrice.com","url":"https://oilprice.com/Energy/Energy-General/Gulf-Storm-Threat-Could-Put-3-Million-Bpd-of-Refining-Capacity-at-Risk.html"}],"published_at":"2026-10-06T16:00:00Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"7550948201ff1c13","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-10-06T16:00:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-10-06T18:00:00Z","publisher_country_gdelt":"SA","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-6991799.jpg","alt":"oil refinery (illustration)","credit":"tasukaran","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/factory-chimney-industry-steam-6991799/"}}