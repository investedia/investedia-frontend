{"id":"ncea01f4506","headline":"Oman and Iran to pursue talks on managing navigation in Strait of Hormuz","summary":"Oman and Iran agreed to continue discussions on the future administration of navigation in the Strait of Hormuz, including maritime services and their associated costs. Reuters reported the agreement.","why":"The Strait of Hormuz carries a large share of global seaborne oil, so governance of its navigation and shipping costs affects energy markets and shipping insurers.","category":"geopolitics","event_type":"geopolitics","importance":2,"flag":null,"market_moving":false,"location":{"place":"Muscat","country":"Oman","lat":23.588,"lon":58.383,"region":"me"},"entities":[],"links":[],"source":{"name":"Apa.az","url":"https://en.apa.az/asia/oman-and-iran-to-pursue-talks-on-managing-navigation-in-strait-of-hormuz-512823"},"sources":[{"name":"Apa.az","url":"https://en.apa.az/asia/oman-and-iran-to-pursue-talks-on-managing-navigation-in-strait-of-hormuz-512823"}],"published_at":"2026-06-23T14:07:00Z","retrieved_at":"2026-11-17T13:38:59Z","official":false,"ai_summary":true,"content_hash":"d1fa5402e6c95acf","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:38:59Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-23T14:07:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-23T18:00:00Z","publisher_country_gdelt":"MU","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-tanker-ship-5957064.jpg","alt":"oil tanker ship (illustration)","credit":"angad305","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/ship-sea-horizon-sky-blue-sky-5957064/"}}