{"id":"nd57eb19dd5","headline":"Ahsan Iqbal Pushes NFC Reforms for Population Control","summary":"Pakistani Planning Minister Ahsan Iqbal called for constitutional changes to the National Finance Commission to reward provinces that slow population growth. He cited projected population of up to 389.9m by 2050.","why":"The National Finance Commission award determines how federal revenue is divided among Pakistan's provinces, so changes affect provincial budgets and public spending.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Islamabad","country":"Pakistan","lat":33.69,"lon":73.04,"region":"asia"},"entities":[],"links":[],"source":{"name":"Pakistan Today","url":"https://www.pakistantoday.com.pk/2026/05/14/ahsan-iqbal-calls-for-nfc-reforms-to-link-provincial-funding-to-population-control"},"sources":[{"name":"Pakistan Today","url":"https://www.pakistantoday.com.pk/2026/05/14/ahsan-iqbal-calls-for-nfc-reforms-to-link-provincial-funding-to-population-control"}],"published_at":"2026-05-13T19:58:48Z","retrieved_at":"2026-11-17T16:23:27Z","official":false,"ai_summary":true,"content_hash":"b98344389f3121ee","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T16:23:27Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-05-13T19:58:48Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-05-14T00:00:00Z","publisher_country_gdelt":"PK","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-7840795.jpg","alt":"parliament government building (illustration)","credit":"ykaiavu","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/bundeshaus-the-parliament-building-7840795/"}}