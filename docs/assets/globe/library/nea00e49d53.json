{"id":"nea00e49d53","headline":"Fuel shortages, price hikes drive rethink on ethanol","summary":"Fuel-saving ideas, including ethanol, are being considered to tackle Australia's fuel shortages as the Iran war disrupts global oil markets. Fuel prices have also risen.","why":"Australia imports most of its refined fuel, so global crude disruptions quickly affect local supply and prices. Biofuel policy can change fuel mixes and the outlook for agricultural producers.","category":"commodities","event_type":"energy-supply","importance":1,"flag":null,"market_moving":false,"location":{"place":"Wollongong","country":"Australia","lat":-34.42,"lon":150.89,"region":"oc"},"entities":[],"links":[],"source":{"name":"illawarramercury.com.au","url":"https://www.illawarramercury.com.au/story/9206658/fuel-crisis-plan-for-40-petrol-pump-limits-denied/"},"sources":[{"name":"illawarramercury.com.au","url":"https://www.illawarramercury.com.au/story/9206658/fuel-crisis-plan-for-40-petrol-pump-limits-denied/"}],"published_at":"2026-03-25T05:41:40Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"fde2598c32830329","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-25T05:41:40Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-25T00:00:00Z","publisher_country_gdelt":"AS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-5366666.jpg","alt":"oil refinery (illustration)","credit":"Tho-Ge","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/rhine-industry-refinery-tanks-5366666/"}}