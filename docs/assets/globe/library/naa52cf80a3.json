{"id":"naa52cf80a3","headline":"Uzbekistan to Zero Tariffs on Mobile Phone Imports for WTO Accession","summary":"Uzbekistan agreed to zero tariffs on mobile phone imports as part of its 2026 WTO accession. The move is expected to cut consumer prices by 5%, while existing value-added tax is maintained.","why":"WTO accession sets trade rules for members, and tariff cuts on electronics change import costs and competition in the consumer market.","category":"geopolitics","event_type":"trade","importance":2,"flag":null,"market_moving":false,"location":{"place":"Tashkent","country":"Uzbekistan","lat":41.3,"lon":69.24,"region":"asia"},"entities":[],"links":[],"source":{"name":"PravdaReport","url":"https://english.pravda.ru/news/world/172487-uzbekistan-wto-zero-tariffs-mobile-phones/"},"sources":[{"name":"PravdaReport","url":"https://english.pravda.ru/news/world/172487-uzbekistan-wto-zero-tariffs-mobile-phones/"}],"published_at":"2026-11-12T01:57:00Z","retrieved_at":"2026-11-12T13:59:53Z","official":false,"ai_summary":true,"content_hash":"2ddc579cfda1b540","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T13:59:53Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-11-12T01:57:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-11-12T03:00:00Z","publisher_country_gdelt":"UZ","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/smartphone-763731.jpg","alt":"smartphone (illustration)","credit":"Firmbee","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/social-media-facebook-smartphone-763731/"}}