{"id":"n97ee350931","headline":"Inflation, on the decrease","summary":"Inflation in Romania fell in August from 8.16% to 6.17%, a substantial reduction after a fall of more than two percentage points the previous month. Specialists attribute much of the drop to last year's VAT increase leaving the comparison base.","why":"Inflation trends guide the central bank's interest-rate decisions, which affect Romanian government bond yields and the leu.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Bucharest","country":"Romania","lat":44.43,"lon":26.1,"region":"eu"},"entities":[],"links":[],"source":{"name":"Radio Romania International","url":"https://www.rri.ro/en/news-and-current-affairs/today-in-the-news/inflation-on-the-decrease-id1059097.html"},"sources":[{"name":"Radio Romania International","url":"https://www.rri.ro/en/news-and-current-affairs/today-in-the-news/inflation-on-the-decrease-id1059097.html"}],"published_at":"2026-09-14T11:00:24Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"5360200efcf5bca7","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-14T11:00:24Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-15T00:00:00Z","publisher_country_gdelt":"RO","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-8033100.jpg","alt":"banknotes money (illustration)","credit":"vjkombajn","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/money-cash-czech-crowns-banknotes-8033100/"}}