{"id":"ndaa98ad42c","headline":"Gold eases on inflation woes, rate hike fears","summary":"Gold prices dropped in early Asian trading on Monday, driven by Middle East tensions and persistent inflation worries that sparked expectations of interest rate hikes. Indian buyers held back, waiting for better prices.","why":"Gold is a traditional store of value that typically weakens when interest rates and bond yields rise, since it pays no income. It is also a major source of demand in India.","category":"commodities","event_type":"commodity-prices","importance":2,"flag":null,"market_moving":false,"location":{"place":"London","country":"United Kingdom","lat":51.507,"lon":-0.128,"region":"eu"},"entities":[],"links":[],"source":{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/markets/commodities/news/gold-eases-on-inflation-woes-rate-hike-fears/articleshow/134377983.cms"},"sources":[{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/markets/commodities/news/gold-eases-on-inflation-woes-rate-hike-fears/articleshow/134377983.cms"}],"published_at":"2026-09-21T02:00:00Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"a449c61065c64db4","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-21T02:00:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-21T03:00:00Z","publisher_country_gdelt":"SA","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/gold-bars-1735659.jpg","alt":"gold bars (illustration)","credit":"Alexas_Fotos","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/chocolate-bar-sweetness-chocolate-1735659/"}}