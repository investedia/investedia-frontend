{"id":"nb82df912a2","headline":"India’s bid to keep carbon cash home as Europe adds a new trade cost","summary":"Indian exporters face new carbon costs under the EU's CBAM, which took effect in January 2026. Steel and aluminium exporters could face pressure on competitiveness.","why":"The EU Carbon Border Adjustment Mechanism charges imports for embedded emissions, affecting exporters of carbon-intensive goods like steel and aluminium. Domestic carbon markets are one policy response.","category":"economy","event_type":"trade","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/news/economy/foreign-trade/india-exports-carbon-market-ccts-cbam-europe-new-border-tax/articleshow/134531752.cms"},"sources":[{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/news/economy/foreign-trade/india-exports-carbon-market-ccts-cbam-europe-new-border-tax/articleshow/134531752.cms"}],"published_at":"2026-09-28T05:26:00Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"ca86ad528c2e19b2","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-28T05:26:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-28T06:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/steel-factory-3645379.jpg","alt":"steel factory (illustration)","credit":"Tama66","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/fan-cooling-propeller-power-plant-3645379/"}}