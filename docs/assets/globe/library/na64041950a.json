{"id":"na64041950a","headline":"Venice raises more than $A8m from tourist charge","summary":"More than 650,000 tourists paid the day-trip fee to visit Venice from April, raising more than A$8 million. The charge is levied on visitors arriving as day trippers.","why":"Venice's day-trip access fee is a municipal levy on tourism, a major local income source for the city. Such charges are watched by investors in tourism and hospitality as a signal of visitor-management policy.","category":"economy","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Venice","country":"Italy","lat":45.441,"lon":12.316,"region":"eu"},"entities":[],"links":[],"source":{"name":"dailyliberal.com.au","url":"https://www.dailyliberal.com.au/story/9318379/venice-raises-more-than-a8m-from-tourist-charge/"},"sources":[{"name":"dailyliberal.com.au","url":"https://www.dailyliberal.com.au/story/9318379/venice-raises-more-than-a8m-from-tourist-charge/"}],"published_at":"2026-07-27T04:19:33Z","retrieved_at":"2026-11-17T12:21:21Z","official":false,"ai_summary":true,"content_hash":"d62f3c281cdfb5a7","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T12:21:21Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-07-27T04:19:33Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-07-27T06:00:00Z","publisher_country_gdelt":"IT","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/hotel-tourism-1620961.jpg","alt":"hotel tourism (illustration)","credit":"12019","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/las-vegas-nevada-cities-urban-1620961/"}}