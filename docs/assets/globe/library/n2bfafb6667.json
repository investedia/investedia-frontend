{"id":"n2bfafb6667","headline":"India’s PMI slips to 52.8 as factory growth loses steam, hits five-year low","summary":"India's manufacturing PMI fell to 52.8 in August as slower output and new orders dragged factory activity to its weakest level in five years. Employment fell for the first time in two-and-a-half years.","why":"The PMI is a monthly survey of purchasing managers that gauges manufacturing health, and it is closely followed by investors tracking India's growth outlook.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.614,"lon":77.209,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Times of India","url":"https://timesofindia.indiatimes.com/business/india-business/indias-pmi-slips-to-52-8-as-factory-growth-loses-steam-hits-five-year-low/articleshow/133678881.cms"},"sources":[{"name":"The Times of India","url":"https://timesofindia.indiatimes.com/business/india-business/indias-pmi-slips-to-52-8-as-factory-growth-loses-steam-hits-five-year-low/articleshow/133678881.cms"}],"published_at":"2026-09-01T11:10:00Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"21c6cb771c9cdcc4","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-01T11:10:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-01T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/factory-workers-6322043.jpg","alt":"factory workers (illustration)","credit":"Quanlecntt2004","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/worker-man-mask-face-mask-6322043/"}}