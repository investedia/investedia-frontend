{"id":"nad96b3a895","headline":"Bulgaria’s central bank: 87% of leva cash out of circulation","summary":"As of February 27, 87% of leva banknotes and coins in circulation at the start of 2025 had been withdrawn, the Bulgarian National Bank said. Bulgaria is adopting the euro.","why":"Bulgaria is replacing the lev with the euro, and the withdrawal of old currency is a step in that changeover that affects cash handling and monetary arrangements.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Sofia","country":"Bulgaria","lat":42.7,"lon":23.32,"region":"eu"},"entities":[],"links":[],"source":{"name":"The Sofia Globe","url":"https://sofiaglobe.com/2026/02/28/bulgarias-central-bank-87-of-leva-cash-out-of-circulation/"},"sources":[{"name":"The Sofia Globe","url":"https://sofiaglobe.com/2026/02/28/bulgarias-central-bank-87-of-leva-cash-out-of-circulation/"}],"published_at":"2026-02-28T10:43:18Z","retrieved_at":"2026-11-17T19:26:54Z","official":false,"ai_summary":true,"content_hash":"fe74b9f8dba333ee","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T19:26:54Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-28T10:43:18Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-28T12:00:00Z","publisher_country_gdelt":"BU","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-1005464.jpg","alt":"banknotes money (illustration)","credit":"moerschy","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/money-banknotes-euro-hand-banknote-1005464/"}}