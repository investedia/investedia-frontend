{"id":"nfeeddd0db0","headline":"From 2 crore to 24,162 crore: UPI transactions records massive growth in decade","summary":"UPI annual transaction volumes have risen nearly 12,000-fold from 2 crore over the past decade. Transaction value over the same period reached 24,162 crore, according to the report.","why":"UPI is India's government-backed real-time payments system run by NPCI, and its growth reflects the shift toward digital payments in the economy.","category":"economy","event_type":"other","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.614,"lon":77.209,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Sentinel - of this Land, for its People","url":"https://www.sentinelassam.com/topheadlines/from-2-crore-to-24162-crore-upi-transactions-records-massive-growth-in-decade"},"sources":[{"name":"The Sentinel - of this Land, for its People","url":"https://www.sentinelassam.com/topheadlines/from-2-crore-to-24162-crore-upi-transactions-records-massive-growth-in-decade"}],"published_at":"2026-08-25T02:20:39Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"233b058ad50af916","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-25T02:20:39Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-25T03:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/smartphone-5431597.jpg","alt":"smartphone (illustration)","credit":"claudid","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/mobile-phone-video-smartphone-pair-5431597/"}}