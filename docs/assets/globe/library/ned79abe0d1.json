{"id":"ned79abe0d1","headline":"Alcoa To Modernize Australia Mining Approvals; Take $19 Mln Q4 Charge","summary":"Alcoa's Australian unit has agreed with the Australian Federal Government to modernise the approvals framework for its Western Australian mining operations. The company will take a $19 million fourth-quarter charge.","why":"Alcoa is a major global producer of bauxite, alumina and aluminium, and its Western Australian operations are a key part of that supply chain. Approval timelines affect its costs and output.","category":"companies","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Perth","country":"Australia","lat":-31.95,"lon":115.86,"region":"oc"},"entities":[{"name":"Alcoa","ticker":"AA","kind":"company","asset":{"id":"EQ:XNYS:AA","n":"Alcoa","c":"equity","px":"AA","la":40.441,"lo":-79.996,"geo":"sec-hq","co":"CO:CIK0001675149","m":"ticker+name","rv":"registry-v1"}}],"links":[],"source":{"name":"RTTNews","url":"https://www.rttnews.com/3622426/alcoa-to-modernize-australia-mining-approvals-take-19-mln-q4-charge.aspx"},"sources":[{"name":"RTTNews","url":"https://www.rttnews.com/3622426/alcoa-to-modernize-australia-mining-approvals-take-19-mln-q4-charge.aspx"}],"published_at":"2026-02-18T05:38:49Z","retrieved_at":"2026-11-17T19:26:54Z","official":false,"ai_summary":true,"content_hash":"5cfe79d801236937","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T19:26:54Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-18T05:38:49Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-18T12:00:00Z","publisher_country_gdelt":"AS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/mining-truck-2402789.jpg","alt":"mining truck (illustration)","credit":"Westendorferbote","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","sou