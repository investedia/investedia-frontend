{"id":"nb28daeee54","headline":"Trump: Iran Talks Starting Today","summary":"President Trump announced new talks with Iran starting the same day, covering reopening the Strait of Hormuz and nuclear issues. He paused planned airstrikes and oil prices fell on hopes for a resolution.","why":"The Strait of Hormuz carries a large share of global seaborne oil, so disruptions there feed directly into crude prices and energy markets.","category":"geopolitics","event_type":"geopolitics","importance":3,"flag":null,"market_moving":true,"location":{"place":"Washington, D.C.","country":"United States of America","lat":38.907,"lon":-77.037,"region":"na"},"entities":[],"links":[],"source":{"name":"News Radio 1450 WILM","url":"https://wilm.iheart.com/content/2026-08-03-trump-iran-talks-starting-today/"},"sources":[{"name":"News Radio 1450 WILM","url":"https://wilm.iheart.com/content/2026-08-03-trump-iran-talks-starting-today/"}],"published_at":"2026-08-03T07:22:00Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"e2abaedb2052d959","impacts":[],"why_moved":"Oil prices fell on hopes for a resolution after the announced talks and paused strikes.","backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-03T07:22:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-03T09:00:00Z","publisher_country_gdelt":"IR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-tanker-ship-2251248.jpg","alt":"oil tanker ship (illustration)","credit":"michaelmep","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/refinery-oil-refinery-oil-industry-2251248/"}}