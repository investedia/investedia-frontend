{"id":"nbef0511868","headline":"Knesset lifts double social security burden for US immigrants","summary":"A new Israeli law grants American immigrants a five-year exemption from National Insurance payments on income already taxed by US Social Security. The change addresses a financial hurdle to aliyah.","why":"National Insurance and US Social Security are payroll-based systems, so double contributions raise costs for people moving between the two countries. Changes affect the economics of immigration and labour supply.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Jerusalem","country":"Israel","lat":31.77,"lon":35.21,"region":"me"},"entities":[],"links":[],"source":{"name":"ynetglobal","url":"https://www.ynetnews.com/article/hjfic4rdzl"},"sources":[{"name":"ynetglobal","url":"https://www.ynetnews.com/article/hjfic4rdzl"}],"published_at":"2026-02-26T21:39:31Z","retrieved_at":"2026-11-17T19:26:54Z","official":false,"ai_summary":true,"content_hash":"525101c387258e7c","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T19:26:54Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-26T21:39:31Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-27T00:00:00Z","publisher_country_gdelt":"IS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-2711816.jpg","alt":"parliament government building (illustration)","credit":"ArvidO","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/bucharest-romania-square-building-2711816/"}}