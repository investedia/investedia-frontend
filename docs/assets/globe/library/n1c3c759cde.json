{"id":"n1c3c759cde","headline":"NRIs pull out $2 billion from bank deposits","summary":"Overseas Indians withdrew nearly $2 billion from Indian bank accounts in March during the Iran war, according to Reserve Bank of India data. Experts expect geopolitical uncertainty to weigh further on NRI deposits.","why":"Non-resident Indian deposits are a source of foreign-currency inflows that support India's external balance and the rupee. Sustained outflows can add pressure on the currency.","category":"economy","event_type":"capital","importance":2,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.08,"lon":72.88,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/nri/invest/nris-pull-out-2-billion-from-bank-deposits/articleshow/131272050.cms"},"sources":[{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/nri/invest/nris-pull-out-2-billion-from-bank-deposits/articleshow/131272050.cms"}],"published_at":"2026-05-23T04:33:12Z","retrieved_at":"2026-11-17T15:49:20Z","official":false,"ai_summary":true,"content_hash":"9cec9af9f278ecb2","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:49:20Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-05-23T04:33:12Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-05-23T06:00:00Z","publisher_country_gdelt":"AE","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-209104.jpg","alt":"banknotes money (illustration)","credit":"martaposemuckel","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/banknotes-euro-paper-money-cash-209104/"}}