{"id":"n6fc93f2b9f","headline":"Kenyan and Ugandan currencies under strain","summary":"Traders expect the Kenyan shilling to lose ground in the coming week after a long period of stability. Ghana's cedi could extend gains, while Zambia's and Nigeria's currencies may be little changed.","why":"The Kenyan shilling is a key African currency for trade and dollar-denominated debt, so moves in it affect importers, borrowers and regional investors.","category":"markets","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Nairobi","country":"Kenya","lat":-1.29,"lon":36.82,"region":"af"},"entities":[],"links":[],"source":{"name":"CNBC Africa","url":"https://www.cnbcafrica.com/2026/kenyan-and-ugandan-currencies-under-strain"},"sources":[{"name":"CNBC Africa","url":"https://www.cnbcafrica.com/2026/kenyan-and-ugandan-currencies-under-strain"}],"published_at":"2026-10-15T15:35:36Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"76dcbe9e0c0ece7a","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-10-15T15:35:36Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-10-15T18:00:00Z","publisher_country_gdelt":"KE","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-4418922.jpg","alt":"banknotes money (illustration)","credit":"moritz320","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/money-banknotes-euro-finance-4418922/"}}