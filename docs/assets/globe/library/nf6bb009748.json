{"id":"nf6bb009748","headline":"Japan says US tariff pressure on car sector easing","summary":"Japan's Cabinet Office said in its February economic report that the impact of US tariffs on Japanese automakers is easing. The report cites improved exports to the US and a better auto production outlook.","why":"Japan's auto sector is a major export industry, and US tariffs on vehicles directly affect its margins and shipments. Official economic reports shape views on the broader Japanese economy.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Tokyo","country":"Japan","lat":35.68,"lon":139.69,"region":"asia"},"entities":[],"links":[],"source":{"name":"ETAuto.com","url":"https://auto.economictimes.indiatimes.com/news/industry/japan-says-us-tariff-pressure-on-car-sector-easing/128808670"},"sources":[{"name":"ETAuto.com","url":"https://auto.economictimes.indiatimes.com/news/industry/japan-says-us-tariff-pressure-on-car-sector-easing/128808670"}],"published_at":"2026-02-26T09:16:36Z","retrieved_at":"2026-11-17T19:26:54Z","official":false,"ai_summary":true,"content_hash":"a47c38d1e08c6943","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T19:26:54Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-26T09:16:36Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-26T12:00:00Z","publisher_country_gdelt":"JA","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/car-factory-1354678.jpg","alt":"car factory (illustration)","credit":"652234","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/factory-ruin-old-factory-abandoned-1354678/"}}