{"id":"n2cf110c0f0","headline":"Govt reintroduces windfall tax on diesel, ATF","summary":"Finance Minister Nirmala Sitharaman said the levy on ATF exports was raised so fuel is prioritised for domestic use. The windfall tax on diesel has been reintroduced.","why":"Windfall taxes on fuel exports affect refiners' margins and the availability of fuel in the domestic market. India is a major refined-product exporter, so such measures matter for global diesel and jet fuel flows.","category":"commodities","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"BusinessLine","url":"https://www.thehindubusinessline.com/markets/commodities/govt-reintroduces-windfall-tax-on-atf-diesel/article70791893.ece"},"sources":[{"name":"BusinessLine","url":"https://www.thehindubusinessline.com/markets/commodities/govt-reintroduces-windfall-tax-on-atf-diesel/article70791893.ece"}],"published_at":"2026-03-27T09:28:05Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"332845917d80e988","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-27T09:28:05Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-27T12:00:00Z","publisher_country_gdelt":"IR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-5385905.jpg","alt":"oil refinery (illustration)","credit":"Tho-Ge","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/rhine-industry-factory-ship-5385905/"}}