{"id":"nf4bcf102d3","headline":"UK to back Caspian-Europe clean energy transmission project – ambassador","summary":"The United Kingdom will support an initiative to transmit clean energy from the Caspian region to the European market, under cooperation between Xlinks and the Green Energy Company, the ambassador said.","why":"Xlinks is a UK company developing long-distance power transmission projects, and such interconnectors can change how renewable power reaches European grids. Government backing can affect financing and project timelines.","category":"economy","importance":2,"flag":null,"market_moving":false,"location":{"place":"Baku","country":"Azerbaijan","lat":40.41,"lon":49.87,"region":"eu"},"entities":[{"name":"Xlinks","ticker":null,"kind":"company","unresolved":"no-ticker"}],"links":[],"source":{"name":"Trend.Az","url":"https://www.trend.az/azerbaijan/4247308.html"},"sources":[{"name":"Trend.Az","url":"https://www.trend.az/azerbaijan/4247308.html"}],"published_at":"2026-11-17T07:17:00Z","retrieved_at":"2026-11-17T08:41:28Z","official":false,"ai_summary":true,"content_hash":"1e32080f7207603a","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T08:41:28Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-11-17T07:17:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-11-17T08:00:00Z","publisher_country_gdelt":"AJ","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/wind-turbines-3579931.jpg","alt":"wind turbines (illustration)","credit":"Myriams-Fotos","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/sunrise-wind-farm-wind-park-3579931/"}}