{"id":"nd6736236fb","headline":"Trump says Doha talks on Tuesday amid Iran","summary":"Trump said Iran requested a meeting after recent military escalation over the Strait of Hormuz and that talks would take place in Doha on Tuesday. Iranian officials said no technical meetings were scheduled this week.","why":"The Strait of Hormuz is a key chokepoint for seaborne oil shipments, so tensions there directly affect global crude supply and prices. Qatar hosts major US military and diplomatic presence and is a major LNG exporter.","category":"geopolitics","event_type":"geopolitics","importance":3,"flag":null,"market_moving":false,"location":{"place":"Doha","country":"Qatar","lat":25.285,"lon":51.531,"region":"me"},"entities":[],"links":[],"source":{"name":"Rediff","url":"https://www.rediff.com/news/report/trump-says-doha-talks-on-tuesday-amid-irans-rejection/20260629.htm"},"sources":[{"name":"Rediff","url":"https://www.rediff.com/news/report/trump-says-doha-talks-on-tuesday-amid-irans-rejection/20260629.htm"}],"published_at":"2026-06-29T15:08:38Z","retrieved_at":"2026-11-17T13:38:59Z","official":false,"ai_summary":true,"content_hash":"5fc8c3b846804603","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:38:59Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-29T15:08:38Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-29T18:00:00Z","publisher_country_gdelt":"QA","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/middle-east-city-skyline-3854254.jpg","alt":"middle east city skyline (illustration)","credit":"naturfreund_pics","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/iran-silk-road-orient-mountains-3854254/"}}