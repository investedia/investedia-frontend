{"id":"ne60c334962","headline":"Zhu Rongji, who drove China's 1990s economic reforms, has died at 97","summary":"Former Chinese premier Zhu Rongji, who drove economic reforms in the 1990s, has died at 97. His reforms moved China toward a market-oriented financial system without ceding party control over the economy.","why":"Zhu led China's shift toward market-oriented finance in the 1990s, a foundation for the country's later integration into global trade and capital markets.","category":"economy","event_type":"other","importance":2,"flag":null,"market_moving":false,"location":{"place":"Beijing","country":"China","lat":39.9,"lon":116.41,"region":"asia"},"entities":[],"links":[],"source":{"name":"KAWC","url":"https://www.kawc.org/npr-news/2026-08-12/zhu-rongji-who-drove-chinas-1990s-economic-reforms-has-died-at-97"},"sources":[{"name":"KAWC","url":"https://www.kawc.org/npr-news/2026-08-12/zhu-rongji-who-drove-chinas-1990s-economic-reforms-has-died-at-97"}],"published_at":"2026-08-12T08:36:30Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"3d4103d5c89fe108","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-12T08:36:30Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-12T18:00:00Z","publisher_country_gdelt":"CH","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-5275410.jpg","alt":"parliament government building (illustration)","credit":"planet_fox","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/parliament-saarland-saarbr%C3%BCcken-5275410/"}}