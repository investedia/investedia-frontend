{"id":"n481da7fe15","headline":"Retail fuel prices in Cyprus expected to drop further in coming days","summary":"Retail fuel prices in Cyprus are expected to fall further in the coming days, after a series of reductions over the past month. Consumer Protection Service director Constantinos Karagiorgis said diesel prices have been declining.","why":"Retail fuel prices reflect global crude and refined product costs, and they feed into inflation and transport costs. Cyprus's fuel price moves track international oil markets.","category":"commodities","event_type":"commodity-prices","importance":1,"flag":null,"market_moving":false,"location":{"place":"Nicosia","country":"Cyprus","lat":35.17,"lon":33.36,"region":"eu"},"entities":[],"links":[],"source":{"name":"cyprus-mail.com","url":"https://cyprus-mail.com/2026/06/11/retail-fuel-prices-in-cyprus-expected-to-drop-further-in-coming-days"},"sources":[{"name":"cyprus-mail.com","url":"https://cyprus-mail.com/2026/06/11/retail-fuel-prices-in-cyprus-expected-to-drop-further-in-coming-days"}],"published_at":"2026-06-11T11:33:39Z","retrieved_at":"2026-11-17T15:20:22Z","official":false,"ai_summary":true,"content_hash":"da8e2094b77db6f4","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:20:22Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-11T11:33:39Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-11T12:00:00Z","publisher_country_gdelt":"IR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-9448741.jpg","alt":"oil refinery (illustration)","credit":"Tho-Ge","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/nature-industry-sunrise-trees-9448741/"}}