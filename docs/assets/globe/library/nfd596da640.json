{"id":"nfd596da640","headline":"US Treasury Sanctions Iran-Linked Individual, Hong Kong Firm","summary":"The US Treasury added an individual based in Dubai and Hong Kong-based Kameng Trading Limited to its OFAC SDN list. The move targets entities accused of evading Iran sanctions.","why":"OFAC's SDN list bars US persons from dealing with listed parties, so additions can disrupt payments and trade linked to Iran. Banks and traders screen against this list.","category":"geopolitics","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Washington","country":"United States of America","lat":38.9,"lon":-77.04,"region":"na"},"entities":[],"links":[],"source":{"name":"Pakistan Today","url":"https://www.pakistantoday.com.pk/2026/08/28/us-treasury-adds-iran-linked-individual-hong-kong-based-company-to-sanctions-list"},"sources":[{"name":"Pakistan Today","url":"https://www.pakistantoday.com.pk/2026/08/28/us-treasury-adds-iran-linked-individual-hong-kong-based-company-to-sanctions-list"}],"published_at":"2026-08-28T16:17:25Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"963b3e6e67f1adad","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-28T16:17:25Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-28T18:00:00Z","publisher_country_gdelt":"CH","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-4516476.jpg","alt":"parliament government building (illustration)","credit":"niki_emmert","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/parliament-budapest-hungary-river-4516476/"}}