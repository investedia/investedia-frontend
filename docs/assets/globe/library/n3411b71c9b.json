{"id":"n3411b71c9b","headline":"CPC Holds Fuel Prices Steady for August, Bringing Relief to Motorists and Businesses","summary":"The Ceylon Petroleum Corporation has announced that fuel prices across Sri Lanka will remain unchanged for August. The decision offers relief to motorists and businesses.","why":"The Ceylon Petroleum Corporation is Sri Lanka's state-owned fuel importer and distributor, and its monthly pricing affects inflation and transport costs. Fuel price decisions influence household and business budgets.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Colombo","country":"Sri Lanka","lat":6.927,"lon":79.861,"region":"asia"},"entities":[],"links":[],"source":{"name":"Lanka Newspapers","url":"https://www.lankanewspapers.com/2026/08/02/cpc-holds-fuel-prices-steady-for-august-bringing-relief-to-motorists-and-businesses"},"sources":[{"name":"Lanka Newspapers","url":"https://www.lankanewspapers.com/2026/08/02/cpc-holds-fuel-prices-steady-for-august-bringing-relief-to-motorists-and-businesses"}],"published_at":"2026-08-02T03:02:09Z","retrieved_at":"2026-11-12T00:21:16Z","official":false,"ai_summary":true,"content_hash":"40f4f02df19a21b6","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T00:21:16Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-02T03:02:09Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-02T06:00:00Z","publisher_country_gdelt":"CE","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-7844278.jpg","alt":"oil refinery (illustration)","credit":"Michael_Pointner","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/industry-structure-tower-work-7844278/"}}