{"id":"na293def9fd","headline":"Won Fall May Prompt Action, Korea's $1 Trillion Pension CEO Says","summary":"The won's weakness against the dollar during recent market turmoil may require action to stabilise it, the head of South Korea's largest pension fund said. Kim Sung-joo spoke in Seoul.","why":"The National Pension Service is one of the world's largest pension funds, and its currency exposure matters for Korean and global markets. Won moves affect dollar-denominated returns and capital flows.","category":"markets","event_type":"other","importance":2,"flag":null,"market_moving":false,"location":{"place":"Seoul","country":"South Korea","lat":37.566,"lon":126.978,"region":"asia"},"entities":[],"links":[],"source":{"name":"MarketScreener","url":"https://www.marketscreener.com/news/won-fall-may-prompt-action-korea-s-1-trillion-pension-ceo-says-ce7e51d9d88df227"},"sources":[{"name":"MarketScreener","url":"https://www.marketscreener.com/news/won-fall-may-prompt-action-korea-s-1-trillion-pension-ceo-says-ce7e51d9d88df227"}],"published_at":"2026-03-30T11:33:23Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"65fd4d974521c6d6","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-30T11:33:23Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-30T12:00:00Z","publisher_country_gdelt":"KS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-1027103.jpg","alt":"banknotes money (illustration)","credit":"Alexas_Fotos","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/taxes-tax-evasion-police-handcuffs-1027103/"}}