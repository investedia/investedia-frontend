{"id":"nb9093cd03d","headline":"Big change in UPI policy? Payments above  ₹2,000 may carry a fee. What we know","summary":"A bill seeks to remove the provision barring banks and payment providers from charging fees, including MDR, on notified electronic payments. Payments above ₹2,000 may carry a fee.","why":"UPI is India's dominant real-time payments network, and fee rules directly affect payment processors and banks.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.08,"lon":72.88,"region":"asia"},"entities":[],"links":[],"source":{"name":"Hindustan Times","url":"https://www.hindustantimes.com/india-news/big-change-in-upi-policy-payments-above-2-000-may-be-carry-a-fee-what-we-know-101785902795400.html"},"sources":[{"name":"Hindustan Times","url":"https://www.hindustantimes.com/india-news/big-change-in-upi-policy-payments-above-2-000-may-be-carry-a-fee-what-we-know-101785902795400.html"}],"published_at":"2026-08-05T05:37:47Z","retrieved_at":"2026-11-12T00:21:16Z","official":false,"ai_summary":true,"content_hash":"8adee3e5a95ce39d","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T00:21:16Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-05T05:37:47Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-05T06:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/smartphone-586268.jpg","alt":"smartphone (illustration)","credit":"niekverlaan","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/telephone-mobile-call-samsung-586268/"}}