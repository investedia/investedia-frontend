{"id":"n58f74f1413","headline":"China Retaliates Against UFLPA Entity List Additions, Restricts Trade With 6 Textile-related Firms","summary":"China has told Chinese businesses not to conduct business or cooperate with six textile and apparel companies and nonprofits. The move responds to additions to the UFLPA Entity List.","why":"The UFLPA Entity List restricts imports into the US of goods linked to forced labor in Xinjiang, so new listings affect apparel supply chains and US-China trade relations.","category":"geopolitics","event_type":"trade","importance":2,"flag":null,"market_moving":false,"location":{"place":"Beijing","country":"China","lat":39.904,"lon":116.407,"region":"asia"},"entities":[],"links":[],"source":{"name":"Yahoo Finance","url":"https://finance.yahoo.com/economy/policy/articles/china-retaliates-against-uflpa-entity-175039398.html"},"sources":[{"name":"Yahoo Finance","url":"https://finance.yahoo.com/economy/policy/articles/china-retaliates-against-uflpa-entity-175039398.html"}],"published_at":"2026-08-10T17:50:39Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"110dbdd80421b1f4","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-10T17:50:39Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-12T06:00:00Z","publisher_country_gdelt":"CH","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/textile-factory-5963960.jpg","alt":"textile factory (illustration)","credit":"19661338","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/women-crowd-protest-protesters-5963960/"}}