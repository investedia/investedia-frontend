{"id":"n40993e3f1b","headline":"Govt Assures IMF That Oil Price Increases Will Be Transferred to Consumers","summary":"Pakistan has assured the International Monetary Fund that it will pass on changes in global oil prices to consumers. It also plans targeted subsidies.","why":"The IMF oversees Pakistan's loan programme and sets conditions on fiscal and energy policy. Fuel pricing decisions affect inflation and the country's fiscal position.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Islamabad","country":"Pakistan","lat":33.69,"lon":73.06,"region":"asia"},"entities":[],"links":[],"source":{"name":"ProPakistani","url":"https://propakistani.pk/2026/04/02/govt-assures-imf-that-oil-price-increases-will-be-transferred-to-consumers/"},"sources":[{"name":"ProPakistani","url":"https://propakistani.pk/2026/04/02/govt-assures-imf-that-oil-price-increases-will-be-transferred-to-consumers/"}],"published_at":"2026-04-02T04:38:14Z","retrieved_at":"2026-11-17T17:30:28Z","official":false,"ai_summary":true,"content_hash":"579dcd8bddfef438","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T17:30:28Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-02T04:38:14Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-02T06:00:00Z","publisher_country_gdelt":"PK","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/central-bank-building-293826.jpg","alt":"central bank building (illustration)","credit":"12019","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/beach-sand-palm-trees-293826/"}}