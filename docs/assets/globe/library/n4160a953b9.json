{"id":"n4160a953b9","headline":"India’s wealth market seen growing to $436 billion by 2034; small, micro-caps in focus: Emkay Wealth","summary":"Emkay Wealth Management projects India's wealth market could grow 2.5 times to $436 billion by 2034. It expects small- and micro-caps and global diversification to gain importance.","why":"Wealth management firms manage household savings and investments, so growth in this market affects asset managers and capital markets participation.","category":"economy","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.076,"lon":72.878,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/markets/stocks/news/indias-wealth-market-seen-growing-to-436-billion-by-2034-small-micro-caps-in-focus-emkay-wealth/articleshow/134309567.cms"},"sources":[{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/markets/stocks/news/indias-wealth-market-seen-growing-to-436-billion-by-2034-small-micro-caps-in-focus-emkay-wealth/articleshow/134309567.cms"}],"published_at":"2026-09-17T10:56:00Z","retrieved_at":"2026-11-12T00:21:16Z","official":false,"ai_summary":true,"content_hash":"2772e0910c83fcd9","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T00:21:16Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-17T10:56:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-17T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/office-meeting-3196481.jpg","alt":"office meeting (illustration)","credit":"AymaneJed","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/laptop-office-hand-writing-3196481/"}}