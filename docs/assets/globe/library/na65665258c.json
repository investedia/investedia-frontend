{"id":"na65665258c","headline":"EU accuses TikTok of 'addictive design,' seeks changes to protect users","summary":"The European Commission has accused TikTok of breaching digital rules over addictive design features such as autoplay and infinite scroll. It says TikTok should change the basic design of its service, which the company denied.","why":"TikTok, owned by China's ByteDance, is a major social media platform, and EU Digital Services Act enforcement can lead to fines and mandated product changes.","category":"technology","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Brussels","country":"Belgium","lat":50.85,"lon":4.35,"region":"eu"},"entities":[],"links":[],"source":{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/tech/technology/eu-accuses-tiktok-of-addictive-design-seeks-changes-to-protect-users/articleshow/127987300.cms"},"sources":[{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/tech/technology/eu-accuses-tiktok-of-addictive-design-seeks-changes-to-protect-users/articleshow/127987300.cms"}],"published_at":"2026-02-06T11:29:48Z","retrieved_at":"2026-11-17T20:10:53Z","official":false,"ai_summary":true,"content_hash":"28c0b477d5a7c74f","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T20:10:53Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-06T11:29:48Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-06T12:00:00Z","publisher_country_gdelt":"AS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/smartphone-4602489.jpg","alt":"smartphone (illustration)","credit":"Horacio30","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/cellular-phone-camera-4602489/"}}