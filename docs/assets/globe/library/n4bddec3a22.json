{"id":"n4bddec3a22","headline":"Russia bans export of over 1 million rubles in cash to Azerbaijan","summary":"Individuals in Russia are prohibited from taking more than 1 million rubles in cash out of the country to EAEU member states, as well as to Azerbaijan, Tajikistan and Uzbekistan, RIA Novosti reports.","why":"Cash controls affect capital flows and currency movements, and the ruble is Russia's currency, widely traded in emerging-market FX.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Moscow","country":"Russia","lat":55.756,"lon":37.617,"region":"eu"},"entities":[],"links":[],"source":{"name":"Apa.az","url":"https://en.apa.az/finance/russia-bans-export-of-over-1-million-rubles-in-cash-to-azerbaijan-527044"},"sources":[{"name":"Apa.az","url":"https://en.apa.az/finance/russia-bans-export-of-over-1-million-rubles-in-cash-to-azerbaijan-527044"}],"published_at":"2026-09-29T10:27:00Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"120083822c51a1c6","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-29T10:27:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-29T12:00:00Z","publisher_country_gdelt":"TI","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-499481.jpg","alt":"banknotes money (illustration)","credit":"geralt","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/dollars-currency-money-us-dollars-499481/"}}