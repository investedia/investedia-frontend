{"id":"nab24ef64c3","headline":"Pag-IBIG housing loans surge to P69.2 billion","summary":"Housing loan releases by the Pag-IBIG Fund climbed 15% to P69.19 billion in the first half from P60.25 billion a year earlier. The growth was driven by socialized housing under the Expanded 4PH program.","why":"The Pag-IBIG Fund is the Philippines' state-run mutual savings and housing finance fund, so its lending volumes indicate the health of residential credit and construction demand.","category":"economy","event_type":"macro-data","importance":1,"flag":null,"market_moving":false,"location":{"place":"Manila","country":"Philippines","lat":14.6,"lon":120.984,"region":"asia"},"entities":[],"links":[],"source":{"name":"Philstar.com","url":"https://www.philstar.com/business/2026/07/24/2544189/pag-ibig-housing-loans-surge-p692-billion"},"sources":[{"name":"Philstar.com","url":"https://www.philstar.com/business/2026/07/24/2544189/pag-ibig-housing-loans-surge-p692-billion"}],"published_at":"2026-07-23T16:00:00Z","retrieved_at":"2026-11-17T12:21:21Z","official":false,"ai_summary":true,"content_hash":"a9b1ab7d198375c1","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T12:21:21Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-07-23T16:00:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-07-23T18:00:00Z","publisher_country_gdelt":"RP","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/housing-construction-4521094.jpg","alt":"housing construction (illustration)","credit":"skorchanov","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/construction-building-house-4521094/"}}