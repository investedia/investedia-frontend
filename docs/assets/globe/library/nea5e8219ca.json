{"id":"nea5e8219ca","headline":"Sri Lanka hikes fuel prices by up to 25 pc amid Middle East crisis; 2nd increase in 2 weeks","summary":"Sri Lanka sharply increased fuel prices by up to 25 per cent on Sunday, its second hike in two weeks. The move comes as the island braces for the wider impact of the Middle East conflict on energy markets.","why":"Sri Lanka imports nearly all its fuel, so global oil price spikes pass quickly to domestic pump prices. Fuel costs feed into inflation and the government's fiscal position.","category":"commodities","event_type":"commodity-prices","importance":1,"flag":null,"market_moving":false,"location":{"place":"Colombo","country":"Sri Lanka","lat":6.93,"lon":79.85,"region":"asia"},"entities":[],"links":[],"source":{"name":"IANS News","url":"https://ianslive.in/sri-lanka-hikes-fuel-prices-by-up-to-25-pc-amid-middle-east-crisis-2nd-increase-in-2-weeks--20260322160434"},"sources":[{"name":"IANS News","url":"https://ianslive.in/sri-lanka-hikes-fuel-prices-by-up-to-25-pc-amid-middle-east-crisis-2nd-increase-in-2-weeks--20260322160434"}],"published_at":"2026-03-22T10:36:39Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"46ab22b2d01371b2","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-22T10:36:39Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-22T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/gas-pipeline-2784902.jpg","alt":"gas pipeline (illustration)","credit":"jarmoluk","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/fittings-water-polo-construction-2784902/"}}