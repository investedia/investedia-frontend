{"id":"nf23ccdbf22","headline":"UK sanctions Jewish settlements","summary":"The UK, France and Canada will ban goods produced in West Bank settlements and Jewish neighbourhoods of East Jerusalem, Foreign Secretary Ed Miliband told Parliament. The UK deems these communities illegal.","why":"Trade bans on goods from Israeli settlements affect exporters, importers and supply chains. Such measures can shape diplomatic and trade relations between Israel and Western states.","category":"geopolitics","event_type":"trade","importance":2,"flag":null,"market_moving":false,"location":{"place":"London","country":"United Kingdom","lat":51.5,"lon":-0.12,"region":"eu"},"entities":[],"links":[],"source":{"name":"IJN | Intermountain Jewish News","url":"https://www.ijn.com/uk-sanctions-jewish-settlements/"},"sources":[{"name":"IJN | Intermountain Jewish News","url":"https://www.ijn.com/uk-sanctions-jewish-settlements/"}],"published_at":"2026-09-10T13:41:26Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"1265d19c6126c61d","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-10T13:41:26Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-10T18:00:00Z","publisher_country_gdelt":"IS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-6941977.jpg","alt":"parliament government building (illustration)","credit":"Leonhard_Niederwimmer","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/budapest-hungary-6941977/"}}