{"id":"n31339d9b9c","headline":"Singapore's economy grew 5.4% in Q3 2026, down from 6.2% in Q2","summary":"Advance estimates from MTI show Singapore's economy grew 5.4% in Q3 2026, down from 6.2% in Q2. Manufacturing growth slowed to 7.5%, while construction expanded faster at 8.8%.","why":"Singapore is a major Asian trade and financial hub, so its GDP growth is watched as a gauge of regional demand and manufacturing activity.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Singapore","country":"Singapore","lat":1.352,"lon":103.82,"region":"asia"},"entities":[],"links":[],"source":{"name":"Human Resources Online","url":"https://www.humanresourcesonline.net/singapore-s-economy-grew-5-4-in-q3-2026-down-from-6-2-in-q2"},"sources":[{"name":"Human Resources Online","url":"https://www.humanresourcesonline.net/singapore-s-economy-grew-5-4-in-q3-2026-down-from-6-2-in-q2"}],"published_at":"2026-10-15T01:04:37Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"300d6bf6068f3c5f","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-10-15T01:04:37Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-10-15T03:00:00Z","publisher_country_gdelt":"SN","description_from":"publisher page metadata"}}