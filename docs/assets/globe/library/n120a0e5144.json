{"id":"n120a0e5144","headline":"NSTC proposes record technology budget for 2027 - Taipei Times","summary":"Taiwan's National Science and Technology Council proposed a record technology budget of NT$176.8 billion for next year. That is a 6.2% rise from this year, aimed at AI and cutting-edge technologies.","why":"Government technology spending shapes public funding for AI and semiconductor research in Taiwan, a key hub of the global chip industry.","category":"economy","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Taipei","country":"Taiwan","lat":25.03,"lon":121.56,"region":"eu"},"entities":[],"links":[],"source":{"name":"taipeitimes.com","url":"https://www.taipeitimes.com/News/biz/archives/2026/07/16/2003860795"},"sources":[{"name":"taipeitimes.com","url":"https://www.taipeitimes.com/News/biz/archives/2026/07/16/2003860795"}],"published_at":"2026-07-15T16:00:00Z","retrieved_at":"2026-11-17T13:01:10Z","official":false,"ai_summary":true,"content_hash":"2baced4aeee712d1","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:01:10Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-07-15T16:00:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-07-15T18:00:00Z","publisher_country_gdelt":"TW","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-4516476.jpg","alt":"parliament government building (illustration)","credit":"niki_emmert","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/parliament-budapest-hungary-river-4516476/"}}