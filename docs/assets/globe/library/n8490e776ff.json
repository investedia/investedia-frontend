{"id":"n8490e776ff","headline":"Iran highlights role of North-South Corridor in boosting multilateral trade","summary":"The commissioning of the Rasht-Astara railway line in northern Iran, part of the North-South transport corridor, is expected to create trade opportunities. The corridor links Russia, Iran and India.","why":"The North-South International Transport Corridor is a multimodal freight route linking India, Iran, Russia and Europe. Rail links along it affect freight costs and regional trade flows.","category":"economy","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Rasht","country":"Iran","lat":37.28,"lon":49.58,"region":"me"},"entities":[],"links":[],"source":{"name":"Trend.Az","url":"https://www.trend.az/business/4153985.html"},"sources":[{"name":"Trend.Az","url":"https://www.trend.az/business/4153985.html"}],"published_at":"2026-02-16T11:24:00Z","retrieved_at":"2026-11-17T19:26:54Z","official":false,"ai_summary":true,"content_hash":"4f3c7aa602a01fe2","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T19:26:54Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-16T11:24:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-16T12:00:00Z","publisher_country_gdelt":"IR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/railway-construction-1212472.jpg","alt":"railway construction (illustration)","credit":"Tama66","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/excavator-construction-machine-1212472/"}}