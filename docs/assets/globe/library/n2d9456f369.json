{"id":"n2d9456f369","headline":"Govt cuts windfall gains on petrol to zero; diesel, ATF duties also reduced","summary":"India lowered the special additional excise duty on diesel exports to ₹24 per litre from ₹25.5 and on ATF exports to ₹19.5 from ₹22. Petrol windfall gains duty was set to zero.","why":"Windfall levies are taxes on refiners' export margins. Changes to them affect refiners' profitability and fuel export flows.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"Hindustan Times","url":"https://www.hindustantimes.com/india-news/govt-cuts-windfall-gains-on-petrol-to-zero-diesel-atf-duties-also-reduced-101786776566552.html"},"sources":[{"name":"Hindustan Times","url":"https://www.hindustantimes.com/india-news/govt-cuts-windfall-gains-on-petrol-to-zero-diesel-atf-duties-also-reduced-101786776566552.html"}],"published_at":"2026-08-15T08:01:11Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"5ca704ebcf4607e5","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-15T08:01:11Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-15T09:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-5292067.jpg","alt":"oil refinery (illustration)","credit":"661512","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/industry-the-oil-industry-processing-5292067/"}}