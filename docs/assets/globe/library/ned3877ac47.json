{"id":"ned3877ac47","headline":"Taiwan Plans Crypto Travel Rule Rollout in October","summary":"Taiwan plans to apply the FATF Travel Rule to all domestic VASP transfers from October. Enhanced checks will apply to transfers above 30,000 New Taiwan dollars.","why":"The FATF Travel Rule requires crypto platforms to share sender and recipient information on transfers, aiming to curb money laundering. Such rules shape compliance costs and operating conditions for exchanges.","category":"crypto","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Taipei","country":"Taiwan","lat":25.033,"lon":121.565,"region":"eu"},"entities":[],"links":[],"source":{"name":"Cointelegraph","url":"https://cointelegraph.com/news/taiwan-crypto-travel-rule-domestic-vasp-transfers"},"sources":[{"name":"Cointelegraph","url":"https://cointelegraph.com/news/taiwan-crypto-travel-rule-domestic-vasp-transfers"}],"published_at":"2026-08-05T08:21:54Z","retrieved_at":"2026-11-12T00:21:16Z","official":false,"ai_summary":true,"content_hash":"9b59626a2a5f66f2","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T00:21:16Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-05T08:21:54Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-05T12:00:00Z","publisher_country_gdelt":"TW","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/bitcoin-cryptocurrency-3137984.jpg","alt":"bitcoin cryptocurrency (illustration)","credit":"Leamsii","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/bitcoin-money-virtual-market-3137984/"}}