{"id":"nd076e777a5","headline":"Iraq Central Bank Devalues Dinar after Mideast War Hurts Oil Exports","summary":"Iraq's central bank devalued the dinar against the dollar on Wednesday. Crude sales make up nearly 90% of Iraq's revenue, and exports have been hurt by the Iran-US conflict and the Strait of Hormuz disruption.","why":"Iraq depends heavily on oil for government revenue, so export disruptions can quickly strain its currency, budget and dollar liquidity.","category":"economy","event_type":"rates","importance":3,"flag":null,"market_moving":false,"location":{"place":"Baghdad","country":"Iraq","lat":33.315,"lon":44.366,"region":"me"},"entities":[],"links":[],"source":{"name":"aawsat.com","url":"https://english.aawsat.com/business/5326937-iraq-central-bank-devalues-dinar-after-mideast-war-hurts-oil-exports"},"sources":[{"name":"aawsat.com","url":"https://english.aawsat.com/business/5326937-iraq-central-bank-devalues-dinar-after-mideast-war-hurts-oil-exports"}],"published_at":"2026-10-07T10:05:50Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"4cc92922bdb6a23e","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-10-07T10:05:50Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-10-07T12:00:00Z","publisher_country_gdelt":"IZ","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-8033100.jpg","alt":"banknotes money (illustration)","credit":"vjkombajn","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/money-cash-czech-crowns-banknotes-8033100/"}}