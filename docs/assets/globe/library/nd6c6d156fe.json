{"id":"nd6c6d156fe","headline":"Gov’t to weigh movement restrictions as fuel costs surge – Vaz","summary":"Jamaica's government is exploring fuel conservation options, including COVID-style movement restrictions, amid rising global prices. No decision has been made, and Petrojam has absorbed losses of J$11.8 billion over four years.","why":"Petrojam is Jamaica's state-owned oil refiner and marketer. Global fuel price swings affect its finances and the cost of fuel across the island's economy.","category":"economy","event_type":"energy-supply","importance":1,"flag":null,"market_moving":false,"location":{"place":"Kingston","country":"Jamaica","lat":17.971,"lon":-76.794,"region":"latam"},"entities":[],"links":[],"source":{"name":"jamaica-gleaner.com","url":"https://jamaica-gleaner.com/article/news/20260415/govt-weigh-movement-restrictions-fuel-costs-surge-vaz"},"sources":[{"name":"jamaica-gleaner.com","url":"https://jamaica-gleaner.com/article/news/20260415/govt-weigh-movement-restrictions-fuel-costs-surge-vaz"}],"published_at":"2026-04-15T17:24:07Z","retrieved_at":"2026-11-17T17:30:28Z","official":false,"ai_summary":true,"content_hash":"96659631754288d6","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T17:30:28Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-15T17:24:07Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-15T18:00:00Z","publisher_country_gdelt":"JM","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-5385905.jpg","alt":"oil refinery (illustration)","credit":"Tho-Ge","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/rhine-industry-factory-ship-5385905/"}}