{"id":"n66221d2777","headline":"From the Leu to the Euro","summary":"Romania, an EU member since 2007, has committed to adopting the euro once it meets the Maastricht convergence criteria, with no automatic deadline for replacing the leu.","why":"The Maastricht criteria test inflation, public finances, exchange-rate stability and interest rates, and a euro switch would change Romania's monetary policy and currency exposure.","category":"economy","event_type":"rates","importance":1,"flag":null,"market_moving":false,"location":{"place":"Bucharest","country":"Romania","lat":44.43,"lon":26.1,"region":"eu"},"entities":[],"links":[],"source":{"name":"Radio Romania International","url":"https://www.rri.ro/en/features-and-reports/the-future-starts-today/from-the-leu-to-the-euro-id1057599.html"},"sources":[{"name":"Radio Romania International","url":"https://www.rri.ro/en/features-and-reports/the-future-starts-today/from-the-leu-to-the-euro-id1057599.html"}],"published_at":"2026-09-11T11:00:39Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"c8084c712de2f4bc","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-11T11:00:39Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-11T12:00:00Z","publisher_country_gdelt":"RO","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-1013789.jpg","alt":"banknotes money (illustration)","credit":"stevepb","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/wallet-cash-pocket-credit-card-1013789/"}}