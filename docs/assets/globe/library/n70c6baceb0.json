{"id":"n70c6baceb0","headline":"PAYE Employees to File Tax Returns by April 30 Under New KRA Rules","summary":"Under the Finance Act 2026, PAYE employees must file tax returns by April 30. The rule ends Kenya's long-standing June 30 filing date for individuals.","why":"Kenya Revenue Authority (KRA) administers the country's tax system. Changes to filing rules affect compliance costs and tax administration for businesses and employees.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Nairobi","country":"Kenya","lat":-1.292,"lon":36.822,"region":"af"},"entities":[],"links":[],"source":{"name":"Techweez | Tech News, Reviews, Deals, Tips and How To","url":"https://techweez.com/2026/06/25/finance-act-2026-tax-returns-filing-deadlines/"},"sources":[{"name":"Techweez | Tech News, Reviews, Deals, Tips and How To","url":"https://techweez.com/2026/06/25/finance-act-2026-tax-returns-filing-deadlines/"}],"published_at":"2026-06-25T09:02:01Z","retrieved_at":"2026-11-17T13:38:59Z","official":false,"ai_summary":true,"content_hash":"e1d343fcc6aff537","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:38:59Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-25T09:02:01Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-25T12:00:00Z","publisher_country_gdelt":"KE","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/office-meeting-593378.jpg","alt":"office meeting (illustration)","credit":"StartupStockPhotos","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/entrepreneur-startup-start-up-man-593378/"}}