{"id":"n0efd3d1041","headline":"Graduate, jobs mismatch","summary":"An estimated 12,000 to 15,000 university graduates enter Malawi's labour market yearly, but less than 12 percent of registered job seekers secure formal employment. The gap between education and labour demand is widening.","why":"Weak formal job creation affects household income, consumer spending and the broader economic outlook for emerging markets.","category":"economy","event_type":"labor","importance":1,"flag":null,"market_moving":false,"location":{"place":"Lilongwe","country":"Malawi","lat":-13.96,"lon":33.77,"region":"af"},"entities":[],"links":[],"source":{"name":"Nation Online","url":"https://mwnation.com/graduate-jobs-mismatch/"},"sources":[{"name":"Nation Online","url":"https://mwnation.com/graduate-jobs-mismatch/"}],"published_at":"2026-07-04T05:06:00Z","retrieved_at":"2026-11-17T13:01:10Z","official":false,"ai_summary":true,"content_hash":"eb58c942aa0e5743","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:01:10Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-07-04T05:06:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-07-04T06:00:00Z","publisher_country_gdelt":"MI","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/office-meeting-2569234.jpg","alt":"office meeting (illustration)","credit":"StockSnap","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/people-group-friends-concept-2569234/"}}