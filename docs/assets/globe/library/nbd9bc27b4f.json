{"id":"nbd9bc27b4f","headline":"Islamabad memorandum has become declaration of US defeat, Iran legislature head says","summary":"Iranian parliament speaker Mohammad Bagher Ghalibaf said the Islamabad memorandum of understanding with the United States was not the result of pressure. He described it as a declaration of US defeat.","why":"A memorandum between Iran and the United States could shape sanctions relief and Middle East energy supply expectations. Political rhetoric around such deals can influence risk sentiment in oil markets.","category":"geopolitics","event_type":"geopolitics","importance":3,"flag":null,"market_moving":false,"location":{"place":"Islamabad","country":"Pakistan","lat":33.684,"lon":73.048,"region":"asia"},"entities":[],"links":[],"source":{"name":"NEWS.am","url":"https://news.am/en/news/1045610"},"sources":[{"name":"NEWS.am","url":"https://news.am/en/news/1045610"}],"published_at":"2026-06-24T14:28:00Z","retrieved_at":"2026-11-17T13:38:59Z","official":false,"ai_summary":true,"content_hash":"1a604d9980c66b99","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:38:59Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-24T14:28:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-24T18:00:00Z","publisher_country_gdelt":"AJ","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-7830294.jpg","alt":"parliament government building (illustration)","credit":"ykaiavu","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/federal-palace-parliament-building-7830294/"}}