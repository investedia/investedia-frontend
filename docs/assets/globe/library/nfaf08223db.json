{"id":"nfaf08223db","headline":"Kazakhstan sets wheat procurement prices for 2026","summary":"Kazakhstan's government set procurement prices for the 2026 harvest wheat at 92,000 to 115,000 tenge ($209-$262) per ton, depending on quality. The prices were announced by the deputy prime minister.","why":"Kazakhstan is one of the largest wheat exporters in Central Asia, and government procurement prices shape farm incomes and grain supply to export markets.","category":"commodities","event_type":"commodity-prices","importance":1,"flag":null,"market_moving":false,"location":{"place":"Astana","country":"Kazakhstan","lat":51.169,"lon":71.449,"region":"asia"},"entities":[],"links":[],"source":{"name":"Trend.Az","url":"https://www.trend.az/casia/kazakhstan/4229682.html"},"sources":[{"name":"Trend.Az","url":"https://www.trend.az/casia/kazakhstan/4229682.html"}],"published_at":"2026-09-30T11:29:06Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"564f4afc4b0ba7ae","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-30T11:29:06Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-30T12:00:00Z","publisher_country_gdelt":"KZ","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/wheat-field-harvest-7346741.jpg","alt":"wheat field harvest (illustration)","credit":"3centista","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/wheat-wheat-field-wheat-ears-7346741/"}}