{"id":"nd2980dc6b4","headline":"The strait and narrow: Yemen, the Red Sea and Europe’s path forward – European Council on Foreign Relations","summary":"Houthi advances now threaten Saudi Arabia's most viable oil-export route, according to a European Council on Foreign Relations analysis. The report urges Europe to strengthen Riyadh's maritime and air defences.","why":"Saudi Arabia is a leading global crude exporter, and Red Sea shipping routes carry significant oil and container traffic. Threats to these lanes can raise freight costs and crude risk premiums.","category":"geopolitics","event_type":"geopolitics","importance":2,"flag":null,"market_moving":false,"location":{"place":"Red Sea","country":"Yemen","lat":15.0,"lon":42.5,"region":"me"},"entities":[],"links":[],"source":{"name":"ECFR","url":"https://ecfr.eu/article/the-strait-and-narrow-yemen-the-red-sea-and-europes-path-forward/"},"sources":[{"name":"ECFR","url":"https://ecfr.eu/article/the-strait-and-narrow-yemen-the-red-sea-and-europes-path-forward/"}],"published_at":"2026-09-22T15:57:42Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"434e7523db85f602","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-22T15:57:42Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-22T18:00:00Z","publisher_country_gdelt":"SA","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-tanker-ship-5904139.jpg","alt":"oil tanker ship (illustration)","credit":"Gaz_Chapp","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/ship-shipping-sea-boat-ocean-5904139/"}}