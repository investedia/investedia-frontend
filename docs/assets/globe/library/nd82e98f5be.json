{"id":"nd82e98f5be","headline":"Centre cuts windfall tax on diesel, ATF exports from October 1","summary":"The Indian government reduced the windfall tax on diesel exports to ₹16 per litre and on ATF exports to ₹10.5, effective October 1. Export duties are reviewed fortnightly based on international crude and product prices.","why":"Windfall taxes on fuel exports are levied when refiners earn outsized margins, so changes to them affect refining profitability and fuel supply decisions in India, a major refined-product exporter.","category":"commodities","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[{"name":"Brent crude","ticker":"BZ=F","kind":"company","sym":"BRENT","asset":{"id":"CM:BRENT","n":"Brent crude oil","c":"commodity","px":"BZ=F","la":57.5,"lo":1.5,"geo":"markets","site":"BRENT","m":"ticker-fixed","rv":"registry-v1"}}],"links":[],"source":{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/industry/energy/oil-gas/centre-cuts-windfall-tax-on-diesel-atf-exports-from-october-1/articleshow/134599742.cms"},"sources":[{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/industry/energy/oil-gas/centre-cuts-windfall-tax-on-diesel-atf-exports-from-october-1/articleshow/134599742.cms"}],"published_at":"2026-09-30T17:19:00Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"e22af92c0077bca2","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-30T17:19:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-30T18:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-3713276.jpg","alt":"oil refinery (illust