{"id":"n85b44b8912","headline":"Soccsksargen residents get aid to ease effects of rising fuel costs","summary":"Local governments and private firms are distributing cash grants and food-for-work assistance in parts of Region 12. The aid responds to lost income from spiralling petroleum product prices.","why":"Fuel price swings affect household incomes and transport costs across the Philippines, an economy that imports most of its oil. Local relief measures are a sign of the cost pressure on lower-income workers.","category":"economy","event_type":"energy-supply","importance":1,"flag":null,"market_moving":false,"location":{"place":"Koronadal","country":"Philippines","lat":6.5,"lon":124.85,"region":"asia"},"entities":[],"links":[],"source":{"name":"Philstar.com","url":"https://www.philstar.com/nation/2026/03/28/2517476/soccsksargen-residents-get-aid-ease-effects-rising-fuel-costs"},"sources":[{"name":"Philstar.com","url":"https://www.philstar.com/nation/2026/03/28/2517476/soccsksargen-residents-get-aid-ease-effects-rising-fuel-costs"}],"published_at":"2026-03-28T09:48:00Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"ce301d3132da3efd","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-28T09:48:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-28T12:00:00Z","publisher_country_gdelt":"RP","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-7010971.jpg","alt":"oil refinery (illustration)","credit":"yamabon","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/plant-chimney-night-view-7010971/"}}