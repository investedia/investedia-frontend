{"id":"nd28c8d3b82","headline":"Dhaval Packaging","summary":"Dhaval Packaging will launch its initial public offering on July 30 with a fresh equity issue of Rs 36.36 crore. Proceeds will fund capacity expansion at its Sanand plant, with the IPO targeting listing on the BSE SME platform on August 6.","why":"An IPO is a company's first sale of shares to public investors. SME platform listings typically involve smaller companies with limited trading liquidity.","category":"companies","event_type":"capital","importance":1,"flag":null,"market_moving":false,"location":{"place":"Sanand","country":"India","lat":22.992,"lon":72.381,"region":"asia"},"entities":[{"name":"Dhaval Packaging","ticker":null,"kind":"company","unresolved":"no-ticker"}],"links":[],"source":{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/markets/ipos/fpos/dhaval-packagings-rs-36-36-crore-ipo-to-open-on-july-30/articleshow/132785516.cms"},"sources":[{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/markets/ipos/fpos/dhaval-packagings-rs-36-36-crore-ipo-to-open-on-july-30/articleshow/132785516.cms"}],"published_at":"2026-08-01T08:33:00Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"71ea6b60d05a5690","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-01T08:33:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-01T09:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-3481699.jpg","alt":"banknotes money (illustration)","credit":"MabelAmber","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/money-bank-notes-euro-notes-euro-3481699/"}}