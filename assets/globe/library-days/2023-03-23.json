{"n5aae19afa4":{"id":"n5aae19afa4","headline":"UK investments to Malawi slow","summary":"UK foreign direct investment in Malawi fell from £66 million in 2019 to £61 million in 2020, then to £57 million in a later year, according to UK government data.","why":"Foreign direct investment is a key source of capital for low-income economies, so a sustained decline from a major partner like the UK matters for Malawi's growth outlook.","category":"economy","event_type":"macro-data","importance":1,"flag":null,"market_moving":false,"location":{"place":"Lilongwe","country":"Malawi","lat":-13.96,"lon":33.77,"region":"af"},"entities":[],"links":[],"source":{"name":"Nation Online","url":"https://mwnation.com/uk-investments-to-malawi-slow/"},"sources":[{"name":"Nation Online","url":"https://mwnation.com/uk-investments-to-malawi-slow/"}],"published_at":"2023-03-23T01:35:00Z","retrieved_at":"2026-11-21T02:31:37Z","official":false,"ai_summary":true,"content_hash":"474a7bf0a82b35f4","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-21T02:31:37Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2023-03-23T01:35:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2023-03-25T12:00:00Z","publisher_country_gdelt":"MI","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/african-market-2771096.jpg","alt":"african market (illustration)","credit":"timokefoto","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/african-clothes-jazz-festival-2771096/"}}}