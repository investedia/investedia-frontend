{"ncf82c24293":{"id":"ncf82c24293","headline":"ECOWAS: How Mali, Burkina Faso, Niger exit go affect trade and travel for West Africa","summary":"Mali, Burkina Faso and Niger signed a treaty under the Alliance of Sahelian States to leave the ECOWAS regional bloc. The move raises questions about trade and travel across West Africa.","why":"ECOWAS is a West African regional bloc that governs trade and free movement, so withdrawal can change tariffs and border rules.","category":"geopolitics","event_type":"trade","importance":2,"flag":null,"market_moving":false,"location":{"place":"Bamako","country":"Mali","lat":12.64,"lon":-8.0,"region":"af"},"entities":[],"links":[],"source":{"name":"BBC News Pidgin","url":"https://www.bbc.com/pidgin/articles/cl7yq1xwvjzo"},"sources":[{"name":"BBC News Pidgin","url":"https://www.bbc.com/pidgin/articles/cl7yq1xwvjzo"}],"published_at":"2024-07-09T11:19:09Z","retrieved_at":"2026-11-19T19:01:17Z","official":false,"ai_summary":true,"content_hash":"d1394d2554ac6cc4","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-19T19:01:17Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2024-07-09T11:19:09Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2024-07-09T12:00:00Z","publisher_country_gdelt":"NG","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/african-market-1112849.jpg","alt":"african market (illustration)","credit":"falco","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/south-africa-safari-tourism-africa-1112849/"}}}