{"n4e7e97badd":{"id":"n4e7e97badd","headline":"FATF drops UAE from financial crime watch list","summary":"The Financial Action Task Force no longer considers the UAE at risk of illicit money flows and has removed it from its watch list. The UAE had been listed under strict scrutiny since 2022.","why":"FATF grey-list status signals anti-money-laundering weaknesses and can raise financing costs and correspondent-banking friction. Removal typically improves investor perception of a country's financial system.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Abu Dhabi","country":"United Arab Emirates","lat":24.45,"lon":54.38,"region":"me"},"entities":[],"links":[],"source":{"name":"Geo News","url":"https://www.geo.tv/latest/532387-fatf-drops-uae-from-financial-crime-watch-list"},"sources":[{"name":"Geo News","url":"https://www.geo.tv/latest/532387-fatf-drops-uae-from-financial-crime-watch-list"}],"published_at":"2024-02-24T10:02:00Z","retrieved_at":"2026-11-19T19:01:17Z","official":false,"ai_summary":true,"content_hash":"9e55a429f6c32993","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-19T19:01:17Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2024-02-24T10:02:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2024-02-24T12:00:00Z","publisher_country_gdelt":"AE","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/middle-east-city-skyline-597025.jpg","alt":"middle east city skyline (illustration)","credit":"696188","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/jerusalem-worship-history-holiday-597025/"}}}