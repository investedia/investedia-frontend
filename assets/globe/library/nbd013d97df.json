{"id":"nbd013d97df","headline":"Uniqlo Operator Fast Retailing's Q3 Profit Jumps 45.7%, Raises Forecast","summary":"Fast Retailing, owner of Uniqlo, reported a 45.7% rise in quarterly profit despite supply chain and logistics pressure from the Iran war. It raised its forecast and expects a fifth straight year of record earnings.","why":"Fast Retailing is Japan's largest apparel retailer and the owner of Uniqlo. Its results and guidance are closely watched as a gauge of global consumer demand and supply chain costs.","category":"companies","event_type":"earnings","importance":2,"flag":null,"market_moving":false,"location":{"place":"Tokyo","country":"Japan","lat":35.68,"lon":139.69,"region":"asia"},"entities":[{"name":"Fast Retailing","ticker":"9983.T","kind":"company","unresolved":"unknown-ticker:9983.T"}],"links":[],"source":{"name":"aawsat.com","url":"https://english.aawsat.com/fashion/5293971-uniqlo-operator-fast-retailings-q3-profit-jumps-457-raises-forecast"},"sources":[{"name":"aawsat.com","url":"https://english.aawsat.com/fashion/5293971-uniqlo-operator-fast-retailings-q3-profit-jumps-457-raises-forecast"}],"published_at":"2026-07-09T07:13:21Z","retrieved_at":"2026-11-17T13:01:10Z","official":false,"ai_summary":true,"content_hash":"fe7515daef30dd9e","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:01:10Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-07-09T07:13:21Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-07-09T12:00:00Z","publisher_country_gdelt":"JA","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/shopping-retail-store-2615482.jpg","alt":"shopping retail store (illustration)","credit":"Alexas_Fotos","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/shopping-corona-business-vegetables-261