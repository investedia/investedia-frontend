{"id":"n28d0e18921","headline":"House OKs bill allowing Marcos to suspend or reduce fuel excise tax","summary":"The House approved a bill that would allow President Marcos to suspend or reduce the fuel excise tax. Opposition lawmakers say the measure falls short of guaranteeing real relief from high oil prices.","why":"Fuel excise taxes form part of pump prices, so changes to them directly affect consumer fuel costs and the government's tax revenue.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Manila","country":"Philippines","lat":14.6,"lon":120.984,"region":"asia"},"entities":[],"links":[],"source":{"name":"RAPPLER","url":"https://www.rappler.com/philippines/house-approves-bill-allowing-marcos-suspend-reduce-excise-tax-fuel-march-2026/"},"sources":[{"name":"RAPPLER","url":"https://www.rappler.com/philippines/house-approves-bill-allowing-marcos-suspend-reduce-excise-tax-fuel-march-2026/"}],"published_at":"2026-03-16T09:10:19Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"ef57e3b840d8776c","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-16T09:10:19Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-16T12:00:00Z","publisher_country_gdelt":"RP","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-109025.jpg","alt":"oil refinery (illustration)","credit":"jpenrose","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/refinery-oil-aerial-natural-gas-109025/"}}