{"id":"nf890a9c10f","headline":"UPI MDR Could Return On High-Value Transactions As Govt Mulls Tiered Incentives","summary":"The Indian government is considering restoring MDR on select high-value UPI transactions or introducing tiered incentives, as the current ₹2,000 crore incentive covers only part of costs.","why":"UPI is India's dominant real-time payments system run by NPCI. Merchant fees determine how banks and payment apps are compensated for processing digital payments.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.614,"lon":77.209,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/tech/upi-mdr-could-return-on-high-value-transactions-as-govt-mulls-tiered-incentives"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/tech/upi-mdr-could-return-on-high-value-transactions-as-govt-mulls-tiered-incentives"}],"published_at":"2026-08-13T07:08:13Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"64e29b09edf4d6ae","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-13T07:08:13Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-13T09:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/smartphone-1868730.jpg","alt":"smartphone (illustration)","credit":"Pexels","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/man-black-man-mobile-phone-person-1868730/"}}