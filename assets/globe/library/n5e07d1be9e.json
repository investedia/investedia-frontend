{"id":"n5e07d1be9e","headline":"Banks back sweeping regulatory reforms","summary":"Commercial banks have backed changes to Malawi's banking laws in the Banking (Amendment) Bill, 2026. Bankers Association of Malawi president Phillip Madinga said the bill gives the Reserve Bank of Malawi more options to intervene before problems at individual banks spread.","why":"Banking law changes set how regulators can act on troubled lenders, which shapes depositor protection and investor confidence in the banking sector.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Lilongwe","country":"Malawi","lat":-13.96,"lon":33.77,"region":"af"},"entities":[],"links":[],"source":{"name":"Nation Online","url":"https://mwnation.com/banks-back-sweeping-regulatory-reforms/"},"sources":[{"name":"Nation Online","url":"https://mwnation.com/banks-back-sweeping-regulatory-reforms/"}],"published_at":"2026-08-15T02:44:00Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"5a4af38fb0b6bb79","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-15T02:44:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-15T06:00:00Z","publisher_country_gdelt":"MI","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/bank-building-5396481.jpg","alt":"bank building (illustration)","credit":"FrankBender","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/frankfurt-european-central-bank-ecb-5396481/"}}