{"id":"nbd487a0a43","headline":"Weather, bond turmoil to pressure economy, OECD warns","summary":"The OECD warned that weather and bond market turmoil will pressure the Australian economy. Billions of dollars are expected to be added to the government's debt interest bill as bond yields rise.","why":"The OECD is an intergovernmental body that publishes economic outlooks for member countries. Rising government bond yields increase the cost of servicing public debt.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Canberra","country":"Australia","lat":-35.28,"lon":149.13,"region":"oc"},"entities":[],"links":[],"source":{"name":"dungogchronicle.com.au","url":"https://www.dungogchronicle.com.au/story/9356311/weather-bond-turmoil-to-pressure-economy-oecd-warns/"},"sources":[{"name":"dungogchronicle.com.au","url":"https://www.dungogchronicle.com.au/story/9356311/weather-bond-turmoil-to-pressure-economy-oecd-warns/"}],"published_at":"2026-09-23T08:08:40Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"9872c3bb6242af1e","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-23T08:08:40Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-23T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-4468573.jpg","alt":"parliament government building (illustration)","credit":"noelsch","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/architecture-germany-building-flag-4468573/"}}