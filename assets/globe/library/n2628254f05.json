{"id":"n2628254f05","headline":"Government urged to limit pork imports","summary":"The farmers group SINAG is pressing the Philippine government to cut pork imports. The aim is to support local hog raisers and boost domestic production.","why":"Pork is a major protein in the Philippines, and import policy affects domestic hog producers and food prices. Changes to import quotas can shift demand between local and foreign suppliers.","category":"economy","event_type":"trade","importance":1,"flag":null,"market_moving":false,"location":{"place":"Manila","country":"Philippines","lat":14.6,"lon":120.984,"region":"asia"},"entities":[],"links":[],"source":{"name":"Philstar.com","url":"https://www.philstar.com/business/2026/03/02/2511328/government-urged-limit-pork-imports"},"sources":[{"name":"Philstar.com","url":"https://www.philstar.com/business/2026/03/02/2511328/government-urged-limit-pork-imports"}],"published_at":"2026-03-01T16:00:00Z","retrieved_at":"2026-11-17T18:46:37Z","official":false,"ai_summary":true,"content_hash":"4a4e883ff12ea510","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:46:37Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-01T16:00:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-01T18:00:00Z","publisher_country_gdelt":"RP","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/farm-tractor-7263617.jpg","alt":"farm tractor (illustration)","credit":"matthiasboeckel","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/tractor-agriculture-farm-farming-7263617/"}}