{"id":"nb2e828d3d7","headline":"War impact looms as remittances dip 5% YoY","summary":"Pakistan's remittances dipped 5% year on year, and analysts warn that April and May inflows from Saudi Arabia and the UAE will be crucial as the Eid effect fades. The war is adding to the pressure.","why":"Remittances are a major source of foreign-exchange income for Pakistan, supporting the rupee and the current account. Gulf states are the main source of its overseas workers' earnings.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Islamabad","country":"Pakistan","lat":33.684,"lon":73.048,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Express Tribune","url":"https://tribune.com.pk/story/2601771/war-impact-looms-as-remittances-dip-5-yoy"},"sources":[{"name":"The Express Tribune","url":"https://tribune.com.pk/story/2601771/war-impact-looms-as-remittances-dip-5-yoy"}],"published_at":"2026-04-09T05:00:34Z","retrieved_at":"2026-11-17T17:30:28Z","official":false,"ai_summary":true,"content_hash":"c50be6c38bf5466e","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T17:30:28Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-09T05:00:34Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-09T06:00:00Z","publisher_country_gdelt":"PK","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-163475.jpg","alt":"banknotes money (illustration)","credit":"PublicDomainPictures","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/euro-currency-money-finance-wealth-163475/"}}