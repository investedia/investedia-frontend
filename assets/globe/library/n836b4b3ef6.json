{"id":"n836b4b3ef6","headline":"Malaysia's April trade hits record RM336.73bil on strong E&E exports","summary":"Malaysia's trade rose 28.6% year-on-year to a record RM336.73 billion in April 2026. The growth was driven mainly by strong exports of electrical and electronic products, according to MITI.","why":"Malaysia is a large exporter of electrical and electronic goods, a key segment of the global semiconductor and electronics supply chain. Trade data is a major gauge of Asian export demand.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Kuala Lumpur","country":"Malaysia","lat":3.139,"lon":101.687,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Star","url":"https://www.thestar.com.my/business/business-news/2026/05/20/malaysia039s-april-trade-hits-record-rm33673bil-on-strong-ee-exports"},"sources":[{"name":"The Star","url":"https://www.thestar.com.my/business/business-news/2026/05/20/malaysia039s-april-trade-hits-record-rm33673bil-on-strong-ee-exports"}],"published_at":"2026-05-20T13:13:00Z","retrieved_at":"2026-11-17T15:49:20Z","official":false,"ai_summary":true,"content_hash":"285a4fa22c0f8bd8","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:49:20Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-05-20T13:13:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-05-20T06:00:00Z","publisher_country_gdelt":"MY","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/container-port-8243358.jpg","alt":"container port (illustration)","credit":"Tho-Ge","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/ship-freighter-container-freighter-8243358/"}}