{"id":"n488efff047","headline":"Government bank employees go on strike, banks open on Sunday | Government bank employees go on strike, banks open on Sunday","summary":"Employees of government banks including SBI, Bank of Baroda and PNB are set to strike from 28 to 30 September. Some banks will open on Sunday, affecting the general public.","why":"State Bank of India is the country's largest lender, and public-sector banks hold a large share of Indian deposits and loans, so labour action at them affects banking services and sentiment in the sector.","category":"economy","event_type":"labor","importance":1,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[{"name":"State Bank of India","ticker":"SBIN.NS","kind":"company","asset":{"id":"EQ:XNSE:SBIN","n":"State Bank Of India","c":"equity","px":"SBIN.NS","la":17.725758098396327,"lo":72.13573146593303,"geo":"markets","co":"CO:EQ:XNSE:SBIN","m":"ticker+name","rv":"registry-v1"}},{"name":"Bank of Baroda","ticker":"BANKBARODA.NS","kind":"company","unresolved":"unknown-ticker:BANKBARODA.NS"},{"name":"Punjab National Bank","ticker":"PNB.NS","kind":"company","unresolved":"unknown-ticker:PNB.NS"}],"links":[],"source":{"name":"deshbandhu.co.in","url":"https://www.deshbandhu.co.in/business/government-bank-employees-go-on-strike-banks-open-on-sunday-322881"},"sources":[{"name":"deshbandhu.co.in","url":"https://www.deshbandhu.co.in/business/government-bank-employees-go-on-strike-banks-open-on-sunday-322881"}],"published_at":"2026-09-27T08:22:14Z","retrieved_at":"2026-11-13T12:41:00Z","official":false,"ai_summary":true,"content_hash":"ebaf5fa698bd83a2","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-13T12:41:00Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-27T08:22:14Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-27T12:0