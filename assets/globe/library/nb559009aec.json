{"id":"nb559009aec","headline":"Revenue collection takes major hit, Tk98,000 crore shortfall in 9 months","summary":"Bangladesh's revenue collection fell nearly Tk98,000 crore short in July 2025 to March 2026, according to National Board of Revenue data. The shortfall already exceeds the entire previous fiscal year's shortfall.","why":"Revenue shortfalls widen fiscal deficits and can affect government borrowing needs and sovereign credit assessments. Bangladesh is a major South Asian economy with a large garment export sector.","category":"economy","event_type":"macro-data","importance":1,"flag":null,"market_moving":false,"location":{"place":"Dhaka","country":"Bangladesh","lat":23.81,"lon":90.41,"region":"asia"},"entities":[],"links":[],"source":{"name":"Weekly Bangla Mirror |","url":"https://banglamirrornews.com/2026/04/25/204157/"},"sources":[{"name":"Weekly Bangla Mirror |","url":"https://banglamirrornews.com/2026/04/25/204157/"}],"published_at":"2026-04-25T08:01:29Z","retrieved_at":"2026-11-17T16:57:23Z","official":false,"ai_summary":true,"content_hash":"83600a69e6dcf072","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T16:57:23Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-25T08:01:29Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-25T12:00:00Z","publisher_country_gdelt":"BG","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-3716552.jpg","alt":"banknotes money (illustration)","credit":"un-perfekt","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/business-rich-money-man-mens-suit-3716552/"}}