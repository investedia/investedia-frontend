{"id":"n9fcbc1a675","headline":"Why the Yemeni Houthi capture of a tiny island matters to India","summary":"Yemeni Houthis captured Perim Island on September 11, an island in the middle of the Bab el-Mandeb Strait. The strait is a key shipping chokepoint between the Red Sea and the Gulf of Aden.","why":"Bab el-Mandeb is a major chokepoint for global oil and container shipping, so control of nearby islands affects freight routes and insurance costs.","category":"geopolitics","event_type":"geopolitics","importance":3,"flag":null,"market_moving":false,"location":{"place":"Perim Island","country":"Yemen","lat":12.65,"lon":43.42,"region":"me"},"entities":[],"links":[],"source":{"name":"Gulte","url":"https://www.gulte.com/trends/431237/why-the-yemeni-houthi-capture-of-a-tiny-island-matters-to-india"},"sources":[{"name":"Gulte","url":"https://www.gulte.com/trends/431237/why-the-yemeni-houthi-capture-of-a-tiny-island-matters-to-india"}],"published_at":"2026-09-12T15:30:33Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"3fec1cb64e532728","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-12T15:30:33Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-12T18:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-tanker-ship-3108235.jpg","alt":"oil tanker ship (illustration)","credit":"hpgruesen","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/the-outer-port-pier-oil-port-tanker-3108235/"}}