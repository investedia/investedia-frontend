{"id":"n4d0ae4a2ce","headline":"Attack on Wildberries Facility in Russia. Fire at the Company's Logistics Center","summary":"A fire broke out at a Wildberries sorting centre in Tula Oblast after an unmanned aerial vehicle fell on its territory. The company limited acceptance of current deliveries and redirected them to other facilities.","why":"Wildberries is one of Russia's largest online marketplaces, so disruption to its logistics network affects deliveries and sales across the country.","category":"companies","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Tula","country":"Russia","lat":54.19,"lon":37.62,"region":"eu"},"entities":[{"name":"Wildberries","ticker":null,"kind":"company","unresolved":"no-ticker"}],"links":[],"source":{"name":"Money.pl - portal finansowy","url":"https://www.money.pl/gospodarka/atak-na-zaklad-wildberries-w-rosji-pozar-w-centrum-logistycznym-firmy-7315068010862656a.html"},"sources":[{"name":"Money.pl - portal finansowy","url":"https://www.money.pl/gospodarka/atak-na-zaklad-wildberries-w-rosji-pozar-w-centrum-logistycznym-firmy-7315068010862656a.html"}],"published_at":"2026-08-05T04:54:42Z","retrieved_at":"2026-11-13T12:41:00Z","official":false,"ai_summary":true,"content_hash":"3331ceac00df17f2","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-13T12:41:00Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-05T04:54:42Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-05T06:00:00Z","publisher_country_gdelt":"UP","description_from":"publisher page metadata, translated to English by Claude"},"headline_translated":true,"original_headline":"Atak na zakład Wildberries w Rosji. Pożar w centrum logistycznym firmy","source_language":"pol","image":{"kind":"topic","file":"photos/warehouse-logistics-2484036.jpg","alt":"warehouse logistics (illustration)","credit":"harshahars","license":"Pix