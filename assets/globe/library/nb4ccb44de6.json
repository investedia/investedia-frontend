{"id":"nb4ccb44de6","headline":"Unemployment rate reaches post-COVID era high of 4.6pc in August","summary":"Australia's unemployment rate reached 4.6% in August, a post-COVID era high. Some economists say the increase will not be enough to stop the Reserve Bank lifting rates next week.","why":"The unemployment rate is a key labour market indicator that the Reserve Bank of Australia weighs when setting interest rates. It affects consumer spending and the outlook for Australian assets.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Canberra","country":"Australia","lat":-35.28,"lon":149.13,"region":"oc"},"entities":[],"links":[],"source":{"name":"abc.net.au","url":"https://www.abc.net.au/news/2026-09-24/unemployment-rate-australia-rises-post-covid-era-high-august/107189792"},"sources":[{"name":"abc.net.au","url":"https://www.abc.net.au/news/2026-09-24/unemployment-rate-australia-rises-post-covid-era-high-august/107189792"}],"published_at":"2026-09-24T01:45:48Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"3db3a78cc482e113","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-24T01:45:48Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-24T03:00:00Z","publisher_country_gdelt":"AS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/office-meeting-1838776.jpg","alt":"office meeting (illustration)","credit":"Pexels","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/chairs-desks-windows-empty-1838776/"}}