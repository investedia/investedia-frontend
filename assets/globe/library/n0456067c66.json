{"id":"n0456067c66","headline":"Debit, credit surcharge fees scrapped despite strong business opposition","summary":"Debit and credit card surcharges are being scrapped despite strong opposition from businesses. Consumers are estimated to be paying $1.6 billion of a total $1.8 billion in card surcharges.","why":"Card surcharges are fees merchants add to card payments, so their removal affects retailer margins and the payments industry. Changes to payment fee rules are watched by investors in banks and payment networks.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Canberra","country":"Australia","lat":-35.28,"lon":149.13,"region":"oc"},"entities":[],"links":[],"source":{"name":"farmweekly.com.au","url":"https://www.farmweekly.com.au/story/9210847/reserve-bank-card-surcharge-fees-scrapped-after-two-decades/"},"sources":[{"name":"farmweekly.com.au","url":"https://www.farmweekly.com.au/story/9210847/reserve-bank-card-surcharge-fees-scrapped-after-two-decades/"}],"published_at":"2026-03-30T23:40:00Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"cdd21cc8db8224bd","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-30T23:40:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-31T00:00:00Z","publisher_country_gdelt":"AS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-1963184.jpg","alt":"banknotes money (illustration)","credit":"stevepb","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/money-laundering-crime-fighting-1963184/"}}