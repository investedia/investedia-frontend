{"id":"n51fea37eb4","headline":"Serbia gives NIS 66,000 tonnes of crude oil from reserves","summary":"Serbia is releasing 66,000 tonnes of crude oil from reserves after a fault on the JANAF pipeline, which supplies the Pančevo refinery. Belgrade says there is no need to stockpile fuel.","why":"JANAF is the Croatian-operated pipeline that supplies crude to Serbia's Pančevo refinery, and supply disruptions can affect regional fuel availability.","category":"commodities","event_type":"energy-supply","importance":2,"flag":null,"market_moving":false,"location":{"place":"Pančevo","country":"Serbia","lat":44.87,"lon":20.64,"region":"eu"},"entities":[],"links":[],"source":{"name":"Fakti.bg - Да извадим фактите наяве","url":"https://fakti.bg/biznes/1101006-sarbia-dade-na-nis-66-000-tona-petrol-ot-rezervite"},"sources":[{"name":"Fakti.bg - Да извадим фактите наяве","url":"https://fakti.bg/biznes/1101006-sarbia-dade-na-nis-66-000-tona-petrol-ot-rezervite"}],"published_at":"2026-11-15T03:58:00Z","retrieved_at":"2026-11-15T08:29:19Z","official":false,"ai_summary":true,"content_hash":"d8ba8a9058ee67e7","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-15T08:29:19Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-11-15T03:58:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-11-15T05:00:00Z","publisher_country_gdelt":"RI","description_from":"publisher page metadata, translated to English by Claude"},"headline_translated":true,"original_headline":"Сърбия даде на НИС 66 000 тона петрол от резервите","source_language":"bul","image":{"kind":"topic","file":"photos/oil-refinery-5385905.jpg","alt":"oil refinery (illustration)","credit":"Tho-Ge","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/rhine-industry-factory-ship-5385905/"}}