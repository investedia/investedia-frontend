{"id":"nde055c167b","headline":"Nashik: NMC Ranks First In Country Under Centre’s Urban Challenge Fund","summary":"Nashik Municipal Corporation ranked first in the country under the Centre's Urban Challenge Fund for 2025-26 to 2030-31. The scheme encourages cities to seek funding from municipal bonds, PPPs and bank loans.","why":"The Urban Challenge Fund aims to shift Indian cities away from central grants toward market funding such as municipal bonds and public-private partnerships. This matters for infrastructure lenders and bond investors.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Nashik","country":"India","lat":19.997,"lon":73.79,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/pune/nashik-nmc-ranks-first-in-country-under-centres-urban-challenge-fund"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/pune/nashik-nmc-ranks-first-in-country-under-centres-urban-challenge-fund"}],"published_at":"2026-11-15T10:44:13Z","retrieved_at":"2026-11-15T20:16:48Z","official":false,"ai_summary":true,"content_hash":"12003a408ce49678","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-15T20:16:48Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-11-15T10:44:13Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-11-15T13:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/asian-city-skyline-6899643.jpg","alt":"asian city skyline (illustration)","credit":"rochogrape","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/buildings-urban-island-hainan-6899643/"}}