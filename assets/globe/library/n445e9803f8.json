{"id":"n445e9803f8","headline":"19-Kg Commercial LPG Cylinder Price Dropped By Rs 202 In Delhi, Rs 209 In Kolkata","summary":"The price of a 19-kg commercial LPG cylinder was reduced by Rs 202 in Delhi and Rs 209 in Kolkata, effective Saturday. A 19-kg cylinder will cost Rs 2,872.50 in Kolkata.","why":"Commercial LPG is a fuel input for restaurants and small industry, so its price affects operating costs in those businesses.","category":"commodities","event_type":"commodity-prices","importance":1,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.614,"lon":77.209,"region":"asia"},"entities":[],"links":[],"source":{"name":"Daily Excelsior","url":"https://www.dailyexcelsior.com/19-kg-commercial-lpg-cylinder-price-dropped-by-rs-202-in-delhi-rs-209-in-kolkata/"},"sources":[{"name":"Daily Excelsior","url":"https://www.dailyexcelsior.com/19-kg-commercial-lpg-cylinder-price-dropped-by-rs-202-in-delhi-rs-209-in-kolkata/"}],"published_at":"2026-08-01T04:34:20Z","retrieved_at":"2026-11-12T00:21:16Z","official":false,"ai_summary":true,"content_hash":"d67f098650ce9935","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T00:21:16Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-01T04:34:20Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-01T06:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/gas-pipeline-2653475.jpg","alt":"gas pipeline (illustration)","credit":"Get-it-on-Picture","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/industrial-energy-gasoline-pipe-2653475/"}}