{"id":"n983cc45e87","headline":"Parliament Warns Over Fuel Levy Reliance","summary":"A parliamentary caucus criticised the government's growing reliance on the petroleum levy as a main revenue measure. Lawmakers warned it is deepening inflationary pressure and the economic burden on the public.","why":"The petroleum levy is a tax on fuel that feeds directly into pump prices, so changes in its use affect inflation, consumer spending and fiscal policy.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Islamabad","country":"Pakistan","lat":33.694,"lon":73.065,"region":"asia"},"entities":[],"links":[],"source":{"name":"PakTribune","url":"https://paktribune.com/parliament-warns-over-fuel-levy-reliance/"},"sources":[{"name":"PakTribune","url":"https://paktribune.com/parliament-warns-over-fuel-levy-reliance/"}],"published_at":"2026-05-22T05:24:24Z","retrieved_at":"2026-11-17T15:49:20Z","official":false,"ai_summary":true,"content_hash":"d91f5f0a1797313d","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:49:20Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-05-22T05:24:24Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-05-22T06:00:00Z","publisher_country_gdelt":"PK","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-279769.jpg","alt":"parliament government building (illustration)","credit":"Thibaud","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/building-architecture-modern-279769/"}}