{"id":"nbc503aaeb8","headline":"Veg Thali Cost Stable, Non-Veg Thali Cheaper In March 2026 As Chicken Prices Fall: Crisil Report","summary":"Crisil Intelligence said veg thali costs were flat in March 2026, offset by cheaper vegetables and pulses against higher tomato, oil and LPG prices. Non-veg thali costs fell 1% on lower chicken prices.","why":"Crisil is an Indian research and ratings firm whose monthly thali index tracks household food inflation, a key input for India's central bank rate decisions.","category":"economy","event_type":"macro-data","importance":1,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.08,"lon":72.88,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/veg-thali-cost-stable-non-veg-thali-cheaper-in-march-2026-as-chicken-prices-fall-crisil-report"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/veg-thali-cost-stable-non-veg-thali-cheaper-in-march-2026-as-chicken-prices-fall-crisil-report"}],"published_at":"2026-04-06T11:31:40Z","retrieved_at":"2026-11-17T17:30:28Z","official":false,"ai_summary":true,"content_hash":"58284553d22bd9fb","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T17:30:28Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-06T11:31:40Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-06T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-1963184.jpg","alt":"banknotes money (illustration)","credit":"stevepb","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/money-laundering-crime-fighting-1963184/"}}