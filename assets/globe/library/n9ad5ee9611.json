{"id":"n9ad5ee9611","headline":"Australia passes law to levy tech giants that fail to pay for local news","summary":"Australia passed legislation that forces tech platforms to pay levies if they fail to strike commercial deals with local media for news content. The levies would be worth millions of dollars.","why":"Australia's News Media Bargaining Code set the template for news payment rules that other governments have studied. The law affects how large digital platforms such as Google and Meta monetise news.","category":"companies","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Canberra","country":"Australia","lat":-35.28,"lon":149.13,"region":"oc"},"entities":[],"links":[],"source":{"name":"93.3 The Drive","url":"https://www.933thedrive.com/2026/08/20/australia-passes-law-to-levy-tech-giants-that-fail-to-pay-for-local-news/"},"sources":[{"name":"93.3 The Drive","url":"https://www.933thedrive.com/2026/08/20/australia-passes-law-to-levy-tech-giants-that-fail-to-pay-for-local-news/"}],"published_at":"2026-08-20T07:54:57Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"73fa80e5ec32ca3a","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-20T07:54:57Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-20T09:00:00Z","publisher_country_gdelt":"AS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-1265254.jpg","alt":"parliament government building (illustration)","credit":"hpgruesen","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/european-parliament-strasbourg-patio-1265254/"}}