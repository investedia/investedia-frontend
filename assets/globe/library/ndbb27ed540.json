{"id":"ndbb27ed540","headline":"Islami Bank clarifies no formal information on reported Tk6,000cr state stake","summary":"Islami Bank said it has no formal information on a reported Tk6,000 crore state stake. Its share price nonetheless rose 3.91% on 22 November to close at Tk26.60.","why":"Islami Bank is a listed Bangladeshi commercial lender, and changes in state ownership can affect its governance and share register. Reports of government stakes often move bank shares in Dhaka.","category":"companies","event_type":"capital","importance":1,"flag":null,"market_moving":false,"location":{"place":"Dhaka","country":"Bangladesh","lat":23.81,"lon":90.41,"region":"asia"},"entities":[{"name":"Islami Bank Bangladesh","ticker":null,"kind":"company","unresolved":"no-ticker"}],"links":[],"source":{"name":"The Business Standard Bangladesh","url":"https://www.tbsnews.net/economy/stocks/islami-bank-clarifies-no-formal-information-reported-tk6000cr-state-stake-1610936"},"sources":[{"name":"The Business Standard Bangladesh","url":"https://www.tbsnews.net/economy/stocks/islami-bank-clarifies-no-formal-information-reported-tk6000cr-state-stake-1610936"}],"published_at":"2026-11-22T15:35:00Z","retrieved_at":"2026-11-22T20:28:09Z","official":false,"ai_summary":true,"score":0,"content_hash":"0210ef284f505c0e","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-22T20:28:09Z","backfill_provenance":{"version":"regional-backfill-v1","original_published_at":"2026-11-22T15:35:00Z","feed_url":"https://www.tbsnews.net/economy/rss.xml"}}