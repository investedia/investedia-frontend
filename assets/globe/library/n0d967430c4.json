{"id":"n0d967430c4","headline":"UPI MDR Charges: Merchants Cannot Pass On Fees To Customers","summary":"Punjab & Sind Bank MD and CEO Swarup Kumar Saha said merchants cannot pass on UPI MDR charges to customers. The 0.4% charge on P2M transactions above Rs 2,000 takes effect October 15, while small payments stay free.","why":"Merchant discount rates set the fees merchants pay on digital payments, influencing bank and payments-network revenue in India.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Punjab","country":"India","lat":30.73,"lon":76.78,"region":"asia"},"entities":[{"name":"Punjab & Sind Bank","ticker":null,"kind":"company","unresolved":"no-ticker"}],"links":[],"source":{"name":"Rediff","url":"https://www.rediff.com/business/report/upi-mdr-consumers-pay-posted-price-merchants-cannot-pass-on/20261006.htm"},"sources":[{"name":"Rediff","url":"https://www.rediff.com/business/report/upi-mdr-consumers-pay-posted-price-merchants-cannot-pass-on/20261006.htm"}],"published_at":"2026-10-06T09:42:58Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"6e734dd64660b257","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-10-06T09:42:58Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-10-06T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/bank-building-371288.jpg","alt":"bank building (illustration)","credit":"hslergr1","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/national-bank-swiss-national-bank-371288/"}}