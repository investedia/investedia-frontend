{"id":"n6e849d4770","headline":"Telecom Tax: Ethio Telecom & Safaricom To Pay 1.5% For Universal Access","summary":"A new regulation requires Ethio Telecom and Safaricom to contribute 1.5% of revenue to the Universal Access Fund. The article questions whether 2.5 billion birr a year can bridge the digital divide.","why":"Telecom operators' revenue levies reduce operating cash flow, and such contributions to universal access funds are typically aimed at extending network coverage.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Addis Ababa","country":"Ethiopia","lat":9.03,"lon":38.74,"region":"af"},"entities":[{"name":"Safaricom","ticker":"SCOM.NR","kind":"company","unresolved":"unknown-ticker:SCOM.NR"}],"links":[],"source":{"name":"The Reporter Ethiopia","url":"https://www.thereporterethiopia.com/49962/"},"sources":[{"name":"The Reporter Ethiopia","url":"https://www.thereporterethiopia.com/49962/"}],"published_at":"2026-03-28T08:57:57Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"4bfb8f41ec444865","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-28T08:57:57Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-28T12:00:00Z","publisher_country_gdelt":"ET","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/telecom-tower-5g-5050339.jpg","alt":"telecom tower 5g (illustration)","credit":"pelegraphy","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/communication-tower-radio-5050339/"}}