{"id":"nca4f540e82","headline":"Zambia extends petrol and diesel tax exemptions until September","summary":"Zambia has extended its suspension of excise duty and value added tax on petrol and diesel for 90 days, effective July 1 until September 30. The information ministry announced the extension.","why":"Fuel taxes feed directly into transport and food costs. Changes to fuel tax policy affect inflation and government revenue in import-dependent economies.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Lusaka","country":"Zambia","lat":-15.39,"lon":28.32,"region":"af"},"entities":[],"links":[],"source":{"name":"CNBC Africa","url":"https://www.cnbcafrica.com/2026/zambia-extends-petrol-and-diesel-tax-exemptions-until-september"},"sources":[{"name":"CNBC Africa","url":"https://www.cnbcafrica.com/2026/zambia-extends-petrol-and-diesel-tax-exemptions-until-september"}],"published_at":"2026-07-02T09:13:37Z","retrieved_at":"2026-11-17T13:01:10Z","official":false,"ai_summary":true,"content_hash":"9dd48d196fd99017","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:01:10Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-07-02T09:13:37Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-07-02T12:00:00Z","publisher_country_gdelt":"ZA","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-3400043.jpg","alt":"oil refinery (illustration)","credit":"nicolagiordano","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/refinery-petrolium-fossil-gas-3400043/"}}