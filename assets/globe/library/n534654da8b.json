{"id":"n534654da8b","headline":"Himachal: Tax row stalls revived India-China border trade","summary":"Revived India-China border trade through Shipki La, halted for six years, has stalled. Traders in Kinnaur are boycotting it in protest against IGST levied on imported goods.","why":"Border trade routes affect cross-border flows of goods between India and China, and tax treatment of imports determines whether that trade is commercially viable.","category":"economy","event_type":"trade","importance":1,"flag":null,"market_moving":false,"location":{"place":"Shipki La, Kinnaur","country":"India","lat":31.75,"lon":78.75,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Tribune","url":"https://www.tribuneindia.com/news/himachal/tax-row-stalls-revived-india-china-border-trade/"},"sources":[{"name":"The Tribune","url":"https://www.tribuneindia.com/news/himachal/tax-row-stalls-revived-india-china-border-trade/"}],"published_at":"2026-08-05T20:05:09Z","retrieved_at":"2026-11-12T00:21:16Z","official":false,"ai_summary":true,"content_hash":"c8792ad4cda553d2","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T00:21:16Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-05T20:05:09Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-06T06:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/cargo-trucks-highway-5248809.jpg","alt":"cargo trucks highway (illustration)","credit":"ArtisticOperations","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/truck-freight-cargo-delivery-5248809/"}}