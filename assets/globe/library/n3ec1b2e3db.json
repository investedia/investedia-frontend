{"id":"n3ec1b2e3db","headline":"Explainer: what a Hormuz deal giving Iran shipping control would mean","summary":"A proposed Iran-Oman deal to end the Hormuz conflict would reportedly give Iran control over inbound Gulf shipping. Washington has said it will not accept that concession, and fees and access remain unresolved.","why":"The Strait of Hormuz is one of the world's most important oil transit chokepoints, so control over its shipping directly affects global energy flows.","category":"geopolitics","event_type":"geopolitics","importance":3,"flag":null,"market_moving":false,"location":{"place":"Muscat","country":"Oman","lat":23.59,"lon":58.41,"region":"me"},"entities":[],"links":[],"source":{"name":"investingLive","url":"https://investinglive.com/commodities/explainer-what-a-hormuz-deal-giving-iran-shipping-control-would-mean/"},"sources":[{"name":"investingLive","url":"https://investinglive.com/commodities/explainer-what-a-hormuz-deal-giving-iran-shipping-control-would-mean/"}],"published_at":"2026-08-05T23:07:53Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"bfc95b1c0bb38239","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-05T23:07:53Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-06T00:00:00Z","publisher_country_gdelt":"IR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-tanker-ship-3466030.jpg","alt":"oil tanker ship (illustration)","credit":"weeksymate","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/ship-tanker-oil-cargo-3466030/"}}