{"id":"n6bc8e5a444","headline":"Latvian Government ready to limit fuel prices – how will it work?","summary":"The Latvian government has approved a proposal from the Ministry of Economics to introduce a solidarity levy aimed at limiting fuel prices. The mechanism is still under discussion.","why":"Solidarity levies are windfall-style taxes that can be used to fund price caps or subsidies. They affect fuel retailers and consumers in the affected market.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Riga","country":"Latvia","lat":56.95,"lon":24.105,"region":"eu"},"entities":[],"links":[],"source":{"name":"BNN","url":"https://bnn-news.com/latvian-government-ready-to-limit-fuel-prices-how-will-it-work-279257"},"sources":[{"name":"BNN","url":"https://bnn-news.com/latvian-government-ready-to-limit-fuel-prices-how-will-it-work-279257"}],"published_at":"2026-04-14T11:31:57Z","retrieved_at":"2026-11-17T17:30:28Z","official":false,"ai_summary":true,"content_hash":"5c918e39ab434491","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T17:30:28Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-14T11:31:57Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-14T12:00:00Z","publisher_country_gdelt":"LG","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/gas-pipeline-1685981.jpg","alt":"gas pipeline (illustration)","credit":"isakarakus","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/oil-petkim-t%C3%BCpra%C5%9F-kocaeli-turkey-1685981/"}}