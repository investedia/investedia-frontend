{"id":"nc3e48f2ecf","headline":"Lok Sabha Approves IBC Amendment Bill To Speed Insolvency Resolution Process Nationwide","summary":"The Lok Sabha approved the Insolvency and Bankruptcy Code (Amendment) Bill, 2025 on March 30. Finance Minister Nirmala Sitharaman said it includes a 14-day deadline to admit cases and penalties for misuse.","why":"The Insolvency and Bankruptcy Code governs corporate insolvency in India, shaping creditor recovery and restructuring timelines for lenders and investors.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.614,"lon":77.209,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/india/lok-sabha-approves-ibc-amendment-bill-to-speed-insolvency-resolution-process-nationwide"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/india/lok-sabha-approves-ibc-amendment-bill-to-speed-insolvency-resolution-process-nationwide"}],"published_at":"2026-03-30T11:20:38Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"03f0a7b457af3014","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-30T11:20:38Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-30T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-1804327.jpg","alt":"parliament government building (illustration)","credit":"Anna_01","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/hungary-travels-parliament-budapest-1804327/"}}