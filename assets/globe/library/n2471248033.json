{"id":"n2471248033","headline":"Stagflation risk: Chalmers heeds budget warning","summary":"Treasurer Jim Chalmers is being urged to reform tax and migration settings in the upcoming budget. The call comes amid warnings of stagflation risk.","why":"The federal budget shapes government spending, taxation and economic growth in Australia. Stagflation combines slow growth with high inflation, a difficult mix for policymakers and markets.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Canberra","country":"Australia","lat":-35.28,"lon":149.13,"region":"oc"},"entities":[],"links":[],"source":{"name":"southernhighlandnews.com.au","url":"https://www.southernhighlandnews.com.au/story/9212368/stagflation-risk-chalmers-heeds-budget-warning/"},"sources":[{"name":"southernhighlandnews.com.au","url":"https://www.southernhighlandnews.com.au/story/9212368/stagflation-risk-chalmers-heeds-budget-warning/"}],"published_at":"2026-04-01T05:28:41Z","retrieved_at":"2026-11-17T17:30:28Z","official":false,"ai_summary":true,"content_hash":"cb1b6be32ba3a17b","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T17:30:28Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-01T05:28:41Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-01T06:00:00Z","publisher_country_gdelt":"AS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-2711896.jpg","alt":"parliament government building (illustration)","credit":"ArvidO","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/bucharest-romania-building-2711896/"}}