{"id":"n5b9f832511","headline":"India Raises Diesel, Aviation Fuel Export Duties to Rs 14 and Rs 12.50","summary":"India raised export duties on diesel to Rs 14 and on aviation fuel to Rs 12.50, effective November 16. Petrol's export levy remains nil under an October 31 notice.","why":"India is a major refiner and exporter of petroleum products, so export duties influence global diesel and jet fuel supply and margins for refiners.","category":"commodities","event_type":"trade","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.614,"lon":77.209,"region":"asia"},"entities":[],"links":[],"source":{"name":"EconoTimes","url":"https://econotimes.com/India-Raises-Diesel-Aviation-Fuel-Export-Duties-to-Rs-14-and-Rs-12-50-1777898"},"sources":[{"name":"EconoTimes","url":"https://econotimes.com/India-Raises-Diesel-Aviation-Fuel-Export-Duties-to-Rs-14-and-Rs-12-50-1777898"}],"published_at":"2026-11-17T00:34:07Z","retrieved_at":"2026-11-17T02:34:32Z","official":false,"ai_summary":true,"content_hash":"44ced6db7a64e9ff","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T02:34:32Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-11-17T00:34:07Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-11-17T01:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-406908.jpg","alt":"oil refinery (illustration)","credit":"Life-Of-Pix","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/tanks-petrochemistry-silos-406908/"}}