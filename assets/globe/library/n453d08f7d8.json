{"id":"n453d08f7d8","headline":"Yemen's Houthis say they now control land that overlooks a key shipping route","summary":"Yemen's Houthis have overrun Saudi-backed forces to consolidate control along a Red Sea shipping strait, according to the report. The move extends their reach over a critical maritime corridor.","why":"The Red Sea and Bab el-Mandeb strait carry a large share of global container and oil shipping between Asia and Europe. Control of nearby land raises the risk to vessel transit and insurance costs.","category":"geopolitics","event_type":"geopolitics","importance":2,"flag":null,"market_moving":false,"location":{"place":"Bab el-Mandeb","country":"Yemen","lat":12.58,"lon":43.33,"region":"me"},"entities":[],"links":["na6cf764a71"],"source":{"name":"NSPR","url":"https://www.mynspr.org/2026-09-11/yemens-houthis-say-they-now-control-land-that-overlooks-a-key-shipping-route"},"sources":[{"name":"NSPR","url":"https://www.mynspr.org/2026-09-11/yemens-houthis-say-they-now-control-land-that-overlooks-a-key-shipping-route"}],"published_at":"2026-09-11T20:44:22Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"3febd137ef73c6f9","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-11T20:44:22Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-12T06:00:00Z","publisher_country_gdelt":"SA","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/container-port-3541607.jpg","alt":"container port (illustration)","credit":"jeanvdmeulen","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/table-bay-harbour-cape-town-dawn-3541607/"}}