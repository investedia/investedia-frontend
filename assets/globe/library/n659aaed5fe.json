{"id":"n659aaed5fe","headline":"The Clock Is Ticking Down To Iraq’s Economic Disaster On 27 July","summary":"Iraq's oil pipeline agreement with Turkey expires on July 27, threatening one of its few major export routes after the closure of the Strait of Hormuz. The article describes the deadline as critical for Iraqi exports.","why":"Iraq is one of the largest OPEC oil producers, and its exports depend heavily on limited routes, so pipeline access directly affects global crude supply.","category":"geopolitics","event_type":"energy-supply","importance":3,"flag":null,"market_moving":false,"location":{"place":"Baghdad","country":"Iraq","lat":33.315,"lon":44.366,"region":"me"},"entities":[],"links":[],"source":{"name":"OilPrice.com","url":"https://oilprice.com/Energy/Crude-Oil/The-Clock-Is-Ticking-Down-To-Iraqs-Economic-Disaster-On-27-July.html"},"sources":[{"name":"OilPrice.com","url":"https://oilprice.com/Energy/Crude-Oil/The-Clock-Is-Ticking-Down-To-Iraqs-Economic-Disaster-On-27-July.html"}],"published_at":"2026-06-09T20:00:00Z","retrieved_at":"2026-11-17T15:20:22Z","official":false,"ai_summary":true,"content_hash":"5654f4f752c64f19","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:20:22Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-09T20:00:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-10T00:00:00Z","publisher_country_gdelt":"IZ","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/gas-pipeline-972191.jpg","alt":"gas pipeline (illustration)","credit":"WOKANDAPIX","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/power-electricity-energy-972191/"}}