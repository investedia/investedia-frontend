{"id":"n507cc42b4c","headline":"Greek Government Bonds Carry a Tax Catch for Foreign Investors - Dnews","summary":"Under the Greek tax framework examined in a ruling, interest on Greek government bonds and Treasury bills paid to non-resident foreign entities without a permanent establishment is exempt from withholding tax. The article suggests this creates a tax catch for foreign investors.","why":"Withholding tax treatment affects the after-tax return foreign investors earn on sovereign debt, which influences demand for government bonds.","category":"markets","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Athens","country":"Greece","lat":37.984,"lon":23.727,"region":"eu"},"entities":[],"links":[],"source":{"name":"dnews.gr","url":"https://www.dnews.gr/eidhseis/news-in-english/601173/greek-government-bonds-carry-a-tax-catch-for-foreign-investors"},"sources":[{"name":"dnews.gr","url":"https://www.dnews.gr/eidhseis/news-in-english/601173/greek-government-bonds-carry-a-tax-catch-for-foreign-investors"}],"published_at":"2026-07-22T11:39:55Z","retrieved_at":"2026-11-17T12:21:21Z","official":false,"ai_summary":true,"content_hash":"a32539c0e55b4253","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T12:21:21Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-07-22T11:39:55Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-07-22T12:00:00Z","publisher_country_gdelt":"GR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/bank-building-4785454.jpg","alt":"bank building (illustration)","credit":"Alex_vagler","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/building-columns-architecture-4785454/"}}