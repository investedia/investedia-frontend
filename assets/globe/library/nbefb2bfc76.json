{"id":"nbefb2bfc76","headline":"Bangladesh to Join WTO Investment Facilitation Agreement","summary":"Bangladesh's cabinet approved a proposal to join the WTO's Investment Facilitation for Development Agreement under the plurilateral Joint Statement Initiative. The decision was taken at a cabinet meeting chaired by Prime Minister Tarique Rahman.","why":"The WTO sets global trade rules, and investment facilitation agreements aim to simplify cross-border investment procedures for member economies.","category":"economy","event_type":"trade","importance":1,"flag":null,"market_moving":false,"location":{"place":"Dhaka","country":"Bangladesh","lat":23.81,"lon":90.41,"region":"asia"},"entities":[],"links":[],"source":{"name":"Weekly Bangla Mirror |","url":"https://banglamirrornews.com/2026/03/18/bangladesh-to-join-wto-investment-facilitation-agreement/"},"sources":[{"name":"Weekly Bangla Mirror |","url":"https://banglamirrornews.com/2026/03/18/bangladesh-to-join-wto-investment-facilitation-agreement/"}],"published_at":"2026-03-18T10:07:13Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"1cca35a32bfdae8f","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-18T10:07:13Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-18T12:00:00Z","publisher_country_gdelt":"BG","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-2463230.jpg","alt":"parliament government building (illustration)","credit":"Felix-Mittermeier","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/federal-council-politics-2463230/"}}