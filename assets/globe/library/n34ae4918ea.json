{"id":"n34ae4918ea","headline":"'No Need To Panic': India Has Adequate Fuel Stocks, Assures Petroleum Ministry Amid Shortage Fears","summary":"India's Petroleum Ministry said petrol and diesel stocks are adequate and refineries are operating at full capacity. LPG production has risen 30%, and officials urged people not to panic-buy.","why":"India imports most of its crude and LPG, so supply disruptions in the Gulf directly affect the country's fuel security and consumer prices.","category":"commodities","event_type":"energy-supply","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/india/no-need-to-panic-india-has-adequate-fuel-stocks-assures-petroleum-ministry-amid-shortage-fears"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/india/no-need-to-panic-india-has-adequate-fuel-stocks-assures-petroleum-ministry-amid-shortage-fears"}],"published_at":"2026-03-13T11:30:23Z","retrieved_at":"2026-11-17T18:46:37Z","official":false,"ai_summary":true,"content_hash":"1c229f8d7fced8f0","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:46:37Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-13T11:30:23Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-13T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-5385905.jpg","alt":"oil refinery (illustration)","credit":"Tho-Ge","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/rhine-industry-factory-ship-5385905/"}}