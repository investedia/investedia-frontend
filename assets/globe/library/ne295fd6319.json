{"id":"ne295fd6319","headline":"India overhauls inflation framework with new Producer Price Index, revised WPI","summary":"India will introduce a new Producer Price Index and a revamped Wholesale Price Index from June 15. The revised WPI covers more commodities and includes renewable energy.","why":"Wholesale and producer price indices measure inflation at the factory and wholesale level and feed into policy decisions by the central bank.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.614,"lon":77.209,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/news/economy/indicators/india-overhauls-inflation-framework-with-new-producer-price-index-revised-wpi/articleshow/131460170.cms"},"sources":[{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/news/economy/indicators/india-overhauls-inflation-framework-with-new-producer-price-index-revised-wpi/articleshow/131460170.cms"}],"published_at":"2026-06-02T11:28:00Z","retrieved_at":"2026-11-17T15:20:22Z","official":false,"ai_summary":true,"content_hash":"c770b9f9fbeb312e","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:20:22Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-02T11:28:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-02T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"}}