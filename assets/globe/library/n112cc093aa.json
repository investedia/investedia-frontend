{"id":"n112cc093aa","headline":"Dutch authorities help block €1.2 billion in fake money in major Europol operation","summary":"Police and customs authorities from 18 countries, coordinated by Europol, stopped about €1.2 billion in counterfeit cash from reaching the public. The operation, called Operation DECOY III, targeted networks that moved fake currency by mail.","why":"Counterfeit currency undermines confidence in the euro and tests the integrity of cash systems that central banks monitor closely.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"The Hague","country":"Netherlands","lat":52.08,"lon":4.3,"region":"eu"},"entities":[],"links":[],"source":{"name":"NL Times","url":"https://nltimes.nl/2026/02/11/dutch-authorities-help-block-eu12-billion-fake-money-major-europol-operation"},"sources":[{"name":"NL Times","url":"https://nltimes.nl/2026/02/11/dutch-authorities-help-block-eu12-billion-fake-money-major-europol-operation"}],"published_at":"2026-02-11T17:40:00Z","retrieved_at":"2026-11-17T20:10:53Z","official":false,"ai_summary":true,"content_hash":"6fe22ad2b4f54bac","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T20:10:53Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-11T17:40:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-11T18:00:00Z","publisher_country_gdelt":"SP","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-1013789.jpg","alt":"banknotes money (illustration)","credit":"stevepb","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/wallet-cash-pocket-credit-card-1013789/"}}