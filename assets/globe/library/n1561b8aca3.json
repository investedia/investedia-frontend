{"id":"n1561b8aca3","headline":"SEBI receives 20,000 comments on CAS and derivatives changes","summary":"India's market regulator SEBI has received 20,000 comments on proposed changes to the Closing Auction Session, market timings and derivatives settlement. The consultation covers several market-structure proposals.","why":"SEBI regulates India's securities markets, including the NSE and BSE exchanges. Changes to closing auctions and settlement affect trading costs and liquidity for institutional investors.","category":"markets","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.076,"lon":72.878,"region":"asia"},"entities":[],"links":[],"source":{"name":"BusinessLine","url":"https://www.thehindubusinessline.com/markets/sebi-to-soon-issue-framework-on-closing-auction-session-receives-over-3500-comments/article71540080.ece"},"sources":[{"name":"BusinessLine","url":"https://www.thehindubusinessline.com/markets/sebi-to-soon-issue-framework-on-closing-auction-session-receives-over-3500-comments/article71540080.ece"}],"published_at":"2026-10-03T08:32:25Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"c8e3e3b7dce71b67","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-10-03T08:32:25Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-10-03T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/stock-market-trading-screen-624712.jpg","alt":"stock market trading screen (illustration)","credit":"Firmbee","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/stock-iphone-business-mobile-phone-624712/"}}