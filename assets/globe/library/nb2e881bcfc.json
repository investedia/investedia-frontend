{"id":"nb2e881bcfc","headline":"Baghdad Accuses Tehran, Washington of ‘Strangling’ the Iraqi Economy","summary":"Iraq's government spokesman accused Iran and the United States of strangling Iraq's economy. He said neither had granted exemptions allowing Iraqi oil exports through the Strait of Hormuz.","why":"Iraq is a major oil exporter whose crude shipments depend on the Strait of Hormuz, so restrictions there affect its government revenue and global oil supply.","category":"geopolitics","event_type":"geopolitics","importance":2,"flag":null,"market_moving":false,"location":{"place":"Baghdad","country":"Iraq","lat":33.31,"lon":44.37,"region":"me"},"entities":[],"links":[],"source":{"name":"aawsat.com","url":"https://english.aawsat.com/arab-world/5328962-baghdad-accuses-tehran-washington-%E2%80%98strangling%E2%80%99-iraqi-economy"},"sources":[{"name":"aawsat.com","url":"https://english.aawsat.com/arab-world/5328962-baghdad-accuses-tehran-washington-%E2%80%98strangling%E2%80%99-iraqi-economy"}],"published_at":"2026-10-13T04:53:35Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"35e75a984f54cf73","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-10-13T04:53:35Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-10-13T06:00:00Z","publisher_country_gdelt":"IR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-tanker-ship-6937800.jpg","alt":"oil tanker ship (illustration)","credit":"barskefranck","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/tanker-cargo-ship-freighter-ship-6937800/"}}