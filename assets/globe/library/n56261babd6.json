{"id":"n56261babd6","headline":"Government releases K5 billion to Admarc out of K60 billion budget","summary":"Admarc will begin buying maize at depots nationwide, but only K5 billion of the K60 billion budgeted for the season has been released so far. Its purchasing power remains limited.","why":"Admarc is Malawi's state produce trader, and its maize purchases affect farm incomes and food supply in the country.","category":"economy","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Lilongwe","country":"Malawi","lat":-13.96,"lon":33.79,"region":"af"},"entities":[],"links":[],"source":{"name":"Nation Online","url":"https://mwnation.com/government-releases-k5-billion-to-admarc-out-of-k60-billion-budget/"},"sources":[{"name":"Nation Online","url":"https://mwnation.com/government-releases-k5-billion-to-admarc-out-of-k60-billion-budget/"}],"published_at":"2026-05-31T05:34:00Z","retrieved_at":"2026-11-17T15:49:20Z","official":false,"ai_summary":true,"content_hash":"c997323ec920678e","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:49:20Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-05-31T05:34:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-05-31T06:00:00Z","publisher_country_gdelt":"MI","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/wheat-field-harvest-8158264.jpg","alt":"wheat field harvest (illustration)","credit":"donauwood_de","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/soft-wheat-seed-wheat-bread-wheat-8158264/"}}