{"id":"nc78e6066be","headline":"NBU increases its current account deficit forecast for 2026 by 6.7%","summary":"In its April macroeconomic forecast, the National Bank of Ukraine raised its 2026 current account deficit estimate by $2.5 billion, or 6.7%, to $39.7 billion. The revision compares with the January forecast.","why":"The current account balance shows how much a country relies on foreign financing, which affects its currency and external debt.","category":"economy","event_type":"macro-data","importance":1,"flag":null,"market_moving":false,"location":{"place":"Kyiv","country":"Ukraine","lat":50.45,"lon":30.52,"region":"eu"},"entities":[],"links":[],"source":{"name":"Interfax-Ukraine","url":"https://en.interfax.com.ua/news/economic/1163848.html"},"sources":[{"name":"Interfax-Ukraine","url":"https://en.interfax.com.ua/news/economic/1163848.html"}],"published_at":"2026-04-30T17:31:16Z","retrieved_at":"2026-11-17T16:57:23Z","official":false,"ai_summary":true,"content_hash":"8e8a78350414fc23","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T16:57:23Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-30T17:31:16Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-30T18:00:00Z","publisher_country_gdelt":"UP","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-4418922.jpg","alt":"banknotes money (illustration)","credit":"moritz320","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/money-banknotes-euro-finance-4418922/"}}