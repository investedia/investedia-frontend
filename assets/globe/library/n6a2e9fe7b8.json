{"id":"n6a2e9fe7b8","headline":"OpenAI's Altman says AI unlikely to lead to 'jobs apocalypse'","summary":"OpenAI CEO Sam Altman said AI is unlikely to lead to a 'jobs apocalypse', without citing any jobs figures. He has previously discussed possible industry-wide job cuts from AI advances.","why":"OpenAI is a leading developer of generative AI models, and its strategy shapes demand for AI chips and cloud services. Labour-market effects of AI are a major policy question for investors.","category":"technology","event_type":"labor","importance":2,"flag":null,"market_moving":false,"location":{"place":"San Francisco","country":"United States of America","lat":37.77,"lon":-122.42,"region":"na"},"entities":[],"links":[],"source":{"name":"RAPPLER","url":"https://www.rappler.com/technology/openai-sam-altman-ai-unlikely-lead-jobs-apocalypse/"},"sources":[{"name":"RAPPLER","url":"https://www.rappler.com/technology/openai-sam-altman-ai-unlikely-lead-jobs-apocalypse/"}],"published_at":"2026-05-26T08:45:28Z","retrieved_at":"2026-11-17T15:49:20Z","official":false,"ai_summary":true,"content_hash":"a65b9c61b30e7cea","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:49:20Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-05-26T08:45:28Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-05-26T12:00:00Z","publisher_country_gdelt":"AS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/artificial-intelligence-robot-5174066.jpg","alt":"artificial intelligence robot (illustration)","credit":"KELLEPICS","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/artificial-intelligence-portrait-5174066/"}}