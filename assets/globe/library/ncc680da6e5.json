{"id":"ncc680da6e5","headline":"Firm sets up Singapore trading arm","summary":"A Cebu-based listed fuel distributor has approved the creation of a wholly owned subsidiary in Singapore. The move is part of its long-term vertical integration strategy.","why":"Fuel distributors buy and sell refined petroleum products, and trading hubs such as Singapore are key centres for oil supply. Vertical integration can shift costs and margins across the supply chain.","category":"companies","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Cebu City","country":"Philippines","lat":10.32,"lon":123.89,"region":"asia"},"entities":[],"links":[],"source":{"name":"SunStar Publishing Inc.","url":"https://www.sunstar.com.ph/cebu/firm-sets-up-singapore-trading-arm"},"sources":[{"name":"SunStar Publishing Inc.","url":"https://www.sunstar.com.ph/cebu/firm-sets-up-singapore-trading-arm"}],"published_at":"2026-02-25T10:44:31Z","retrieved_at":"2026-11-17T19:26:54Z","official":false,"ai_summary":true,"content_hash":"b86baabba2c0bd10","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T19:26:54Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-25T10:44:31Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-25T12:00:00Z","publisher_country_gdelt":"RP","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-7010971.jpg","alt":"oil refinery (illustration)","credit":"yamabon","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/plant-chimney-night-view-7010971/"}}