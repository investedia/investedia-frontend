{"id":"n442bcfe44c","headline":"Tata Sons Succession Race Begins After Chandrasekaran Exit","summary":"N Chandrasekaran's resignation as Tata Sons chairman has started a succession process at India's largest conglomerate. Tata Trusts, which owns about 66% of Tata Sons, will play a crucial role in choosing his successor.","why":"Tata Sons is the holding company at the top of the Tata Group, whose listed companies span autos, steel, IT services and consumer goods. Leadership changes at the parent often affect governance and investor sentiment across the group.","category":"companies","event_type":"other","importance":2,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.076,"lon":72.878,"region":"asia"},"entities":[{"name":"Tata Sons","ticker":null,"kind":"company","unresolved":"no-ticker"}],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/tata-sons-succession-race-begins-after-chandrasekaran-exit"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/tata-sons-succession-race-begins-after-chandrasekaran-exit"}],"published_at":"2026-08-12T11:30:54Z","retrieved_at":"2026-11-12T00:21:16Z","official":false,"ai_summary":true,"content_hash":"a446e9c31cba1334","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T00:21:16Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-12T11:30:54Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-12T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/office-meeting-2569234.jpg","alt":"office meeting (illustration)","credit":"StockSnap","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/people-group-friends-concept-2569234/"}}