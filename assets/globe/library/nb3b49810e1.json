{"id":"nb3b49810e1","headline":"Retail Inflation Hits 24-Month High Of 6.09%, Food Prices Push It Past RBI’s 6% Ceiling","summary":"India's retail inflation climbed to a 24-month high of 6.09% in October, above the RBI's 6% ceiling, as food inflation rose to 8.94%. The data comes ahead of the December monetary policy review.","why":"Consumer price inflation is the main gauge the Reserve Bank of India uses to set interest rates. Persistent overshoots can influence rate decisions and bond yields.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/retail-inflation-hits-24-month-high-of-609-food-prices-push-it-past-rbis-6-ceiling"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/retail-inflation-hits-24-month-high-of-609-food-prices-push-it-past-rbis-6-ceiling"}],"published_at":"2026-11-12T11:33:27Z","retrieved_at":"2026-11-12T13:59:53Z","official":false,"ai_summary":true,"content_hash":"e3fed69c786ada03","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T13:59:53Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-11-12T11:33:27Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-11-12T13:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-3481699.jpg","alt":"banknotes money (illustration)","credit":"MabelAmber","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/money-bank-notes-euro-notes-euro-3481699/"}}