{"id":"n3258341eba","headline":"US sanctions ‘vast majority’ of remaining Iranian shadow fleet","summary":"The US Treasury said it is sanctioning the vast majority of Iran's remaining shadow fleet to cut the money used to fund the regime's regional activities. The move targets tankers used to evade sanctions.","why":"Shadow fleet tankers carry Iranian oil outside normal channels, so sanctions on them restrict Iran's oil export revenue and affect global crude flows.","category":"geopolitics","event_type":"geopolitics","importance":3,"flag":null,"market_moving":false,"location":{"place":"Washington","country":"United States of America","lat":38.907,"lon":-77.037,"region":"na"},"entities":[],"links":[],"source":{"name":"Israel & Jewish News - JNS","url":"https://www.jns.org/news/u-s-news/us-sanctions-vast-majority-of-remaining-iranian-shadow-fleet"},"sources":[{"name":"Israel & Jewish News - JNS","url":"https://www.jns.org/news/u-s-news/us-sanctions-vast-majority-of-remaining-iranian-shadow-fleet"}],"published_at":"2026-10-08T17:00:00Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"e322e2f8b6bb2b14","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-10-08T17:00:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-10-08T18:00:00Z","publisher_country_gdelt":"IR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-tanker-ship-7338168.jpg","alt":"oil tanker ship (illustration)","credit":"analogicus","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/cargo-ship-sunset-sea-ship-ocean-7338168/"}}