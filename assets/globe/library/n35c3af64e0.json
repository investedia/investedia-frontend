{"id":"n35c3af64e0","headline":"Greece plans further minimum wage rise amid Iran war pressure","summary":"Greece will raise its gross monthly minimum wage by 4.5% to 920 euros from April 1, the sixth rise in four years. The move aims to offset rising energy costs, with a target of 950 euros by 2027.","why":"Minimum wage policy affects labour costs for employers, consumer spending and the government's inflation and social policy outlook.","category":"economy","event_type":"labor","importance":2,"flag":null,"market_moving":false,"location":{"place":"Athens","country":"Greece","lat":37.984,"lon":23.727,"region":"eu"},"entities":[],"links":[],"source":{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/nri/work/greece-plans-further-minimum-wage-rise-amid-iran-war-pressure/articleshow/129823102.cms"},"sources":[{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/nri/work/greece-plans-further-minimum-wage-rise-amid-iran-war-pressure/articleshow/129823102.cms"}],"published_at":"2026-03-26T11:26:06Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"17f48d07f8f3e27b","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-26T11:26:06Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-26T12:00:00Z","publisher_country_gdelt":"IR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/factory-workers-5963960.jpg","alt":"factory workers (illustration)","credit":"19661338","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/women-crowd-protest-protesters-5963960/"}}