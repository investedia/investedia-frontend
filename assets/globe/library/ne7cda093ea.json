{"id":"ne7cda093ea","headline":"CCS Meeting Today To Review Economic, Security Impact Of West Asia Conflict","summary":"India's Cabinet Committee on Security will meet to assess the escalating West Asia conflict's impact on food, fuel, fertiliser and trade. Officials said measures are being planned to ensure supply stability.","why":"The Cabinet Committee on Security is India's top body for national security decisions, and its economic measures can affect import-dependent sectors.","category":"geopolitics","event_type":"geopolitics","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/india/ccs-meeting-today-to-review-economic-security-impact-of-west-asia-conflict"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/india/ccs-meeting-today-to-review-economic-security-impact-of-west-asia-conflict"}],"published_at":"2026-04-01T11:09:15Z","retrieved_at":"2026-11-17T17:30:28Z","official":false,"ai_summary":true,"content_hash":"b59d23049c68ee13","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T17:30:28Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-01T11:09:15Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-01T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-1804327.jpg","alt":"parliament government building (illustration)","credit":"Anna_01","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/hungary-travels-parliament-budapest-1804327/"}}