{"id":"nd986803fc8","headline":"Treasury Says Sh469 Billion Reached Counties in 2025/26, but Sh16.77 Billion in Extra Funds Fell Short","summary":"Kenya's counties received Sh469 billion in the 2025/26 financial year, Treasury figures show. Sh16.77 billion in approved additional allocations was not disbursed, partly due to late enactment of the enabling law.","why":"Counties depend on national transfers from the Treasury, so disbursement delays affect local public spending and the wider Kenyan fiscal picture.","category":"economy","event_type":"macro-data","importance":1,"flag":null,"market_moving":false,"location":{"place":"Nairobi","country":"Kenya","lat":-1.29,"lon":36.82,"region":"af"},"entities":[],"links":[],"source":{"name":"Nairobi Wire","url":"https://nairobiwire.com/2026/11/counties-sh469-billion-2025-26-additional-allocations-shortfall.html"},"sources":[{"name":"Nairobi Wire","url":"https://nairobiwire.com/2026/11/counties-sh469-billion-2025-26-additional-allocations-shortfall.html"}],"published_at":"2026-11-17T03:42:00Z","retrieved_at":"2026-11-17T14:38:19Z","official":false,"ai_summary":true,"content_hash":"1b6e232d4c9d308a","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T14:38:19Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-11-17T03:42:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-11-17T14:00:00Z","publisher_country_gdelt":"KE","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-5244058.jpg","alt":"banknotes money (illustration)","credit":"Alexas_Fotos","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/money-money-laundering-seem-5244058/"}}