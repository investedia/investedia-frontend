{"id":"n7a59572177","headline":"Smallholder interest stays at 6% despite BI Rate hike: Hartarto","summary":"Coordinating Economic Affairs Minister Airlangga Hartarto said the smallholder interest rate will stay at 6% despite the BI Rate increase. The statement was reported by Antara News.","why":"Bank Indonesia sets the benchmark policy rate, which influences rupiah yields and borrowing costs. Subsidised smallholder lending is a government programme separate from the policy rate.","category":"economy","event_type":"rates","importance":2,"flag":null,"market_moving":false,"location":{"place":"Jakarta","country":"Indonesia","lat":-6.209,"lon":106.846,"region":"asia"},"entities":[],"links":[],"source":{"name":"Antara News","url":"https://en.antaranews.com/news/420821/smallholder-interest-stays-at-6-despite-bi-rate-hike-hartarto"},"sources":[{"name":"Antara News","url":"https://en.antaranews.com/news/420821/smallholder-interest-stays-at-6-despite-bi-rate-hike-hartarto"}],"published_at":"2026-06-29T14:52:29Z","retrieved_at":"2026-11-17T13:38:59Z","official":false,"ai_summary":true,"content_hash":"84ccddf8577eec03","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:38:59Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-29T14:52:29Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-29T18:00:00Z","publisher_country_gdelt":"ID","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/central-bank-building-371288.jpg","alt":"central bank building (illustration)","credit":"hslergr1","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/national-bank-swiss-national-bank-371288/"}}