{"id":"nc9caa0c824","headline":"Tanzania: Fuel, Fertiliser Subsidies to Ease Inflation","summary":"Fuel and fertiliser subsidies, tax relief on essential food imports and tighter price monitoring are being used to curb inflation. The measures aim to protect the currency's purchasing power, lawmakers heard.","why":"Subsidies and import tax relief affect consumer prices, farm input costs and government finances in an economy where food and fuel weigh heavily on inflation.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Dodoma","country":"Tanzania","lat":-6.163,"lon":35.752,"region":"af"},"entities":[],"links":[],"source":{"name":"allAfrica.com","url":"https://allafrica.com/stories/202609180266.html"},"sources":[{"name":"allAfrica.com","url":"https://allafrica.com/stories/202609180266.html"}],"published_at":"2026-09-18T11:03:50Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"4896d6adbcf002a1","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-18T11:03:50Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-18T12:00:00Z","publisher_country_gdelt":"TZ","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-4468573.jpg","alt":"parliament government building (illustration)","credit":"noelsch","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/architecture-germany-building-flag-4468573/"}}