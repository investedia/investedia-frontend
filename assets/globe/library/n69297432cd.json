{"id":"n69297432cd","headline":"Kenya: Capitalpay Targets Costly Payment Gaps Slowing African Trade","summary":"CapitalPay International is building fintech tools that match payments with invoices, licences, cargo records and institutional approvals. The aim is to address payment delays that slow trade across Africa.","why":"Payment friction in cross-border trade raises costs and delays for importers, exporters and their banks. Fintech firms that automate reconciliation are a growing investment theme in African markets.","category":"companies","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Nairobi","country":"Kenya","lat":-1.292,"lon":36.822,"region":"af"},"entities":[{"name":"CapitalPay International","ticker":null,"kind":"company","unresolved":"no-ticker"}],"links":[],"source":{"name":"allAfrica.com","url":"https://allafrica.com/stories/202609150252.html"},"sources":[{"name":"allAfrica.com","url":"https://allafrica.com/stories/202609150252.html"}],"published_at":"2026-09-15T10:18:03Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"26a181d12c847347","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-15T10:18:03Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-15T12:00:00Z","publisher_country_gdelt":"KE","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-3479568.jpg","alt":"banknotes money (illustration)","credit":"MabelAmber","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/dirham-moroccan-currency-banknote-3479568/"}}