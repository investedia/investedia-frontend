{"id":"nd4805674bc","headline":"Indian oil tanker heads to India after escaping attack on Fujairah port","summary":"The Indian-flagged tanker Jag Laadki, carrying 80,800 tonnes of crude, escaped a drone attack at Fujairah port. All Indian seafarers are safe and the vessel is heading to India.","why":"Fujairah is a major UAE oil storage and bunkering hub outside the Strait of Hormuz, so attacks there affect crude flows and shipping risk.","category":"geopolitics","event_type":"geopolitics","importance":2,"flag":null,"market_moving":false,"location":{"place":"Fujairah","country":"United Arab Emirates","lat":25.12,"lon":56.34,"region":"me"},"entities":[],"links":[],"source":{"name":"Hindustan Times","url":"https://www.hindustantimes.com/india-news/indian-oil-tanker-heads-to-india-after-escaping-attack-on-fujairah-port-101773591064917.html"},"sources":[{"name":"Hindustan Times","url":"https://www.hindustantimes.com/india-news/indian-oil-tanker-heads-to-india-after-escaping-attack-on-fujairah-port-101773591064917.html"}],"published_at":"2026-03-15T16:14:51Z","retrieved_at":"2026-11-17T18:46:37Z","official":false,"ai_summary":true,"content_hash":"f829e85c20135edc","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:46:37Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-15T16:14:51Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-15T18:00:00Z","publisher_country_gdelt":"AE","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-tanker-ship-5117014.jpg","alt":"oil tanker ship (illustration)","credit":"Capt-M","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/tanker-ship-vlcc-vessel-oil-industry-5117014/"}}