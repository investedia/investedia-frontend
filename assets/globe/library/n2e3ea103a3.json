{"id":"n2e3ea103a3","headline":"[SMM Announcement] SMM to Launch total six (four billet and two ingot) domestic India Price Assessments — Shanghai Metals Market (SMM)","summary":"Shanghai Metals Market will add six India price assessments covering four billet and two ingot products. The aim is greater price transparency for international market participants.","why":"Price assessments are benchmarks that help metals producers, traders and buyers hedge and value physical contracts. Billets and ingots are semi-finished metal products used in manufacturing.","category":"commodities","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Shanghai","country":"China","lat":31.23,"lon":121.47,"region":"asia"},"entities":[],"links":[],"source":{"name":"metal.com","url":"https://www.metal.com/announcements/104073626-smm-announcement-smm-to-launch-total-six-four-billet-and-two-ingot-domestic-india-price-assessments"},"sources":[{"name":"metal.com","url":"https://www.metal.com/announcements/104073626-smm-announcement-smm-to-launch-total-six-four-billet-and-two-ingot-domestic-india-price-assessments"}],"published_at":"2026-08-21T09:05:14Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"9610982cb85b3222","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-21T09:05:14Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-21T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/steel-factory-1236578.jpg","alt":"steel factory (illustration)","credit":"MustangJoe","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/gears-cogs-machine-machinery-1236578/"}}