{"id":"n16f126fb54","headline":"India approves ₹12,980 crore maritime insurance pool amid rising shipping risks","summary":"India approved a ₹12,980 crore maritime insurance pool for 10 years. The pool aims to tackle rising shipping risks and insurance costs amid global tensions, including the Iran war.","why":"Marine insurance costs affect the economics of shipping and trade routes, especially through conflict zones. Government-backed insurance pools can stabilise coverage when commercial insurers withdraw.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"BusinessLine","url":"https://www.thehindubusinessline.com/economy/logistics/india-approves-12980-crore-maritime-insurance-pool-amid-rising-shipping-risks/article70877208.ece"},"sources":[{"name":"BusinessLine","url":"https://www.thehindubusinessline.com/economy/logistics/india-approves-12980-crore-maritime-insurance-pool-amid-rising-shipping-risks/article70877208.ece"}],"published_at":"2026-04-18T10:17:10Z","retrieved_at":"2026-11-17T16:57:23Z","official":false,"ai_summary":true,"content_hash":"9c8521eaff9cd6e9","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T16:57:23Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-18T10:17:10Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-18T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/container-port-5466008.jpg","alt":"container port (illustration)","credit":"Elchinator","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/container-port-ship-crane-hamburg-5466008/"}}