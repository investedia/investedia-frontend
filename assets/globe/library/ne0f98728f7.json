{"id":"ne0f98728f7","headline":"Middle East crisis could affect petrol, heating and electricity bills in Ireland","summary":"Up to 20,000 Irish people are stranded in Dubai, Abu Dhabi and Doha as airports remain closed. The Middle East crisis could affect petrol, heating and electricity bills in Ireland.","why":"Ireland imports most of its oil and gas, so supply disruptions in the Gulf pass quickly into domestic energy prices. Energy costs feed directly into household budgets and inflation.","category":"geopolitics","event_type":"geopolitics","importance":2,"flag":null,"market_moving":false,"location":{"place":"Dubai","country":"United Arab Emirates","lat":25.205,"lon":55.271,"region":"me"},"entities":[],"links":[],"source":{"name":"Irish Mirror","url":"https://www.irishmirror.ie/news/irish-news/how-middle-east-crisis-could-36801915"},"sources":[{"name":"Irish Mirror","url":"https://www.irishmirror.ie/news/irish-news/how-middle-east-crisis-could-36801915"}],"published_at":"2026-03-02T10:49:01Z","retrieved_at":"2026-11-17T18:46:37Z","official":false,"ai_summary":true,"content_hash":"4d54c2feebf3d9df","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:46:37Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-02T10:49:01Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-02T12:00:00Z","publisher_country_gdelt":"QA","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-6991799.jpg","alt":"oil refinery (illustration)","credit":"tasukaran","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/factory-chimney-industry-steam-6991799/"}}