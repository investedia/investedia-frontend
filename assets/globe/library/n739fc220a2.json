{"id":"n739fc220a2","headline":"Americans turning to installment plans to skip credit cards, live comfortably","summary":"More than a quarter of Americans sometimes or often use buy-now-pay-later plans when shopping online, a new study finds. Many do so to avoid racking up credit card debt.","why":"Buy-now-pay-later providers offer short-term instalment credit at checkout, and their growth affects consumer credit trends. Shifts between card debt and instalment credit are watched as signals of household finances.","category":"economy","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"United States","country":"United States of America","lat":39.8,"lon":-98.6,"region":"na"},"entities":[],"links":[],"source":{"name":"FOX 13 Tampa Bay","url":"https://www.fox13news.com/news/americans-turning-installment-plans-skip-credit-cards-live-comfortably"},"sources":[{"name":"FOX 13 Tampa Bay","url":"https://www.fox13news.com/news/americans-turning-installment-plans-skip-credit-cards-live-comfortably"}],"published_at":"2026-05-18T23:53:22Z","retrieved_at":"2026-11-17T15:49:20Z","official":false,"ai_summary":true,"content_hash":"10b12dd9dc37f866","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:49:20Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-05-18T23:53:22Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-05-19T12:00:00Z","publisher_country_gdelt":"GR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/smartphone-1283938.jpg","alt":"smartphone (illustration)","credit":"Pexels","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/samsung-smartphone-hand-holding-1283938/"}}