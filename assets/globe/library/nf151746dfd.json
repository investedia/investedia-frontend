{"id":"nf151746dfd","headline":"EPRA Adds Three New Charges to Your May 2026 Power Bill","summary":"EPRA has added three new charges to Kenya's May 2026 electricity bills, including a Ksh 3.06 per kWh fuel levy and a Ksh 1.10 per kWh forex adjustment. Fuel prices have also hit record highs.","why":"The Energy and Petroleum Regulatory Authority sets energy charges that pass fuel and currency costs through to consumers.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Nairobi","country":"Kenya","lat":-1.292,"lon":36.822,"region":"af"},"entities":[],"links":[],"source":{"name":"Nairobi Wire","url":"https://nairobiwire.com/2026/05/epra-new-electricity-charges-may-2026-kenya-power-bill-fuel-forex-levy.html"},"sources":[{"name":"Nairobi Wire","url":"https://nairobiwire.com/2026/05/epra-new-electricity-charges-may-2026-kenya-power-bill-fuel-forex-levy.html"}],"published_at":"2026-05-18T03:43:57Z","retrieved_at":"2026-11-17T15:49:20Z","official":false,"ai_summary":true,"content_hash":"14b2513dc18f7228","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:49:20Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-05-18T03:43:57Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-05-18T06:00:00Z","publisher_country_gdelt":"KE","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/power-plant-4796858.jpg","alt":"power plant (illustration)","credit":"marcinjozwiak","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/pollution-environment-drone-aerial-4796858/"}}