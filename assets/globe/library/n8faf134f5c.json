{"id":"n8faf134f5c","headline":"'Priming domestic demand' vs. 'short-term fix': Cash aid plan draws mixed reactions","summary":"Small business owners are sharply divided over the government's plan to offer up to 600,000 won in cash assistance to households. Supporters see it as priming domestic demand, while critics call it a short-term fix.","why":"Cash handouts are a fiscal tool that can boost household spending and domestic demand. Such measures are closely watched for their effect on inflation and public debt.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Seoul","country":"South Korea","lat":37.566,"lon":126.978,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Korea Times","url":"https://www.koreatimes.co.kr/economy/others/20260401/priming-domestic-demand-vs-short-term-fix-cash-aid-plan-draws-mixed-reactions"},"sources":[{"name":"The Korea Times","url":"https://www.koreatimes.co.kr/economy/others/20260401/priming-domestic-demand-vs-short-term-fix-cash-aid-plan-draws-mixed-reactions"}],"published_at":"2026-04-01T05:17:04Z","retrieved_at":"2026-11-17T17:30:28Z","official":false,"ai_summary":true,"content_hash":"33a500b2d9214436","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T17:30:28Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-01T05:17:04Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-01T06:00:00Z","publisher_country_gdelt":"KS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-6962982.jpg","alt":"parliament government building (illustration)","credit":"ValterM","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/parliament-architecture-building-6962982/"}}