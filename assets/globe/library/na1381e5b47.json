{"id":"na1381e5b47","headline":"Ethiopia: As Conflict Spreads From Moyale to Borana, Cross Border, Domestic Livestock Markets Grind to a Halt","summary":"Conflict that began in Moyale and spread to Borana in southern Oromia has entered its third week. The area's main livestock market, a key pillar of the local economy, is nearly at a standstill.","why":"Livestock trade is a core income source in pastoral regions, and disruption to cross-border markets affects regional food and trade flows.","category":"economy","event_type":"geopolitics","importance":1,"flag":null,"market_moving":false,"location":{"place":"Borana","country":"Ethiopia","lat":4.5,"lon":38.5,"region":"af"},"entities":[],"links":[],"source":{"name":"allAfrica.com","url":"https://allafrica.com/stories/202611120039.html"},"sources":[{"name":"allAfrica.com","url":"https://allafrica.com/stories/202611120039.html"}],"published_at":"2026-11-12T05:23:12Z","retrieved_at":"2026-11-12T13:59:53Z","official":false,"ai_summary":true,"content_hash":"e9595b6791a60d9a","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T13:59:53Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-11-12T05:23:12Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-11-12T06:00:00Z","publisher_country_gdelt":"KE","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/cattle-ranch-4751376.jpg","alt":"cattle ranch (illustration)","credit":"Ray_Shrewsberry","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/longhorn-cattle-texas-livestock-4751376/"}}