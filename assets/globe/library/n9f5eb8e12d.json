{"id":"n9f5eb8e12d","headline":"Malawians Still Crippled By Forex Shortages As Banks Refuse to Budge","summary":"Travellers and businesses in Malawi continue to complain of forex shortages, with banks accused of refusing to exchange kwacha for dollars. Fresh figures show foreign exchange reserves have improved.","why":"Foreign currency shortages restrict imports and trade payments and can widen the gap between official and parallel exchange rates, a key risk for investors in frontier markets.","category":"economy","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Lilongwe","country":"Malawi","lat":-13.98,"lon":33.79,"region":"af"},"entities":[],"links":[],"source":{"name":"allAfrica.com","url":"https://allafrica.com/stories/202609150028.html"},"sources":[{"name":"allAfrica.com","url":"https://allafrica.com/stories/202609150028.html"}],"published_at":"2026-09-15T05:26:41Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"1358655b4a1cf5dc","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-15T05:26:41Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-15T06:00:00Z","publisher_country_gdelt":"MI","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-3716552.jpg","alt":"banknotes money (illustration)","credit":"un-perfekt","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/business-rich-money-man-mens-suit-3716552/"}}