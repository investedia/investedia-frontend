{"id":"n244f34f3d2","headline":"Italy's Meloni offers African states climate-shock debt suspension","summary":"Italy will offer African countries the chance to suspend debt repayments when hit by extreme climate events. Prime Minister Giorgia Meloni made the offer at the African Union Summit in Addis Ababa.","why":"Debt suspension clauses tied to climate shocks can ease sovereign repayment pressure in vulnerable economies. Such arrangements affect African sovereign credit and development financing.","category":"economy","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Addis Ababa","country":"Ethiopia","lat":9.03,"lon":38.74,"region":"af"},"entities":[],"links":[],"source":{"name":"MarketScreener","url":"https://www.marketscreener.com/news/italy-s-meloni-offers-african-states-climate-shock-debt-suspension-ce7e5ddbdd8cf520"},"sources":[{"name":"MarketScreener","url":"https://www.marketscreener.com/news/italy-s-meloni-offers-african-states-climate-shock-debt-suspension-ce7e5ddbdd8cf520"}],"published_at":"2026-02-14T16:39:18Z","retrieved_at":"2026-11-17T20:10:53Z","official":false,"ai_summary":true,"content_hash":"6b244adb470b9a75","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T20:10:53Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-14T16:39:18Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-14T18:00:00Z","publisher_country_gdelt":"IT","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-5489698.jpg","alt":"parliament government building (illustration)","credit":"Squirrel_photos","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/the-beehive-new-zealand-wellington-5489698/"}}