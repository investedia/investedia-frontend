{"id":"ne06245a273","headline":"Iran's Qalibaf Urges Baghdad to Break Economic Dependence on Washington","summary":"Iranian Parliament Speaker Mohammad Baqer Qalibaf urged Baghdad to cut its reliance on the dollar and draft a roadmap for economic cooperation. He spoke in Najaf as Iraq awaits new US sanctions on Iran.","why":"Iraq's dollar-denominated oil revenues and banking links with the US make its currency arrangements sensitive to US sanctions. Shifts away from the dollar affect trade settlement and regional financial flows.","category":"geopolitics","event_type":"geopolitics","importance":2,"flag":null,"market_moving":false,"location":{"place":"Najaf","country":"Iraq","lat":32.0,"lon":44.33,"region":"me"},"entities":[],"links":[],"source":{"name":"aawsat.com","url":"https://english.aawsat.com/arab-world/5309706-irans-qalibaf-urges-baghdad-break-economic-dependence-washington"},"sources":[{"name":"aawsat.com","url":"https://english.aawsat.com/arab-world/5309706-irans-qalibaf-urges-baghdad-break-economic-dependence-washington"}],"published_at":"2026-08-21T20:04:22Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"9c47adf2bc3f2d15","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-21T20:04:22Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-22T06:00:00Z","publisher_country_gdelt":"IZ","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/middle-east-city-skyline-66970.jpg","alt":"middle east city skyline (illustration)","credit":"GLady","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/mecca-mekkah-saudi-arabia-saudi-66970/"}}