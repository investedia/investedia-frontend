{"id":"n6caa3e466f","headline":"From April 1, Abkhazia fully relies on Enguri HPP electricity","summary":"Since April 1, the Georgian breakaway region of Abkhazia is being supplied with electricity entirely from the Enguri hydropower plant. The article compares this with last year's supply arrangements.","why":"The Enguri hydropower plant sits on the Georgia-Abkhazia border and is a major source of power for the region. Electricity supply arrangements shape energy costs and cross-border trade.","category":"economy","event_type":"energy-supply","importance":1,"flag":null,"market_moving":false,"location":{"place":"Enguri","country":"Georgia","lat":42.85,"lon":42.04,"region":"eu"},"entities":[],"links":[],"source":{"name":"Georgia Today","url":"https://georgiatoday.ge/from-april-1-abkhazia-fully-relies-on-enguri-hpp-electricity/"},"sources":[{"name":"Georgia Today","url":"https://georgiatoday.ge/from-april-1-abkhazia-fully-relies-on-enguri-hpp-electricity/"}],"published_at":"2026-04-02T08:48:44Z","retrieved_at":"2026-11-17T17:30:28Z","official":false,"ai_summary":true,"content_hash":"15494d42d6c53c4b","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T17:30:28Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-02T08:48:44Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-02T12:00:00Z","publisher_country_gdelt":"GG","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/hydroelectric-dam-2107948.jpg","alt":"hydroelectric dam (illustration)","credit":"egorshitikov","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/hoover-dam-nevada-hoover-dam-power-2107948/"}}