{"id":"n56fb96ab54","headline":"Romania Prepares for a new peak in electricity consumption. Bușoi: Import prices exceed €200 during peak hours","summary":"Romania faces no risk to electricity supply security, but a heatwave will push consumption above 7,000 MW and raise imports. Import prices exceed €200 during peak hours, according to Cristian Bușoi.","why":"Electricity import prices during peak demand affect household bills and industrial costs. Romania relies on imports when domestic generation is constrained.","category":"commodities","event_type":"energy-supply","importance":1,"flag":null,"market_moving":false,"location":{"place":"Bucharest","country":"Romania","lat":44.43,"lon":26.1,"region":"eu"},"entities":[],"links":[],"source":{"name":"Mediafax","url":"https://www.mediafax.ro/english/romania-prepares-for-a-new-peak-in-electricity-consumption-busoi-import-prices-exceed-e200-during-peak-hours-23792350"},"sources":[{"name":"Mediafax","url":"https://www.mediafax.ro/english/romania-prepares-for-a-new-peak-in-electricity-consumption-busoi-import-prices-exceed-e200-during-peak-hours-23792350"}],"published_at":"2026-08-18T11:32:42Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"24b87e3310a8faa5","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-18T11:32:42Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-18T12:00:00Z","publisher_country_gdelt":"RO","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/solar-panels-2814504.jpg","alt":"solar panels (illustration)","credit":"torstensimon","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/photovoltaic-solar-system-energy-2814504/"}}