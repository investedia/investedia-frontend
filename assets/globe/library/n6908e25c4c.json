{"id":"n6908e25c4c","headline":"IMF Approves $8.1B 4-Year Program for Ukraine, Releases $1.5B Immediately","summary":"The IMF approved a new $8.1 billion, 48-month program for Ukraine and cancelled the 2023 facility. An immediate $1.5 billion disbursement was unlocked.","why":"The International Monetary Fund lends to member countries under conditional programs, and its approval unlocks official financing and signals external support for their budgets.","category":"economy","event_type":"capital","importance":3,"flag":null,"market_moving":false,"location":{"place":"Kyiv","country":"Ukraine","lat":50.45,"lon":30.52,"region":"eu"},"entities":[],"links":[],"source":{"name":"Kyiv Post","url":"https://www.kyivpost.com/post/70892"},"sources":[{"name":"Kyiv Post","url":"https://www.kyivpost.com/post/70892"}],"published_at":"2026-02-27T11:37:26Z","retrieved_at":"2026-11-17T19:26:54Z","official":false,"ai_summary":true,"content_hash":"be8e8e189c381793","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T19:26:54Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-27T11:37:26Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-27T12:00:00Z","publisher_country_gdelt":"UP","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-628485.jpg","alt":"parliament government building (illustration)","credit":"Hermann","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/budapest-hungary-628485/"}}