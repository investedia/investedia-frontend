{"id":"n44f3586ba2","headline":"US Nasdaq Stock Market Representative Plans to Set Up Office at IDX","summary":"Nasdaq is set to open a representative office at the Indonesia Stock Exchange (BEI) in December 2026. The move is intended to strengthen market supervision capacity.","why":"Nasdaq is a major US exchange operator whose market surveillance and listing expertise can influence exchange standards in other markets. Indonesia's exchange is the country's principal securities marketplace.","category":"markets","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Jakarta","country":"Indonesia","lat":-6.209,"lon":106.846,"region":"asia"},"entities":[{"name":"Nasdaq","ticker":"NDAQ","kind":"company","asset":{"id":"EQ:XNAS:NDAQ","n":"Nasdaq","c":"equity","px":"NDAQ","la":40.714,"lo":-74.006,"geo":"sec-hq","co":"CO:CIK0001120193","m":"ticker+name","rv":"registry-v1"}},{"name":"Indonesia Stock Exchange","ticker":null,"kind":"company","unresolved":"no-ticker"}],"links":[],"source":{"name":"CNBC Indonesia","url":"https://www.cnbcindonesia.com/market/20261120211353-17-787138/perwakilan-bursa-saham-as-nasdaq-mau-berkantor-di-bei"},"sources":[{"name":"CNBC Indonesia","url":"https://www.cnbcindonesia.com/market/20261120211353-17-787138/perwakilan-bursa-saham-as-nasdaq-mau-berkantor-di-bei"}],"published_at":"2026-11-20T14:16:16Z","retrieved_at":"2026-11-20T14:37:27Z","official":false,"ai_summary":true,"score":0,"content_hash":"386a883579406697","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-20T14:37:27Z","backfill_provenance":{"version":"regional-backfill-v1","original_published_at":"2026-11-20T14:16:16Z","feed_url":"https://www.cnbcindonesia.com/market/rss"},"original_headline":"Perwakilan Bursa Saham AS Nasdaq Mau Berkantor di BEI","headline_translated":true}