{"id":"nd4e20a7838","headline":"Income Tax Foreign Assets Disclosure Scheme 2026: Who Can Declare Undisclosed Overseas Assets, Tax Rates and Deadlines","summary":"The Income Tax Department notified rules for the 2026 Foreign Assets of Small Taxpayers Disclosure Scheme. Eligible taxpayers can declare undisclosed overseas assets up to Rs 1 crore, or previously taxed assets up to Rs 5 crore, by paying specified tax or fees.","why":"Tax disclosure schemes allow taxpayers to regularise overseas holdings and bring undeclared wealth into the formal tax system.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/income-tax-foreign-assets-disclosure-scheme-2026-who-can-declare-undisclosed-overseas-assets-tax-rates-and-deadlines"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/income-tax-foreign-assets-disclosure-scheme-2026-who-can-declare-undisclosed-overseas-assets-tax-rates-and-deadlines"}],"published_at":"2026-08-15T10:50:04Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"a4ff1ecc4c2103a0","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-15T10:50:04Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-15T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-7881948.jpg","alt":"banknotes money (illustration)","credit":"Barta4","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/mo