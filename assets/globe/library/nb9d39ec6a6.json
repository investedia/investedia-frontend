{"id":"nb9d39ec6a6","headline":"Rupee rises 5 paise to 95.82 against dollar on equity gains, easing oil","summary":"The rupee rose 5 paise to 95.82 against the US dollar in early trade on Monday, after closing at 95.87 on Friday. Traders watched oil prices and foreign portfolio flows, and expected Reserve Bank of India intervention.","why":"The rupee's level against the dollar affects India's import costs, including crude oil, and foreign investor returns.","category":"markets","event_type":"other","importance":2,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.076,"lon":72.878,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Times of India","url":"https://timesofindia.indiatimes.com/business/india-business/rupee-rises-5-paise-to-95-82-against-dollar-on-equity-gains-easing-oil/articleshow/134380934.cms"},"sources":[{"name":"The Times of India","url":"https://timesofindia.indiatimes.com/business/india-business/rupee-rises-5-paise-to-95-82-against-dollar-on-equity-gains-easing-oil/articleshow/134380934.cms"}],"published_at":"2026-09-21T05:37:00Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"c66909e2c7d9a8f9","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-21T05:37:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-21T06:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-4122079.jpg","alt":"banknotes money (illustration)","credit":"_Alicja_","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/banknotes-the-currency-in-poland-4122079/"}}