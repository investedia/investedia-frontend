{"id":"n0043db5fcc","headline":"Uzbekistan targets three- to fourfold increase in local energy supplies","summary":"Uzbekistan aims to raise the value of locally produced goods and services used in energy investment projects three to four times from the $740 million recorded. The plan targets greater local content in energy investment.","why":"Local content requirements shape which suppliers win energy project contracts and how investment is distributed. They affect foreign and domestic contractors in energy projects.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Tashkent","country":"Uzbekistan","lat":41.3,"lon":69.24,"region":"asia"},"entities":[],"links":[],"source":{"name":"Trend.Az","url":"https://www.trend.az/casia/uzbekistan/4235762.html"},"sources":[{"name":"Trend.Az","url":"https://www.trend.az/casia/uzbekistan/4235762.html"}],"published_at":"2026-10-16T11:23:00Z","retrieved_at":"2026-11-17T12:11:23Z","official":false,"ai_summary":true,"content_hash":"428c1f4d70a9345e","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T12:11:23Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-10-16T11:23:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-10-16T12:00:00Z","publisher_country_gdelt":"UZ","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/power-plant-7644111.jpg","alt":"power plant (illustration)","credit":"Alexandra_Koch","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/blackout-power-failure-energy-crisis-7644111/"}}