{"id":"nd5ce29309d","headline":"Global power demand to accelerate in 2026 and 2027, IEA says","summary":"The International Energy Agency expects global electricity demand to grow 3.6% in 2026 and 3.8% in 2027, up from 3% in 2025. Renewables are expected to become the world's largest source of power generation in 2026.","why":"The IEA is the Paris-based energy agency advising major economies, and its demand forecasts shape investment in power generation, grids and energy equipment.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Paris","country":"France","lat":48.85,"lon":2.35,"region":"eu"},"entities":[],"links":[],"source":{"name":"Engineering News","url":"https://www.engineeringnews.co.za/article/global-power-demand-to-accelerate-in-2026-and-2027-iea-says-2026-07-23"},"sources":[{"name":"Engineering News","url":"https://www.engineeringnews.co.za/article/global-power-demand-to-accelerate-in-2026-and-2027-iea-says-2026-07-23"}],"published_at":"2026-07-23T08:47:00Z","retrieved_at":"2026-11-17T12:21:21Z","official":false,"ai_summary":true,"content_hash":"2c1d91fa0e7c7d3b","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T12:21:21Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-07-23T08:47:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-07-23T12:00:00Z","publisher_country_gdelt":"PK","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/power-plant-611668.jpg","alt":"power plant (illustration)","credit":"Foto-Rabe","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/industry-sunrise-fog-germany-611668/"}}