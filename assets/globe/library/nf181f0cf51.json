{"id":"nf181f0cf51","headline":"Monumental joins consortium to drill Maata prospect in Taranaki","summary":"Canada-listed explorer Monumental Energy plans to take an ownership interest in the Maata oil field through a consortium of four companies. The field is in New Zealand's onshore Taranaki Basin.","why":"Taranaki is New Zealand's main hydrocarbon province, and small-cap explorers taking stakes in onshore fields can add to the country's domestic gas and oil supply.","category":"companies","event_type":"m&a","importance":1,"flag":null,"market_moving":false,"location":{"place":"New Plymouth","country":"New Zealand","lat":-39.06,"lon":174.07,"region":"oc"},"entities":[],"links":[],"source":{"name":"Offshore Technology","url":"https://www.offshore-technology.com/news/monumental-drill-maata-prospect-taranaki/"},"sources":[{"name":"Offshore Technology","url":"https://www.offshore-technology.com/news/monumental-drill-maata-prospect-taranaki/"}],"published_at":"2026-10-15T07:58:35Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"42e224b67caabd58","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-10-15T07:58:35Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-10-15T12:00:00Z","publisher_country_gdelt":"NZ","description_from":"publisher page metadata"}}