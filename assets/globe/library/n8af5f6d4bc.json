{"id":"n8af5f6d4bc","headline":"Surplus Liquidity from FCNR(B) Inflows to Cut Bank Funding Costs by 50 Bps","summary":"Indian banks anticipate funding cost reductions of up to 50 basis points as surplus liquidity from FCNR(B) inflows grows. The inflows reduce their reliance on costlier certificates of deposit.","why":"Funding costs determine how profitably banks can lend. FCNR(B) deposits are foreign-currency accounts held by non-resident Indians in Indian banks.","category":"companies","event_type":"capital","importance":2,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.08,"lon":72.88,"region":"asia"},"entities":[],"links":[],"source":{"name":"Rediff","url":"https://www.rediff.com/business/report/fcnrb-inflows-indian-banks-anticipate-50-bps-funding-cost-reduction--liquidity-surge/20260906.htm"},"sources":[{"name":"Rediff","url":"https://www.rediff.com/business/report/fcnrb-inflows-indian-banks-anticipate-50-bps-funding-cost-reduction--liquidity-surge/20260906.htm"}],"published_at":"2026-09-06T13:46:51Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"241d82bb064613e6","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-06T13:46:51Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-06T18:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/bank-building-4174613.jpg","alt":"bank building (illustration)","credit":"SatyaPrem","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/bank-central-bank-finance-4174613/"}}