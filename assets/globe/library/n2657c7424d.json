{"id":"n2657c7424d","headline":"Romania shuts nuclear plant as Danube runs dry","summary":"Romania is shutting down its Cernavoda nuclear power plant due to record-low water levels in the Danube River. The closure removes a major source of domestic electricity supply.","why":"Cernavoda is Romania's only nuclear power station, and its output is a major part of national electricity generation. Plant outages can raise power imports and prices.","category":"commodities","event_type":"energy-supply","importance":2,"flag":null,"market_moving":false,"location":{"place":"Cernavoda","country":"Romania","lat":44.33,"lon":28.03,"region":"eu"},"entities":[],"links":[],"source":{"name":"easternriverinachronicle.com.au","url":"https://www.easternriverinachronicle.com.au/story/9330075/romania-shuts-nuclear-plant-as-danube-runs-dry/"},"sources":[{"name":"easternriverinachronicle.com.au","url":"https://www.easternriverinachronicle.com.au/story/9330075/romania-shuts-nuclear-plant-as-danube-runs-dry/"}],"published_at":"2026-08-13T10:51:02Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"99c9841d285ec4d6","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-13T10:51:02Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-13T12:00:00Z","publisher_country_gdelt":"RO","description_from":"publisher page metadata"}}