{"id":"n3315d549b9","headline":"Diesel Prices Hurting Truckers, Economy","summary":"US diesel prices have reached record highs above $8 per gallon, squeezing truckers. Companies could soon pass higher costs on to consumers, affecting grocery prices, while President Trump seeks solutions.","why":"Diesel is a core fuel for freight trucking, so its price feeds directly into transport costs and consumer prices. Fuel costs are a key driver of inflation in goods and food.","category":"commodities","event_type":"commodity-prices","importance":2,"flag":null,"market_moving":false,"location":{"place":"Washington, D.C.","country":"United States of America","lat":38.907,"lon":-77.037,"region":"na"},"entities":[],"links":[],"source":{"name":"Newstalk 1400, 104.5, and 105.9 WJMX","url":"https://newstalk1400online.iheart.com/content/2026-10-07-diesel-prices-hurting-truckers-economy/"},"sources":[{"name":"Newstalk 1400, 104.5, and 105.9 WJMX","url":"https://newstalk1400online.iheart.com/content/2026-10-07-diesel-prices-hurting-truckers-economy/"}],"published_at":"2026-10-07T21:48:00Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"d36d2da6f0f361ed","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-10-07T21:48:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-10-08T00:00:00Z","publisher_country_gdelt":"IR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/cargo-trucks-highway-534577.jpg","alt":"cargo trucks highway (illustration)","credit":"falco","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/semi-trailer-truck-road-follower-534577/"}}