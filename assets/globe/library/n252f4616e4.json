{"id":"n252f4616e4","headline":"India WPI Inflation Eases Marginally To 9.78% In July As Food Inflation Rises","summary":"India's wholesale price inflation eased marginally to 9.78% in July from 9.87% in June, led by lower fuel and power inflation. The WPI food index rose to 6.65%.","why":"Wholesale price inflation is a leading indicator of consumer inflation and shapes the Reserve Bank of India's interest rate decisions.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/india-wpi-inflation-eases-marginally-to-978-in-july-as-food-inflation-rises"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/india-wpi-inflation-eases-marginally-to-978-in-july-as-food-inflation-rises"}],"published_at":"2026-08-14T08:17:46Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"3249bba3140ac2ac","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-14T08:17:46Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-14T09:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-1517315.jpg","alt":"banknotes money (illustration)","credit":"webandi","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/euro-clothes-line-clothespins-1517315/"}}