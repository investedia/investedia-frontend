{"id":"n9214ee2d43","headline":"Kenya: MPs Pass Bill Barring Hospitals From Demanding Upfront Payments, Detaining Patients Over Unpaid Bills","summary":"Kenya's National Assembly passed legislation that would end hospitals demanding upfront payment before emergency treatment. The bill also bars detaining patients or bodies over unpaid bills.","why":"The bill would change how private and public hospitals in Kenya collect payment, affecting healthcare operators and insurers.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Nairobi","country":"Kenya","lat":-1.29,"lon":36.82,"region":"af"},"entities":[],"links":[],"source":{"name":"allAfrica.com","url":"https://allafrica.com/stories/202611120044.html"},"sources":[{"name":"allAfrica.com","url":"https://allafrica.com/stories/202611120044.html"}],"published_at":"2026-11-12T05:23:18Z","retrieved_at":"2026-11-12T13:59:53Z","official":false,"ai_summary":true,"content_hash":"409da975e11ec9e5","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T13:59:53Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-11-12T05:23:18Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-11-12T07:00:00Z","publisher_country_gdelt":"KE","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-5180626.jpg","alt":"parliament government building (illustration)","credit":"Endzeiter","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/the-european-parliament-in-strasbourg-5180626/"}}