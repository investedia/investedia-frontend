{"id":"n7e3795a8ac","headline":"Australia's battery boom is killing the trade everyone rushed into","summary":"Australia has periods of so much solar power that electricity prices fall below zero. Battery operators can be paid to charge and then sell the stored power.","why":"Grid-scale batteries earn revenue from price spreads between cheap midday solar and expensive evening power, so price shifts change their returns.","category":"economy","event_type":"other","importance":1,"flag":null,"market_moving":false,"location":{"place":"Sydney","country":"Australia","lat":-33.87,"lon":151.21,"region":"oc"},"entities":[],"links":[],"source":{"name":"Investment Watch Blog","url":"https://www.investmentwatchblog.com/australias-battery-boom-is-killing-the-trade-everyone-rushed-into/"},"sources":[{"name":"Investment Watch Blog","url":"https://www.investmentwatchblog.com/australias-battery-boom-is-killing-the-trade-everyone-rushed-into/"}],"published_at":"2026-11-16T17:41:55Z","retrieved_at":"2026-11-16T20:28:33Z","official":false,"ai_summary":true,"content_hash":"b97ce606ba71c7f3","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-16T20:28:33Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-11-16T17:41:55Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-11-16T18:00:00Z","publisher_country_gdelt":"AS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/solar-panels-4045029.jpg","alt":"solar panels (illustration)","credit":"Bru-nO","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/solar-cell-solar-panel-photovoltaic-4045029/"}}