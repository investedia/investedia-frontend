{"id":"nd071f7d9d5","headline":"US strikes Iran in response to attack on cargo ship in Strait of Hormuz","summary":"The US military attacked Iran on Friday in response to an Iranian drone strike on a cargo ship in the Strait of Hormuz. The strikes follow a ceasefire dispute between the two countries.","why":"The Strait of Hormuz is a key route for global oil shipments, so attacks there tend to affect crude prices and shipping costs.","category":"geopolitics","event_type":"geopolitics","importance":3,"flag":null,"market_moving":true,"location":{"place":"Strait of Hormuz","country":"Iran","lat":26.6,"lon":56.3,"region":"me"},"entities":[],"links":[],"source":{"name":"Yahoo News","url":"https://www.yahoo.com/news/world/articles/iran-insists-control-shipping-strait-104430306.html"},"sources":[{"name":"Yahoo News","url":"https://www.yahoo.com/news/world/articles/iran-insists-control-shipping-strait-104430306.html"}],"published_at":"2026-06-27T03:09:21Z","retrieved_at":"2026-11-17T13:38:59Z","official":false,"ai_summary":true,"content_hash":"1c00cab1bb82deec","impacts":[],"why_moved":"A drone strike on a cargo ship in the Strait of Hormuz followed by US military action raises supply-risk concerns for oil shipments through a key chokepoint.","backfilled":true,"backfilled_at":"2026-11-17T13:38:59Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-27T03:09:21Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-26T12:00:00Z","publisher_country_gdelt":"IR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-tanker-ship-6880466.jpg","alt":"oil tanker ship (illustration)","credit":"zzkonst","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/tanker-vessel-nautical-transport-6880466/"}}