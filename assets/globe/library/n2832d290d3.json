{"id":"n2832d290d3","headline":"Ukraine's National Bank to withdraw 1, 2, 5, 10 hryvnia banknotes issued in 2003–2007 from circulation as of March 2","summary":"Banknotes of 1, 2, 5 and 10 hryvnias issued in 2003 to 2007 will be replaced by coins and will no longer be legal tender from March 2, 2026, the National Bank of Ukraine said.","why":"The National Bank of Ukraine issues the hryvnia and manages its cash circulation, so changes to legal tender affect currency handling across the economy.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Kyiv","country":"Ukraine","lat":50.45,"lon":30.523,"region":"eu"},"entities":[],"links":[],"source":{"name":"Interfax-Ukraine","url":"https://en.interfax.com.ua/news/economic/1146170.html"},"sources":[{"name":"Interfax-Ukraine","url":"https://en.interfax.com.ua/news/economic/1146170.html"}],"published_at":"2026-02-20T17:36:23Z","retrieved_at":"2026-11-17T19:26:54Z","official":false,"ai_summary":true,"content_hash":"ec24658534cc1dd9","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T19:26:54Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-20T17:36:23Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-20T18:00:00Z","publisher_country_gdelt":"UP","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-1726618.jpg","alt":"banknotes money (illustration)","credit":"stevepb","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/coins-banknotes-money-currency-1726618/"}}