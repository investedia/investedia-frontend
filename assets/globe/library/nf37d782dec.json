{"id":"nf37d782dec","headline":"Nubank will be able to operate as a bank in Brazil","summary":"Brazil's central bank approved Nu's acquisition of Banco Porto Real de Investimentos, an operation announced in July. The deal will give the company a banking license in Brazil.","why":"Nubank is Latin America's largest digital bank by customers, and a banking license lets it offer a wider range of financial services directly. Investors watch its regulatory progress as a measure of growth and capital position.","category":"companies","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"São Paulo","country":"Brazil","lat":-23.55,"lon":-46.63,"region":"latam"},"entities":[{"name":"Nu Holdings","ticker":"NU","kind":"company","sym":"NU","asset":{"id":"EQ:XNYS:NU","n":"Nu Holdings","c":"equity","px":"NU","la":-22.908281958028578,"lo":-47.39414244806463,"geo":"markets","site":"NU","co":"CO:CIK0001691493","m":"ticker+name","rv":"registry-v1"}},{"name":"Banco Porto Real de Investimentos","ticker":null,"kind":"company","unresolved":"no-ticker"}],"links":[],"source":{"name":"El Economista","url":"https://www.eleconomista.com.mx/sectorfinanciero/nubank-podra-ejercer-banco-brasil-20261116-844286.html"},"sources":[{"name":"El Economista","url":"https://www.eleconomista.com.mx/sectorfinanciero/nubank-podra-ejercer-banco-brasil-20261116-844286.html"}],"published_at":"2026-11-17T05:37:29Z","retrieved_at":"2026-11-17T08:44:24Z","official":false,"ai_summary":true,"score":0,"content_hash":"72c3bd8555e1f7dd","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T08:44:24Z","backfill_provenance":{"version":"regional-backfill-v1","original_published_at":"2026-11-17T05:37:29Z","feed_url":"https://www.eleconomista.com.mx/rss/ultimas-noticias"},"original_headline":"Nubank podrá ejercer como banco en Brasil","headline_translated":true}