{"id":"n54344b3f23","headline":"Economists raise GDP growth forecast to 5.0% for 2026: MAS survey","summary":"Economists sharply raised Singapore's 2026 growth forecast to 5%, from 3.5%, after a strong tech cycle lifted first-half performance. The economy grew 5.9% year-on-year in the second quarter.","why":"The Monetary Authority of Singapore's survey of economists tracks expectations for the city-state's growth, a key input for its currency and monetary policy settings. Singapore is a major Asian financial and trade hub.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Singapore","country":"Singapore","lat":1.352,"lon":103.82,"region":"asia"},"entities":[],"links":[],"source":{"name":"CNA","url":"https://www.channelnewsasia.com/watch/economists-raise-gdp-growth-forecast-50-2026-mas-survey-6358156"},"sources":[{"name":"CNA","url":"https://www.channelnewsasia.com/watch/economists-raise-gdp-growth-forecast-50-2026-mas-survey-6358156"}],"published_at":"2026-09-02T17:14:00Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"0e62de1d4bc2087f","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-02T17:14:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-02T18:00:00Z","publisher_country_gdelt":"SN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/city-skyline-business-district-4013068.jpg","alt":"city skyline business district (illustration)","credit":"angel4leon","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/buildings-road-street-avenue-4013068/"}}