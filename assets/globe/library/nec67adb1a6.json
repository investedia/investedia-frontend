{"id":"nec67adb1a6","headline":"The 'stealthy' price-setter of Australian energy bills","summary":"An article argues that Australians paying more for power should look at pricey gas and energy market dynamics. It describes gas as a stealthy price-setter for electricity.","why":"Gas is a marginal price-setter in Australia's wholesale electricity market, so gas costs flow through to household and business power bills.","category":"commodities","event_type":"energy-supply","importance":1,"flag":null,"market_moving":false,"location":{"place":"Sydney","country":"Australia","lat":-33.87,"lon":151.21,"region":"oc"},"entities":[],"links":[],"source":{"name":"sconeadvocate.com.au","url":"https://www.sconeadvocate.com.au/story/9182559/the-stealthy-price-setter-of-australian-energy-bills/"},"sources":[{"name":"sconeadvocate.com.au","url":"https://www.sconeadvocate.com.au/story/9182559/the-stealthy-price-setter-of-australian-energy-bills/"}],"published_at":"2026-02-24T16:31:02Z","retrieved_at":"2026-11-17T19:26:54Z","official":false,"ai_summary":true,"content_hash":"fed6483269105def","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T19:26:54Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-24T16:31:02Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-24T18:00:00Z","publisher_country_gdelt":"AS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/gas-pipeline-6529742.jpg","alt":"gas pipeline (illustration)","credit":"tasukaran","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/factory-industrial-manufacturer-6529742/"}}