{"id":"n745458afe0","headline":"Malaysia’s capital market grows to 4.3 trillion ringgit","summary":"Malaysia's securities regulator said the capital market expanded to 4.3 trillion ringgit. The gain was mainly driven by higher corporate bond issuance and growth in fund management assets.","why":"Malaysia's capital market covers bond issuance, equity listings and fund management that channel financing to companies. Its size indicates the depth of domestic funding sources.","category":"markets","event_type":"macro-data","importance":1,"flag":null,"market_moving":false,"location":{"place":"Kuala Lumpur","country":"Malaysia","lat":3.139,"lon":101.687,"region":"asia"},"entities":[],"links":[],"source":{"name":"Asia Asset Management","url":"https://www.asiaasset.com/equities/malaysias-capital-market-grows-2-4-to-4-3-trillion-ringgit-in-2025-regulator-cites-resilience-amid-volatility/"},"sources":[{"name":"Asia Asset Management","url":"https://www.asiaasset.com/equities/malaysias-capital-market-grows-2-4-to-4-3-trillion-ringgit-in-2025-regulator-cites-resilience-amid-volatility/"}],"published_at":"2026-04-22T16:01:00Z","retrieved_at":"2026-11-17T16:57:23Z","official":false,"ai_summary":true,"content_hash":"136c74e574ee9c3f","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T16:57:23Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-04-22T16:01:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-04-22T18:00:00Z","publisher_country_gdelt":"SN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/stock-exchange-building-264381.jpg","alt":"stock exchange building (illustration)","credit":"harpsandflowers","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/wall-street-street-sign-roadworks-264381/"}}