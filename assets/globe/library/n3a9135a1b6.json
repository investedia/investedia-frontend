{"id":"n3a9135a1b6","headline":"Ethiopia Formally Pledges Equal Treatment In Ongoing Debt Restructuring Talks","summary":"The Ethiopian government formally affirmed that all external creditors should be equally treated under the Official Creditor Committee framework. The pledge comes during ongoing debt restructuring talks.","why":"Debt restructuring determines how a sovereign's external obligations are reshaped with official and private lenders. Equal creditor treatment is a central principle for bondholders and official lenders.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Addis Ababa","country":"Ethiopia","lat":9.03,"lon":38.74,"region":"af"},"entities":[],"links":[],"source":{"name":"The Reporter Ethiopia","url":"https://www.thereporterethiopia.com/50878/"},"sources":[{"name":"The Reporter Ethiopia","url":"https://www.thereporterethiopia.com/50878/"}],"published_at":"2026-05-28T08:41:02Z","retrieved_at":"2026-11-17T15:49:20Z","official":false,"ai_summary":true,"content_hash":"ed77b9702c72940c","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:49:20Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-05-28T08:41:02Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-05-28T12:00:00Z","publisher_country_gdelt":"ET","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/african-market-1493905.jpg","alt":"african market (illustration)","credit":"Couleur","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/berries-blueberries-raspberries-1493905/"}}