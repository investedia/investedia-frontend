{"id":"nb62aae5bb9","headline":"57,000 cars face deregistration","summary":"About 57,000 vehicles are set to be removed from the National Vehicle Register after remaining inactive for more than five years. The move is expected to address non-compliance and lost government revenue.","why":"Vehicle registration fees and licensing are a source of government revenue, and register clean-up affects tax collection and vehicle-related business.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Lusaka","country":"Zambia","lat":-15.387,"lon":28.323,"region":"af"},"entities":[],"links":[],"source":{"name":"Times of Zambia","url":"https://times.co.zm/57000-cars-face-deregistration/"},"sources":[{"name":"Times of Zambia","url":"https://times.co.zm/57000-cars-face-deregistration/"}],"published_at":"2026-09-17T06:16:46Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"492d1a72543f5bca","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-17T06:16:46Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-17T12:00:00Z","publisher_country_gdelt":"ZA","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/cargo-trucks-highway-3578297.jpg","alt":"cargo trucks highway (illustration)","credit":"ElyPenner","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/peterbilt-truck-tractor-tanker-3578297/"}}