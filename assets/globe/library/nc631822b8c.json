{"id":"nc631822b8c","headline":"Vessel Attacked In Strait Of Hormuz","summary":"A vessel attack in the Strait of Hormuz on Sunday killed one person and injured three, heightening fears over oil supplies. It follows a Saudi pipeline closure after a drone attack.","why":"The Strait of Hormuz carries a large share of global seaborne oil, so attacks there quickly affect crude prices and shipping costs.","category":"commodities","event_type":"energy-supply","importance":3,"flag":null,"market_moving":true,"location":{"place":"Strait of Hormuz","country":"Iran","lat":26.6,"lon":56.3,"region":"me"},"entities":[],"links":[],"source":{"name":"News Radio 830 KHVH","url":"https://khvhradio.iheart.com/content/2026-09-13-vessel-attacked-in-strait-of-hormuz/"},"sources":[{"name":"News Radio 830 KHVH","url":"https://khvhradio.iheart.com/content/2026-09-13-vessel-attacked-in-strait-of-hormuz/"}],"published_at":"2026-09-13T10:53:00Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"d01ed77b63cac7c3","impacts":[],"why_moved":"A vessel attack in the Strait of Hormuz and a Saudi pipeline closure after a drone attack raised fears of reduced oil supply.","backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-13T10:53:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-13T12:00:00Z","publisher_country_gdelt":"IZ","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-tanker-ship-7240023.jpg","alt":"oil tanker ship (illustration)","credit":"dendoktoor","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/cargo-ship-seagoing-vessel-7240023/"}}