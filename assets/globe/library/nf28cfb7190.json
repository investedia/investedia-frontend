{"id":"nf28cfb7190","headline":"No immediate need for broad stimulus package, says Bank Negara","summary":"Bank Negara Malaysia said there is no immediate need for a broad stimulus package. Any government support must be targeted and based on a fuller assessment of the Middle East conflict's economic fallout.","why":"Bank Negara is Malaysia's central bank, and its policy views shape expectations for interest rates and fiscal support. Targeted versus broad stimulus choices affect domestic growth and inflation outlooks.","category":"economy","event_type":"other","importance":2,"flag":null,"market_moving":false,"location":{"place":"Kuala Lumpur","country":"Malaysia","lat":3.14,"lon":101.69,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Malaysia Today | FMT","url":"https://www.freemalaysiatoday.com/category/nation/2026/03/31/no-immediate-need-for-broad-stimulus-package-says-bank-negara"},"sources":[{"name":"Free Malaysia Today | FMT","url":"https://www.freemalaysiatoday.com/category/nation/2026/03/31/no-immediate-need-for-broad-stimulus-package-says-bank-negara"}],"published_at":"2026-03-31T05:01:58Z","retrieved_at":"2026-11-17T18:10:56Z","official":false,"ai_summary":true,"content_hash":"9a5812e9f548d977","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T18:10:56Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-03-31T05:01:58Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-03-31T06:00:00Z","publisher_country_gdelt":"MY","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/central-bank-building-4584690.jpg","alt":"central bank building (illustration)","credit":"Makalu","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/tajikistan-iskanderkul-alexandersee-4584690/"}}