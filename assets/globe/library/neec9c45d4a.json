{"id":"neec9c45d4a","headline":"₹1,600-1,700 crore a day: Cost of insulating India from global energy shock","summary":"State-owned Indian oil companies are spending about ₹1,600-1,700 crore a day, over ₹1 lakh crore in 10 weeks, to shield consumers from the global energy shock. Ever-widening losses are raising questions about how long they can keep absorbing the cost.","why":"State-run oil marketing companies in India set or cushion retail fuel prices, so their losses reflect how global crude price spikes are passed on to consumers and the government.","category":"commodities","event_type":"commodity-prices","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"BusinessLine","url":"https://www.thehindubusinessline.com/news/national/1600-1700-crore-a-day-cost-of-insulating-india-from-global-energy-shock/article70961952.ece"},"sources":[{"name":"BusinessLine","url":"https://www.thehindubusinessline.com/news/national/1600-1700-crore-a-day-cost-of-insulating-india-from-global-energy-shock/article70961952.ece"}],"published_at":"2026-05-10T09:32:46Z","retrieved_at":"2026-11-17T16:23:27Z","official":false,"ai_summary":true,"content_hash":"7792dc15c11439cf","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T16:23:27Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-05-10T09:32:46Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-05-10T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-6951382.jpg","alt":"oil refinery (illustration)","credit":"tasukaran","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/factory-industrial-urban-6951382/"}}