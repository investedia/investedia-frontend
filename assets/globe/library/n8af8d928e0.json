{"id":"n8af8d928e0","headline":"Employers can now claim ITC on group health, life insurance for staff","summary":"The GST Council has announced that input tax credit will be available on health and life insurance policies that employers provide to staff. The move is expected to significantly reduce business costs, especially for MSMEs.","why":"The GST Council sets indirect tax rules across India, so changes to input tax credit directly affect companies' input costs and tax treatment of employee benefits.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.614,"lon":77.209,"region":"asia"},"entities":[],"links":[],"source":{"name":"Rediff","url":"https://www.rediff.com/business/report/gst-council-allows-input-tax-credit-on-employee-group-health-and-life-insurance/20261009.htm"},"sources":[{"name":"Rediff","url":"https://www.rediff.com/business/report/gst-council-allows-input-tax-credit-on-employee-group-health-and-life-insurance/20261009.htm"}],"published_at":"2026-10-09T09:42:21Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"ad1af3b46853cdf7","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-10-09T09:42:21Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-10-09T12:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-51058.jpg","alt":"parliament government building (illustration)","credit":"PeterDargatz","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/architecture-building-landmark-51058/"}}