{"id":"n12da957703","headline":"Iran Ties Hormuz Reopening to US Concessions on Several Demands","summary":"Iran said it was nearing a final pact with Oman on new shipping lanes through the Strait of Hormuz. It said the US must meet other conditions, including compensation and an end to sanctions and military threats, before reopening the waterway.","why":"The Strait of Hormuz is a major oil and LNG transit route, so its reopening status directly affects global energy supply.","category":"geopolitics","event_type":"geopolitics","importance":3,"flag":null,"market_moving":false,"location":{"place":"Tehran","country":"Iran","lat":35.69,"lon":51.39,"region":"me"},"entities":[],"links":[],"source":{"name":"gCaptain","url":"https://gcaptain.com/iran-ties-hormuz-reopening-to-us-concessions-on-several-demands/"},"sources":[{"name":"gCaptain","url":"https://gcaptain.com/iran-ties-hormuz-reopening-to-us-concessions-on-several-demands/"}],"published_at":"2026-08-10T08:18:00Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"e2f62f0452e94ca3","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-10T08:18:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-10T12:00:00Z","publisher_country_gdelt":"SA","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-tanker-ship-164818.jpg","alt":"oil tanker ship (illustration)","credit":"12019","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/amsterdam-ship-bay-harbor-port-164818/"}}