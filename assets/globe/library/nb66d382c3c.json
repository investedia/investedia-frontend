{"id":"nb66d382c3c","headline":"Baghdad Traders Protest New Tariffs Amid Iraq’s Declining Oil Revenue","summary":"Hundreds of traders and customs clearance company owners protested in Baghdad against new customs tariffs. The tariffs, introduced January 1, aim to combat national debt amid declining oil revenues.","why":"Iraq depends heavily on oil revenue to fund its budget, so changes in customs tariffs and public finances affect importers, trade flows and government debt.","category":"economy","event_type":"trade","importance":1,"flag":null,"market_moving":false,"location":{"place":"Baghdad","country":"Iraq","lat":33.31,"lon":44.36,"region":"me"},"entities":[],"links":[],"source":{"name":"El-Balad.com","url":"https://www.el-balad.com/6847292"},"sources":[{"name":"El-Balad.com","url":"https://www.el-balad.com/6847292"}],"published_at":"2026-02-09T11:25:04Z","retrieved_at":"2026-11-17T20:10:53Z","official":false,"ai_summary":true,"content_hash":"8698f8c1aa360b79","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T20:10:53Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-02-09T11:25:04Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-02-09T12:00:00Z","publisher_country_gdelt":"IZ","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/container-port-6779968.jpg","alt":"container port (illustration)","credit":"Manuel-H","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/container-ship-hamburgers-stick-6779968/"}}