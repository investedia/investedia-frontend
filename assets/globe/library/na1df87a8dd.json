{"id":"na1df87a8dd","headline":"RON97, unsubsidised RON95 and diesel down 5 sen","summary":"Prices for RON97, unsubsidised RON95 and diesel will fall by 5 sen, effective until September 9. The adjustment applies to fuel prices in Malaysia.","why":"Fuel prices feed directly into transport costs, inflation and consumer spending. Malaysia periodically adjusts pump prices for fuel types that are not subsidised.","category":"economy","event_type":"commodity-prices","importance":1,"flag":null,"market_moving":false,"location":{"place":"Kuala Lumpur","country":"Malaysia","lat":3.14,"lon":101.69,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Malaysia Today | FMT","url":"https://www.freemalaysiatoday.com/category/nation/2026/09/02/ron97-unsubsidised-ron95-and-diesel-down-5-sen"},"sources":[{"name":"Free Malaysia Today | FMT","url":"https://www.freemalaysiatoday.com/category/nation/2026/09/02/ron97-unsubsidised-ron95-and-diesel-down-5-sen"}],"published_at":"2026-09-02T10:48:00Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"e8929ce47a3326db","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-02T10:48:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-02T12:00:00Z","publisher_country_gdelt":"CH","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-1584098.jpg","alt":"oil refinery (illustration)","credit":"12019","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/port-arthur-texas-night-evening-1584098/"}}