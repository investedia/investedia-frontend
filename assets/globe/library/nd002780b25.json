{"id":"nd002780b25","headline":"Indias June vegetable oil imports fall 29 pc on shrinking palm oil discount: SEA","summary":"India's vegetable oil imports fell 29 percent year on year in June to 11.46 lakh tonnes, the lowest since the start of the current oil year. Palm oil was available at a smaller discount.","why":"India is one of the world's largest edible oil importers, so its import volumes affect global palm and soyoil demand. Discounts on palm oil influence buying decisions.","category":"commodities","event_type":"commodity-prices","importance":1,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.614,"lon":77.209,"region":"asia"},"entities":[],"links":[],"source":{"name":"Daily Excelsior","url":"https://www.dailyexcelsior.com/indias-june-vegetable-oil-imports-fall-29-pc-on-shrinking-palm-oil-discount-sea/"},"sources":[{"name":"Daily Excelsior","url":"https://www.dailyexcelsior.com/indias-june-vegetable-oil-imports-fall-29-pc-on-shrinking-palm-oil-discount-sea/"}],"published_at":"2026-07-14T10:32:03Z","retrieved_at":"2026-11-17T13:01:10Z","official":false,"ai_summary":true,"content_hash":"d029e8a1298313b1","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:01:10Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-07-14T10:32:03Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-07-14T12:00:00Z","publisher_country_gdelt":"MY","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/palm-oil-plantation-287878.jpg","alt":"palm oil plantation (illustration)","credit":"sarangib","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/oil-palm-tree-plantation-287878/"}}