{"id":"n15d3c5d805","headline":"India’s dollar deposit scheme may generate Rs 5 lakh crore notional profit for banks: Report","summary":"The FCNR(B) deposit scheme mobilised $127 billion in under three months, according to an SBI Research report. The report estimates a notional profit of about Rs 5 trillion for banks over five years, plus Rs 0.5 trillion for the RBI.","why":"FCNR(B) deposits are foreign-currency deposits held by non-resident Indians with Indian banks, and their pricing and flows affect bank margins and rupee liquidity.","category":"economy","event_type":"other","importance":2,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.614,"lon":77.209,"region":"asia"},"entities":[],"links":[],"source":{"name":"IANS News","url":"https://ianslive.in/indias-dollar-deposit-scheme-may-generate-rs-5-lakh-crore-notional-profit-for-banks-report--20260919092000"},"sources":[{"name":"IANS News","url":"https://ianslive.in/indias-dollar-deposit-scheme-may-generate-rs-5-lakh-crore-notional-profit-for-banks-report--20260919092000"}],"published_at":"2026-09-19T03:52:40Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"84957b32f939a47f","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-19T03:52:40Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-19T06:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/bank-building-4174613.jpg","alt":"bank building (illustration)","credit":"SatyaPrem","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/bank-central-bank-finance-4174613/"}}