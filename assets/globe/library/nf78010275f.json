{"id":"nf78010275f","headline":"High-Net-Worth Individual Population in India Reaches 390,000 in 2025","summary":"India's high-net-worth individual population grew 3% year on year in 2025 to nearly 390,000. Their combined financial wealth rose 4.6% to about $1.64 trillion, per the World Wealth Report 2026 by Capgemini.","why":"Wealth concentration among high-net-worth individuals drives demand for private banking, asset management and luxury goods. Capgemini's World Wealth Report is a widely cited benchmark for global wealth trends.","category":"economy","event_type":"macro-data","importance":1,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.614,"lon":77.209,"region":"asia"},"entities":[],"links":[],"source":{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/high-net-worth-individual-population-in-india-reaches-390000-in-2025"},"sources":[{"name":"Free Press Journal","url":"https://www.freepressjournal.in/business/high-net-worth-individual-population-in-india-reaches-390000-in-2025"}],"published_at":"2026-06-04T11:37:35Z","retrieved_at":"2026-11-17T15:20:22Z","official":false,"ai_summary":true,"content_hash":"6de28c0f3522650c","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:20:22Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-04T11:37:35Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-04T12:00:00Z","publisher_country_gdelt":"CH","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/city-skyline-business-district-3459422.jpg","alt":"city skyline business district (illustration)","credit":"Leslin_Liu","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/shanghai-city-night-landscape-3459422/"}}