{"id":"nd8496bb70a","headline":"Kyrgyzstan Fertilizer Plant Opens With $260 Million Chinese Investment","summary":"A fertilizer plant backed by $260 million in Chinese investment has opened in Kyrgyzstan's Osh region. Planned capacity far exceeds domestic demand.","why":"Fertilizer producers supply nitrogen and phosphate inputs to agriculture, so capacity changes affect farm costs and export potential. Chinese capital in Central Asian industry is a growing investment theme.","category":"companies","event_type":"capital","importance":1,"flag":null,"market_moving":false,"location":{"place":"Osh","country":"Kyrgyzstan","lat":40.53,"lon":72.8,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Times Of Central Asia","url":"https://timesca.com/kyrgyzstan-fertilizer-plant-chinese-investment/"},"sources":[{"name":"The Times Of Central Asia","url":"https://timesca.com/kyrgyzstan-fertilizer-plant-chinese-investment/"}],"published_at":"2026-09-01T13:13:25Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"a5d75f16f87f4831","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-01T13:13:25Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-01T18:00:00Z","publisher_country_gdelt":"KG","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/factory-workers-9694146.jpg","alt":"factory workers (illustration)","credit":"Sergey2025","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/worker-employee-company-factory-9694146/"}}