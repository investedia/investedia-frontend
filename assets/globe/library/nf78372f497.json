{"id":"nf78372f497","headline":"Azerbaijan proposes $3.5B state guarantee limit for 2027 budget","summary":"The draft 2027 state budget law sets the state guarantee limit at 6 billion manat, about $3.5 billion. The proposal was reported from Baku.","why":"State guarantees are government backing for loans, so their limit affects the country's contingent public liabilities.","category":"economy","event_type":"macro-data","importance":1,"flag":null,"market_moving":false,"location":{"place":"Baku","country":"Azerbaijan","lat":40.409,"lon":49.867,"region":"eu"},"entities":[],"links":[],"source":{"name":"Trend.Az","url":"https://www.trend.az/azerbaijan/4246946.html"},"sources":[{"name":"Trend.Az","url":"https://www.trend.az/azerbaijan/4246946.html"}],"published_at":"2026-11-16T10:46:52Z","retrieved_at":"2026-11-16T16:00:23Z","official":false,"ai_summary":true,"content_hash":"12d754b2585b10a2","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-16T16:00:23Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-11-16T10:46:52Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-11-16T12:00:00Z","publisher_country_gdelt":"AJ","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-1319648.jpg","alt":"parliament government building (illustration)","credit":"Pixabay","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/berlin-bundestag-parliament-1319648/"}}