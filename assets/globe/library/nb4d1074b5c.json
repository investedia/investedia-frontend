{"id":"nb4d1074b5c","headline":"US and allies push IAEA board to report Iran to UN Security Council, diplomats say","summary":"The US and allies are pushing the IAEA board to refer Iran to the UN Security Council, diplomats say. Iran is the only non-nuclear-weapon state enriching uranium to 60%, which the IAEA calls a serious concern.","why":"The IAEA is the UN nuclear watchdog, and Security Council referrals can lead to sanctions that affect oil exports and global markets.","category":"geopolitics","event_type":"geopolitics","importance":2,"flag":null,"market_moving":false,"location":{"place":"Vienna","country":"Austria","lat":48.21,"lon":16.37,"region":"eu"},"entities":[],"links":[],"source":{"name":"CNA","url":"https://www.channelnewsasia.com/asia/us-iaea-report-iran-un-security-council-6363371"},"sources":[{"name":"CNA","url":"https://www.channelnewsasia.com/asia/us-iaea-report-iran-un-security-council-6363371"}],"published_at":"2026-09-04T17:35:00Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"d5f7edc900a0f458","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-04T17:35:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-04T18:00:00Z","publisher_country_gdelt":"IR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-5180626.jpg","alt":"parliament government building (illustration)","credit":"Endzeiter","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/the-european-parliament-in-strasbourg-5180626/"}}