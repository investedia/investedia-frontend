{"id":"nbb37467c20","headline":"TAJ to discontinue use of cheques by March 2028","summary":"The Tax Administration Jamaica will phase out cheques by March 2028, starting September 1, 2026, in line with Bank of Jamaica and commercial bank procedures. The change first applies to government entities and manager's cheques of $1 million or more.","why":"Phasing out cheques shifts payments to electronic systems, which affects banks' payment operations and businesses' tax settlement processes.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Kingston","country":"Jamaica","lat":17.97,"lon":-76.79,"region":"latam"},"entities":[],"links":[],"source":{"name":"jamaica-gleaner.com","url":"https://jamaica-gleaner.com/article/news/20260806/taj-discontinue-use-cheques-march-2028"},"sources":[{"name":"jamaica-gleaner.com","url":"https://jamaica-gleaner.com/article/news/20260806/taj-discontinue-use-cheques-march-2028"}],"published_at":"2026-08-05T17:15:02Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"ae0dd1aca7ed15d7","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-05T17:15:02Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-05T18:00:00Z","publisher_country_gdelt":"JM","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/bank-building-5148454.jpg","alt":"bank building (illustration)","credit":"suju-foto","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/flow-water-nature-landscape-trees-5148454/"}}