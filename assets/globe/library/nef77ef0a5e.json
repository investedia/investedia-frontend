{"id":"nef77ef0a5e","headline":"Ministry of Finance launches a new Fidelis edition, with interest rates of up to 7.60%","summary":"The Ministry of Finance will sell a new Fidelis edition between June 15 and 22, 2026, offering non-taxable interest of up to 7.60% on lei issues and up to 6.80% on euro issues. Two special tranches are also planned.","why":"Government savings bonds are a debt-funding tool for the Romanian state, and their rates signal the cost of domestic sovereign borrowing to households and investors.","category":"economy","event_type":"capital","importance":1,"flag":null,"market_moving":false,"location":{"place":"Bucharest","country":"Romania","lat":44.43,"lon":26.1,"region":"eu"},"entities":[],"links":[],"source":{"name":"Stiripesurse","url":"https://www.stiripesurse.ro/ministry-of-finance-launches-a-new-fidelis-edition-with-interest-rates-of-up-to-760_3893533"},"sources":[{"name":"Stiripesurse","url":"https://www.stiripesurse.ro/ministry-of-finance-launches-a-new-fidelis-edition-with-interest-rates-of-up-to-760_3893533"}],"published_at":"2026-06-09T17:33:50Z","retrieved_at":"2026-11-17T15:20:22Z","official":false,"ai_summary":true,"content_hash":"0c496a94d2c27932","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:20:22Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-09T17:33:50Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-09T18:00:00Z","publisher_country_gdelt":"RO","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-1339781.jpg","alt":"banknotes money (illustration)","credit":"Alexas_Fotos","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/time-is-money-money-calms-down-sleep-1339781/"}}