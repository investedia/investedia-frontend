{"id":"n9f51535bc0","headline":"Court Lets Sh5tn National Infrastructure Fund Proceed Under Judicial Oversight","summary":"A Kenyan court allowed the Sh5tn National Infrastructure Fund to proceed under judicial oversight. The court directed the National Treasury to disclose the dates money is deposited into accounts at the Central Bank of Kenya.","why":"National infrastructure funds finance large public works and their legal status affects government spending and investor confidence in Kenya's public finances.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"Nairobi","country":"Kenya","lat":-1.29,"lon":36.82,"region":"af"},"entities":[],"links":[],"source":{"name":"Capital FM","url":"https://capitalfm.africa/court-lets-sh5tn-national-infrastructure-fund-proceed-under-judicial-oversight/"},"sources":[{"name":"Capital FM","url":"https://capitalfm.africa/court-lets-sh5tn-national-infrastructure-fund-proceed-under-judicial-oversight/"}],"published_at":"2026-07-23T11:28:56Z","retrieved_at":"2026-11-17T12:21:21Z","official":false,"ai_summary":true,"content_hash":"c0f3201f4dca8584","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T12:21:21Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-07-23T11:28:56Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-07-23T12:00:00Z","publisher_country_gdelt":"KE","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/parliament-government-building-7830294.jpg","alt":"parliament government building (illustration)","credit":"ykaiavu","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/federal-palace-parliament-building-7830294/"}}