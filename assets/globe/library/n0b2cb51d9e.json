{"id":"n0b2cb51d9e","headline":"KRA seizes 53,000 under-declared smartphones at Eldoret Airport","summary":"The Kenya Revenue Authority seized 53,000 under-declared smartphones at Eldoret Airport. The high-end devices included Samsung Galaxy S26 Ultra, Galaxy Z Fold and Apple iPhone 17 Pro Max models.","why":"Customs enforcement on under-declared imports protects tax revenue and affects legitimate phone importers and retailers. Smuggling reduces duties collected by the state.","category":"economy","event_type":"trade","importance":1,"flag":null,"market_moving":false,"location":{"place":"Eldoret","country":"Kenya","lat":0.51,"lon":35.27,"region":"af"},"entities":[],"links":[],"source":{"name":"The Standard","url":"https://www.standardmedia.co.ke/business/article/2001558504/kra-seizes-53-000-under-declared-smartphones-at-eldoret-airport"},"sources":[{"name":"The Standard","url":"https://www.standardmedia.co.ke/business/article/2001558504/kra-seizes-53-000-under-declared-smartphones-at-eldoret-airport"}],"published_at":"2026-09-23T16:38:06Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"c19ab98385c9d772","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-09-23T16:38:06Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-09-23T18:00:00Z","publisher_country_gdelt":"KE","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/smartphone-1841553.jpg","alt":"smartphone (illustration)","credit":"Pexels","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/apple-iphone-notebook-pen-1841553/"}}