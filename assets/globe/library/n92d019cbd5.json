{"id":"n92d019cbd5","headline":"E85 fuel to get Rs 20/litre cheaper as India ramps up ethanol push","summary":"State-run oil marketing companies will offer E85 fuel at Rs 20 per litre less than E20 petrol across India. The discount compensates for the biofuel's lower energy content, minister Hardeep Singh Puri said.","why":"India is expanding ethanol blending to reduce fuel imports and support domestic agriculture. State-run oil marketers distribute most of the country's retail fuel.","category":"commodities","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.614,"lon":77.209,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Times of India","url":"https://timesofindia.indiatimes.com/business/india-business/e85-fuel-to-get-rs-20/litre-cheaper-as-india-ramps-up-ethanol-push/articleshow/131544721.cms"},"sources":[{"name":"The Times of India","url":"https://timesofindia.indiatimes.com/business/india-business/e85-fuel-to-get-rs-20/litre-cheaper-as-india-ramps-up-ethanol-push/articleshow/131544721.cms"}],"published_at":"2026-06-06T04:49:00Z","retrieved_at":"2026-11-17T15:20:22Z","official":false,"ai_summary":true,"content_hash":"48f3ae48393a1c48","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:20:22Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-06T04:49:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-06T06:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/oil-refinery-7010971.jpg","alt":"oil refinery (illustration)","credit":"yamabon","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/plant-chimney-night-view-7010971/"}}