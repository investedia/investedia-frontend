{"id":"nb8ea7a24ad","headline":"Katseli Law Reform: 100,000+ Borrowers Get Relief","summary":"Greece has resolved 16 years of uncertainty over the Katseli Law, delivering retroactive debt relief to more than 100,000 borrowers. The relief comes with €700 million in shared costs.","why":"The Katseli Law governs debt settlement for Greek borrowers, and its resolution affects household credit quality and the country's banking system.","category":"economy","event_type":"other","importance":2,"flag":null,"market_moving":false,"location":{"place":"Athens","country":"Greece","lat":37.98,"lon":23.73,"region":"eu"},"entities":[],"links":[],"source":{"name":"Athens Times","url":"https://athens-times.com/kyriakos-pierrakakis-closing-the-katseli-law-gap-ending-years-of-injustice/"},"sources":[{"name":"Athens Times","url":"https://athens-times.com/kyriakos-pierrakakis-closing-the-katseli-law-gap-ending-years-of-injustice/"}],"published_at":"2026-06-24T11:31:48Z","retrieved_at":"2026-11-17T13:38:59Z","official":false,"ai_summary":true,"content_hash":"4e2cc14839f91f33","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:38:59Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-24T11:31:48Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-24T12:00:00Z","publisher_country_gdelt":"GR","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-1013789.jpg","alt":"banknotes money (illustration)","credit":"stevepb","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/wallet-cash-pocket-credit-card-1013789/"}}