{"id":"nf68c66d6ae","headline":"Depositors await clarity on leverage","summary":"The Reserve Bank of India's overhaul of FCNR(B) deposit rules has drawn strong interest from non-resident investors. Banks and high-net-worth individuals are waiting for clarity on leveraged structures.","why":"FCNR(B) deposits are foreign-currency accounts held by Indian banks for non-resident Indians, and rule changes affect bank funding and rupee-linked flows.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.08,"lon":72.88,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Times of India","url":"https://timesofindia.indiatimes.com/business/india-business/depositors-await-clarity-on-leverage/articleshow/131899210.cms"},"sources":[{"name":"The Times of India","url":"https://timesofindia.indiatimes.com/business/india-business/depositors-await-clarity-on-leverage/articleshow/131899210.cms"}],"published_at":"2026-06-21T22:48:00Z","retrieved_at":"2026-11-17T13:38:59Z","official":false,"ai_summary":true,"content_hash":"842af65f15ca5643","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T13:38:59Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-21T22:48:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-22T00:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/bank-building-4660039.jpg","alt":"bank building (illustration)","credit":"DenisStreltsov","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/mumbai-india-the-central-bank-4660039/"}}