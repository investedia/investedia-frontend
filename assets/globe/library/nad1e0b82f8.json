{"id":"nad1e0b82f8","headline":"Average Aussie home value passes $1.1 million","summary":"The Australian Bureau of Statistics reported the value of the nation's dwelling stock hit a record A$12.3 trillion in the March quarter of 2026, up 11.9% year on year. The average home value passed A$1.1 million.","why":"Housing wealth drives household balance sheets, mortgage lending and the broader economy, and it is closely watched by the RBA.","category":"economy","event_type":"macro-data","importance":2,"flag":null,"market_moving":false,"location":{"place":"Sydney","country":"Australia","lat":-33.869,"lon":151.209,"region":"oc"},"entities":[],"links":[],"source":{"name":"MacroBusiness","url":"https://www.macrobusiness.com.au/2026/06/average-aussie-home-value-passes-1-1-million/"},"sources":[{"name":"MacroBusiness","url":"https://www.macrobusiness.com.au/2026/06/average-aussie-home-value-passes-1-1-million/"}],"published_at":"2026-06-11T03:00:23Z","retrieved_at":"2026-11-17T15:20:22Z","official":false,"ai_summary":true,"content_hash":"7dc8e92db43d8a9b","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T15:20:22Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-06-11T03:00:23Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-06-11T06:00:00Z","publisher_country_gdelt":"AS","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/housing-construction-4751385.jpg","alt":"housing construction (illustration)","credit":"analogicus","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/skyscraper-building-crane-4751385/"}}