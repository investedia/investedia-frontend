{"id":"nab8af0235b","headline":"Nigeria: Manufacturing Remains Largest Contributor to Nigeria","summary":"A Nigerian Economic Summit Group report says manufacturing's share of industrial output rose to 50.1% in the first quarter of 2026 from 28.2% in 2010, making it the largest contributor.","why":"Manufacturing's share of output indicates the structure of Nigeria's economy and the health of its industrial base, which matters for investors in Nigerian industry and currency.","category":"economy","event_type":"macro-data","importance":1,"flag":null,"market_moving":false,"location":{"place":"Lagos","country":"Nigeria","lat":6.52,"lon":3.38,"region":"af"},"entities":[],"links":[],"source":{"name":"allAfrica.com","url":"https://allafrica.com/stories/202608210030.html"},"sources":[{"name":"allAfrica.com","url":"https://allafrica.com/stories/202608210030.html"}],"published_at":"2026-08-21T05:20:19Z","retrieved_at":"2026-11-12T06:29:12Z","official":false,"ai_summary":true,"content_hash":"8501c327d4e1b2a3","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T06:29:12Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-21T05:20:19Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-21T06:00:00Z","publisher_country_gdelt":"CH","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/factory-workers-60585.jpg","alt":"factory workers (illustration)","credit":"WikiImages","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/construction-worker-construction-work-60585/"}}