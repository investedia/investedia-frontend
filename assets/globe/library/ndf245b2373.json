{"id":"ndf245b2373","headline":"DGTR recommends anti-dumping duty on rubber glove imports from Thailand, Malaysia","summary":"India's trade remedy body DGTR recommended a proposed five-year anti-dumping duty on rubber glove imports from Thailand and Malaysia. The final decision rests with the Finance Ministry.","why":"Anti-dumping duties protect domestic manufacturers from low-priced imports and affect trade flows between India and its Asian suppliers.","category":"economy","event_type":"trade","importance":1,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"BusinessLine","url":"https://www.thehindubusinessline.com/economy/dgtr-recommends-anti-dumping-duty-on-rubber-glove-imports-from-thailand-malaysia/article71681950.ece"},"sources":[{"name":"BusinessLine","url":"https://www.thehindubusinessline.com/economy/dgtr-recommends-anti-dumping-duty-on-rubber-glove-imports-from-thailand-malaysia/article71681950.ece"}],"published_at":"2026-11-09T10:12:35Z","retrieved_at":"2026-11-17T12:03:58Z","official":false,"ai_summary":true,"content_hash":"7ba2920aa8f465ef","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-17T12:03:58Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-11-09T10:12:35Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-11-09T12:00:00Z","publisher_country_gdelt":"CH","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/cargo-trucks-highway-3369756.jpg","alt":"cargo trucks highway (illustration)","credit":"rauschenberger","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/transport-truck-automobile-vehicle-3369756/"}}