{"id":"ncb9b4df7aa","headline":"NCAER: Bihar booze ban hasn't worked; lift it, fund development work","summary":"A new NCAER paper proposes lifting prohibition in Bihar to generate resources for development and capital expenditure. It argues the ban has not reduced crime against women and has shifted drinking to illegal alcohol and drugs.","why":"Alcohol excise is a significant source of state revenue in India, so prohibition policy affects state finances and budget capacity.","category":"economy","event_type":"regulation","importance":1,"flag":null,"market_moving":false,"location":{"place":"New Delhi","country":"India","lat":28.61,"lon":77.21,"region":"asia"},"entities":[],"links":[],"source":{"name":"The Times of India","url":"https://timesofindia.indiatimes.com/india/ncaer-bihar-booze-ban-hasnt-worked-lift-it-fund-development-work/articleshow/133044141.cms"},"sources":[{"name":"The Times of India","url":"https://timesofindia.indiatimes.com/india/ncaer-bihar-booze-ban-hasnt-worked-lift-it-fund-development-work/articleshow/133044141.cms"}],"published_at":"2026-08-07T22:42:00Z","retrieved_at":"2026-11-11T22:35:51Z","official":false,"ai_summary":true,"content_hash":"f8d5bb0037179049","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-11T22:35:51Z","backfill_provenance":{"version":"gdelt-backfill-v1","original_published_at":"2026-08-07T22:42:00Z","feed_url":"https://data.gdeltproject.org/gdeltv2/","discovered_via":"GDELT GKG 2.1","gdelt_seen":"2026-08-08T00:00:00Z","publisher_country_gdelt":"IN","description_from":"publisher page metadata"},"image":{"kind":"topic","file":"photos/banknotes-money-256281.jpg","alt":"banknotes money (illustration)","credit":"jarmoluk","license":"Pixabay Content License","license_url":"https://pixabay.com/service/license-summary/","source":"Pixabay","source_url":"https://pixabay.com/photos/money-card-pocket-concept-idea-256281/"}}