{"id":"nd850329293","headline":"RBI opens special dollar window for three state-run oil firms","summary":"The Reserve Bank of India opened a special facility for Indian Oil, Hindustan Petroleum and Bharat Petroleum to meet their full daily dollar requirements. The arrangement continues until further notice, based on market conditions.","why":"State-run oil marketers import large volumes of crude and need dollars to pay for it, so central bank dollar support affects their funding and the rupee.","category":"economy","event_type":"regulation","importance":2,"flag":null,"market_moving":false,"location":{"place":"Mumbai","country":"India","lat":19.076,"lon":72.878,"region":"asia"},"entities":[{"name":"Indian Oil Corporation","ticker":"IOC.NS","kind":"company","asset":{"id":"EQ:XNSE:IOC","n":"Indian Oil","c":"equity","px":"IOC.NS","la":19.06,"lo":72.86,"geo":"listing-venue","co":"CO:EQ:XNSE:IOC","m":"ticker+name","rv":"registry-v1"}},{"name":"Hindustan Petroleum Corporation","ticker":"HINDPETRO.NS","kind":"company","unresolved":"unknown-ticker:HINDPETRO.NS"},{"name":"Bharat Petroleum Corporation","ticker":"BPCL.NS","kind":"company","asset":{"id":"EQ:XNSE:BPCL","n":"Bharat Petroleum","c":"equity","px":"BPCL.NS","la":19.06,"lo":72.86,"geo":"listing-venue","co":"CO:EQ:XNSE:BPCL","m":"ticker+name","rv":"registry-v1"}}],"links":[],"source":{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/industry/energy/oil-gas/rbi-opens-special-dollar-window-for-three-state-run-oil-firms/articleshow/134846199.cms"},"sources":[{"name":"The Economic Times","url":"https://economictimes.indiatimes.com/industry/energy/oil-gas/rbi-opens-special-dollar-window-for-three-state-run-oil-firms/articleshow/134846199.cms"}],"published_at":"2026-10-10T02:09:00Z","retrieved_at":"2026-11-12T08:33:11Z","official":false,"ai_summary":true,"content_hash":"48343ea6c3e235bf","impacts":[],"why_moved":null,"backfilled":true,"backfilled_at":"2026-11-12T08:33:11Z","backfill_provenance":{"versio